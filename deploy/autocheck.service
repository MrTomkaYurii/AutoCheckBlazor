# AutoCheck — native (no Docker) systemd service.
# Installed to /etc/systemd/system/autocheck.service by the deploy workflow.
# The app is a self-contained .NET publish; /opt/autocheck/current is a symlink
# to the active release under /opt/autocheck/releases/<timestamp>.
# All mutable state lives in /opt/autocheck/data (see app.env), never in a release.

[Unit]
Description=AutoCheck Blazor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autocheck
Group=autocheck
WorkingDirectory=/opt/autocheck/current
ExecStart=/opt/autocheck/current/AutoCheck
EnvironmentFile=/opt/autocheck/app.env
Environment=HOME=/opt/autocheck/data
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Restart=always
RestartSec=5

# Hardening — /opt stays writable (lab-instruction edits, release swap), the rest is protected.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

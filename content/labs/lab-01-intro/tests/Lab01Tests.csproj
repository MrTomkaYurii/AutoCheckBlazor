<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Student namespace expected by the lab instructions -->
    <RootNamespace>SandboxIntro</RootNamespace>
    <!-- Suppress "no entry point" warning — Program.cs is excluded -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit"                  Version="2.7.0"  />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <!-- Student source files are copied here by GradingService -->
  <!-- Program.cs is excluded — it has entry point, conflicts with test runner -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
  </ItemGroup>

</Project>

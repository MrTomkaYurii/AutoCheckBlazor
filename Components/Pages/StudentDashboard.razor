@page "/student"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "student")]
@inject NavigationManager Nav
@inject IDataService Data
@inject INotificationService NotifSvc
@inject AppState App

<TopBar Title="Дашборд" Sub="Огляд твого прогресу на курсі">
    @if (_unread > 0)
    {
        <button class="btn btn-outline btn-sm unread-btn" @onclick="ShowNotifications">
            <Icon Name="clock" Size="15" />
            <span class="unread-badge">@_unread</span>
        </button>
    }
    @if (CurrentLab is not null)
    {
        <button class="btn btn-outline btn-sm continue-btn" @onclick="@(() => Nav.NavigateTo($"/student/lab/{CurrentLab.Id}"))">
            <Icon Name="upload" Size="15" />Продовжити Lab@(CurrentLab.Id.ToString("D2"))
        </button>
    }
</TopBar>

<div class="screen-anim page">

    @* greeting hero *@
    <section class="glass hero">
        <div class="hero-glow"></div>
        <div class="hero-inner">
            <div class="hero-text-block">
                <div class="badge badge-green hero-badge"><span class="dot"></span>Семестр 2 · Тиждень 9</div>
                <h2 class="hero-title">Привіт, @Student.FirstName <span class="hero-emoji">👋</span></h2>
                <p class="hero-sub">Ти проходиш курс впевнено. Залишилось здати ще @(Total - Done) лабораторних до допуску до екзамену.</p>

                <div class="progress-block">
                    <div class="progress-head">
                        <span class="progress-head-label"><b class="progress-head-done">@Done</b> з @Total лаб зараховано</span>
                        <span class="mono progress-head-pct">@Pct%</span>
                    </div>
                    <Progress Value="Pct" />
                    <div class="ministat-row">
                        <MiniStat Tone="yellow" Label="на перевірці" Value="Review" />
                        <MiniStat Tone="red" Label="на доопрацюванні" Value="Rejected" />
                        <MiniStat Tone="grey" Label="попереду" Value="@(Total - Done - Review - Rejected)" />
                    </div>
                </div>
            </div>

            <div class="ring-block">
                <Ring Value="Avg" />
                <div class="ring-label">середній бал</div>
            </div>
        </div>
    </section>

    @* section title + filters *@
    <div class="section-head">
        <h3 class="section-title">Лабораторні роботи</h3>
        <span class="badge badge-grey"><span class="dot"></span>@Total всього</span>
        <div class="filter-row">
            @foreach (var (label, key) in new[] { ("Усі", "all"), ("Активні", "active"), ("Зараховані", "done") })
            {
                var on = _filter == key;
                <button class="fchip filter-chip" @onclick="@(() => _filter = key)"
                        style="border:1px solid @(on ? "var(--glass-border-hover)" : "var(--line)");background:@(on ? "var(--acc-dim)" : "transparent");color:@(on ? "var(--acc-bright)" : "var(--tx-3)")">@label</button>
            }
        </div>
    </div>

    @* lab cards grid *@
    <div class="cards-grid">
        @{ var visible = FilteredLabs; }
        @for (int i = 0; i < visible.Count; i++)
        {
            <LabCard Lab="visible[i]" Index="i" />
        }
    </div>
</div>

@* ── Notifications overlay ─────────────────────────────────────────────────── *@
@if (_showNotif)
{
    <div @onclick="@(() => _showNotif = false)" class="notif-overlay">
        <div @onclick:stopPropagation class="glass notif-panel">
            <div class="notif-head">
                <Icon Name="clock" Size="16" Style="color:var(--st-yellow)" />
                <span class="notif-title">Сповіщення</span>
                <button @onclick="@(() => _showNotif = false)" class="notif-close-btn"><Icon Name="x" Size="14" /></button>
            </div>
            @if (_notifications.Count == 0)
            {
                <div class="notif-empty">Нових сповіщень немає</div>
            }
            @foreach (var n in _notifications)
            {
                var tone = n.Type == "grade" ? "var(--st-green)" : n.Type == "grading" ? "var(--acc)" : "var(--tx-2)";
                <div class="notif-row">
                    <div class="notif-row-head">
                        <span class="notif-dot" style="background:@tone"></span>
                        <span class="notif-row-title">@n.Title</span>
                    </div>
                    <p class="notif-body">@n.Body</p>
                    <span class="notif-time">@n.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</span>
                </div>
            }
        </div>
    </div>
}

@code {
    private Student Student = new();
    private List<Lab> Labs = [];
    private List<Notification> _notifications = [];
    private int _unread;
    private bool _showNotif;
    private string _filter = "all";

    protected override async Task OnInitializedAsync()
    {
        var sid = App.StudentDbId ?? 1;
        // AppState holds the LOGGED-IN student; GetCurrentStudentAsync() would
        // always return the first student in the table (Петро for everyone)
        Student = App.Student;
        Labs    = await Data.GetStudentLabsAsync(sid);
        _unread = await NotifSvc.GetUnreadCountAsync(sid);
    }

    private async Task ShowNotifications()
    {
        var sid = App.StudentDbId ?? 1;
        _notifications = await NotifSvc.GetUnreadAsync(sid);
        _showNotif = true;
        await NotifSvc.MarkAllReadAsync(sid);
        _unread = 0;
    }

    private List<Lab> FilteredLabs => _filter switch
    {
        "active" => Labs.Where(l => l.Status is LabStatus.Review or LabStatus.Rejected).ToList(),
        "done"   => Labs.Where(l => l.Status == LabStatus.Done).ToList(),
        _        => Labs,
    };

    private int Total    => Labs.Count;
    private int Done     => Labs.Count(l => l.Status == LabStatus.Done);
    private int Review   => Labs.Count(l => l.Status == LabStatus.Review);
    private int Rejected => Labs.Count(l => l.Status == LabStatus.Rejected);
    private int Pct      => Total > 0 ? (int)Math.Round(100.0 * Done / Total) : 0;
    private int Avg      => Labs.Any(l => l.Final.HasValue)
        ? (int)Math.Round(Labs.Where(l => l.Final.HasValue).Average(l => l.Final!.Value))
        : 0;
    private Lab? CurrentLab => Labs.FirstOrDefault(l => l.Current)
        ?? Labs.FirstOrDefault(l => l.Status == LabStatus.Review);
}

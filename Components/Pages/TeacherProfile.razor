@page "/teacher/profile"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "teacher")]
@inject AppState App
@inject IAuthService Auth
@inject AppDbContext Db
@inject IConfiguration Cfg
@inject IWebHostEnvironment Env
@inject GeminiQuotaService Quota
@inject UserManager<AppUser> UserManager
@inject NavigationManager Nav

<TopBar Title="Кабінет" Sub="Профіль викладача та параметри практикуму" />

<div class="screen-anim page">
<div class="grid-2">

    @* ── Профіль викладача ─────────────────────────────────────────────────── *@
    <section class="glass card">
        <div class="card-hero">
            <div class="avatar-lg">@App.Teacher.Initials</div>
            <div class="hero-info">
                <h2 class="hero-name">@App.Teacher.FirstName @App.Teacher.LastName</h2>
                <div class="hero-badges">
                    <span class="badge badge-green"><span class="dot"></span>Викладач</span>
                    @if (!string.IsNullOrEmpty(App.Teacher.Title))
                    {
                        <span class="badge badge-grey"><span class="dot"></span>@App.Teacher.Title</span>
                    }
                </div>
            </div>
            <button class="btn btn-ghost btn-sm" @onclick="ToggleProfile">
                <Icon Name="@(_profileEdit ? "x" : "settings")" Size="14" />
                @(_profileEdit ? "Скасувати" : "Редагувати")
            </button>
        </div>

        @if (!_profileEdit && !_pwEdit)
        {
            <div class="info-list">
                @foreach (var (lbl, val) in new[] {
                    ("Ім'я",              App.Teacher.FirstName),
                    ("Прізвище",          App.Teacher.LastName),
                    ("Email",             _emailDisplay),
                    ("Посада",            App.Teacher.Title),
                    ("Курс / практикум",  App.Teacher.Course),
                })
                {
                    <div class="info-row">
                        <span class="info-label">@lbl</span>
                        <span class="info-value" style="color:@(string.IsNullOrEmpty(val) ? "var(--tx-faint)" : "var(--tx-1)")">@(string.IsNullOrEmpty(val) ? "—" : val)</span>
                    </div>
                }
                @* Password row *@
                <div class="info-row-last">
                    <span class="info-label">Пароль</span>
                    <span class="pw-dots">••••••••••</span>
                    <button class="btn btn-ghost btn-sm" @onclick="@(() => { _pwEdit = true; _profileEdit = false; })">
                        <Icon Name="settings" Size="13" />Змінити
                    </button>
                </div>
            </div>
        }
        else if (_profileEdit)
        {
            <div class="edit-body">
                <div class="edit-grid-2">
                    <div class="field"><label>Ім'я</label><input class="input" @bind="_firstName" /></div>
                    <div class="field"><label>Прізвище</label><input class="input" @bind="_lastName" /></div>
                </div>
                <div class="field">
                    <label>Email</label>
                    <input class="input" type="email" @bind="_email" placeholder="teacher@example.com" />
                </div>
                <div class="field"><label>Посада</label><input class="input" @bind="_posada" placeholder="Асистент, Доцент, к.т.н.…" /></div>
                <div class="field"><label>Назва курсу / практикуму</label><input class="input" @bind="_course" placeholder="ООП та патерни C#" /></div>
                @Feedback(_profileMsg)
                <div class="edit-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SaveProfile" disabled="@_savingProfile">
                        <Icon Name="check" Size="15" />@(_savingProfile ? "Збереження…" : "Зберегти")
                    </button>
                </div>
            </div>
        }
        else if (_pwEdit)
        {
            <div class="edit-body">
                <div class="field">
                    <label>Поточний пароль</label>
                    <input class="input" type="password" @bind="_pwOld" autocomplete="current-password" />
                </div>
                <div class="field">
                    <label>Новий пароль</label>
                    <input class="input" type="password" @bind="_pwNew" autocomplete="new-password" />
                </div>
                <div class="field">
                    <label>Підтвердження</label>
                    <input class="input" type="password" @bind="_pwConfirm" autocomplete="new-password" />
                </div>
                @Feedback(_pwMsg)
                <div class="edit-actions-gap">
                    <button class="btn btn-ghost btn-sm" @onclick="@(() => { _pwEdit = false; _pwOld = _pwNew = _pwConfirm = _pwMsg = ""; })">
                        Скасувати
                    </button>
                    <button class="btn btn-primary btn-sm" @onclick="ChangePassword" disabled="@_savingPw">
                        <Icon Name="check" Size="15" />@(_savingPw ? "Збереження…" : "Змінити пароль")
                    </button>
                </div>
            </div>
        }
    </section>

    @* ── Налаштування системи ─────────────────────────────────────────────── *@
    <section class="glass card">
        <div class="section-head">
            <Icon Name="settings" Size="18" Style="color:var(--acc)" />
            <h3 class="section-title">Налаштування системи</h3>
            <button class="btn btn-ghost btn-sm push-right" @onclick="ToggleSettings">
                <Icon Name="@(_settingsEdit ? "x" : "settings")" Size="14" />
                @(_settingsEdit ? "Скасувати" : "Редагувати")
            </button>
        </div>

        @if (!_settingsEdit)
        {
            @* Gemini subsection *@
            <div class="subsection">
                <div class="subsection-label">Gemini AI</div>
                @foreach (var (lbl, val, mono, secret) in new[] {
                    ("API ключ",    Cfg["Gemini:ApiKey"]    ?? "",                               true,  true),
                    ("Модель",      Cfg["Gemini:Model"]     ?? "gemini-2.5-flash",               true,  false),
                    ("Денний ліміт", Cfg["Gemini:DailyLimit"] ?? "50",                           false, false),
                })
                {
                    <div class="settings-row">
                        <span class="settings-label">@lbl</span>
                        <span class="@(mono ? "mono" : "") settings-value" style="color:@(string.IsNullOrEmpty(val) ? "var(--tx-faint)" : "var(--tx-1)")">
                            @if (secret && !string.IsNullOrEmpty(val))
                            {
                                @($"{val[..Math.Min(6, val.Length)]}••••••••")
                            }
                            else if (string.IsNullOrEmpty(val)) { <span>—</span> }
                            else { @val }
                        </span>
                    </div>
                }
                @* Quota status *@
                <div class="settings-row">
                    <span class="settings-label">Сьогодні</span>
                    <div class="quota-wrap">
                        <div class="quota-track">
                            <div class="quota-fill" style="width:@(Quota.DailyLimit > 0 ? (int)((double)Quota.TodayCount / Quota.DailyLimit * 100) : 0)%;background:@(Quota.IsExhausted ? "var(--st-red)" : "var(--acc)")"></div>
                        </div>
                        <span class="mono quota-num" style="color:@(Quota.IsExhausted ? "var(--st-red)" : "var(--tx-2)")">@Quota.TodayCount / @Quota.DailyLimit</span>
                    </div>
                </div>
            </div>
            @* Grading subsection *@
            <div class="subsection-last">
                <div class="subsection-label">Перевірка</div>
                <div class="settings-row">
                    <span class="settings-label">WorkRoot</span>
                    <span class="mono" style="font-size:12px;color:@(string.IsNullOrEmpty(Cfg["Grading:WorkRoot"]) ? "var(--tx-faint)" : "var(--tx-1)")">
                        @(string.IsNullOrEmpty(Cfg["Grading:WorkRoot"]) ? "тимчасова папка" : Cfg["Grading:WorkRoot"])
                    </span>
                </div>
                @* Backup row *@
                <div class="settings-row-gap">
                    <span class="settings-label">Бекап БД</span>
                    <span class="backup-hint">автоматично щодня · вручну:</span>
                    <button class="btn btn-ghost btn-sm" @onclick="BackupNow" disabled="@_backingUp">
                        <Icon Name="upload" Size="13" />@(_backingUp ? "Створення…" : "Створити зараз")
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(_backupMsg))
                {
                    @Feedback(_backupMsg)
                }
            </div>
        }
        else
        {
            <div class="edit-body">
                <div class="subsection-label">Gemini AI</div>
                <div class="field">
                    <label>API ключ</label>
                    <input class="input mono" type="password" @bind="_geminiKey" placeholder="AIza…" autocomplete="off" />
                </div>
                <div class="edit-grid-2">
                    <div class="field">
                        <label>Модель</label>
                        <input class="input mono" @bind="_geminiModel" placeholder="gemini-2.5-flash" />
                    </div>
                    <div class="field">
                        <label>Денний ліміт запитів</label>
                        <input class="input" type="number" min="1" max="1000" @bind="_geminiLimit" />
                    </div>
                </div>
                <div class="subsection-label" style="margin-top:4px">Перевірка</div>
                <div class="field">
                    <label>WorkRoot <span class="hint">(порожньо = тимчасова папка ОС)</span></label>
                    <input class="input mono" @bind="_workRoot" placeholder="C:\autocheck-repos або /tmp/repos" />
                </div>
                @Feedback(_settingsMsg)
                <div class="edit-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SaveSettings" disabled="@_savingSettings">
                        <Icon Name="check" Size="15" />@(_savingSettings ? "Збереження…" : "Зберегти")
                    </button>
                </div>
            </div>
        }
    </section>

    @* ── Ліміти авто-перевірок ────────────────────────────────────────────── *@
    <section class="glass card-mt">
        <div class="section-head">
            <Icon Name="refresh" Size="18" Style="color:var(--acc)" />
            <h3 class="section-title">Ліміти авто-перевірок</h3>
            <span class="section-title-hint">— кількість спроб здачі на auto-grading для кожної лаби</span>
            @if (_attemptsChanged)
            {
                <button class="btn btn-primary btn-sm push-right" @onclick="SaveAttempts" disabled="@_savingAttempts">
                    <Icon Name="check" Size="14" />@(_savingAttempts ? "Збереження…" : "Зберегти зміни")
                </button>
            }
        </div>

        <div class="attempts-grid">
            @foreach (var row in _labAttempts)
            {
                <div class="attempt-row">
                    <span class="mono attempt-num">@row.Number.ToString("D2")</span>
                    <span class="attempt-title" title="@row.Title">@row.Title</span>
                    <div class="attempt-controls">
                        <button @onclick="@(() => ChangeAttempts(row, -1))" class="attempt-btn"
                                disabled="@(row.Value <= 1)">−</button>
                        <span class="mono attempt-value" style="color:@(row.Changed ? "var(--acc-bright)" : "var(--tx-1)")">@row.Value</span>
                        <button @onclick="@(() => ChangeAttempts(row, +1))" class="attempt-btn"
                                disabled="@(row.Value >= 10)">+</button>
                    </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(_attemptsMsg))
        {
            <div class="feedback-wrap">
                @Feedback(_attemptsMsg)
            </div>
        }
    </section>

    @* ── Викладачі курсу ───────────────────────────────────────────────────── *@
    <section class="glass card-mt">
        <div class="section-head">
            <Icon Name="users" Size="18" Style="color:var(--acc)" />
            <h3 class="section-title">Викладачі курсу</h3>
            <button class="btn btn-ghost btn-sm push-right" @onclick="@(() => { _teacherAddOpen = !_teacherAddOpen; _teacherMsg = ""; })">
                <Icon Name="@(_teacherAddOpen ? "x" : "profile")" Size="14" />
                @(_teacherAddOpen ? "Скасувати" : "Додати викладача")
            </button>
        </div>

        <div class="teacher-list">
            @foreach (var t in _teachers)
            {
                <div class="teacher-row">
                    <div class="teacher-avatar">@t.Initials</div>
                    <div class="teacher-info">
                        <div class="teacher-name">@t.FirstName @t.LastName</div>
                        <div class="mono teacher-email">@(string.IsNullOrEmpty(t.Email) ? "—" : t.Email)</div>
                    </div>
                    @if (t.UserLink != null)
                    {
                        <span class="badge badge-green teacher-badge"><span class="dot"></span>активний</span>
                    }
                    else
                    {
                        <span class="badge badge-grey teacher-badge"><span class="dot"></span>без акаунта</span>
                    }
                </div>
            }
        </div>

        @if (_teacherAddOpen)
        {
            <div class="teacher-add-body">
                <div class="edit-grid-2">
                    <div class="field"><label>Ім'я</label><input class="input" @bind="_tFirst" placeholder="Іван" /></div>
                    <div class="field"><label>Прізвище</label><input class="input" @bind="_tLast" placeholder="Петренко" /></div>
                </div>
                <div class="field">
                    <label>Email <span class="hint">(логін для входу)</span></label>
                    <input class="input" type="email" @bind="_tEmail" placeholder="teacher2@example.com" />
                </div>
                @if (!string.IsNullOrEmpty(_teacherTempPw))
                {
                    <div class="temp-pw-box">
                        <div class="temp-pw-hint">Акаунт створено. Тимчасовий пароль (передайте колезі):</div>
                        <code class="mono temp-pw-value">@_teacherTempPw</code>
                    </div>
                }
                @Feedback(_teacherMsg)
                <div class="edit-actions">
                    <button class="btn btn-primary btn-sm" @onclick="AddTeacher" disabled="@_savingTeacher">
                        <Icon Name="check" Size="15" />@(_savingTeacher ? "Створення…" : "Створити акаунт")
                    </button>
                </div>
            </div>
        }
    </section>

</div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    // ── Profile ──────────────────────────────────────────────────────────────
    private bool   _profileEdit, _savingProfile;
    private string _firstName = "", _lastName = "", _email = "", _posada = "", _course = "", _profileMsg = "";
    private string _emailDisplay = "";   // loaded from DB on init

    // ── Password ──────────────────────────────────────────────────────────────
    private bool   _pwEdit, _savingPw;
    private string _pwOld = "", _pwNew = "", _pwConfirm = "", _pwMsg = "";

    // ── Settings ─────────────────────────────────────────────────────────────
    private bool   _settingsEdit, _savingSettings;
    private string _geminiKey = "", _geminiModel = "", _workRoot = "", _settingsMsg = "";
    private int    _geminiLimit;

    // ── Lab attempts ──────────────────────────────────────────────────────────
    private sealed class LabAttemptsRow
    {
        public int LabId;
        public int Number;
        public string Title = "";
        public int Original;
        public int Value;
        public bool Changed => Value != Original;
    }
    private List<LabAttemptsRow> _labAttempts = [];
    private bool   _attemptsChanged => _labAttempts.Any(r => r.Changed);
    private bool   _savingAttempts;
    private string _attemptsMsg = "";

    // ── Manual DB backup ──────────────────────────────────────────────────────
    private bool _backingUp;
    private string _backupMsg = "";

    private async Task BackupNow()
    {
        _backingUp = true; StateHasChanged();
        try
        {
            var path = await BackupHelper.BackupNowAsync(Db, Env, Cfg);
            _backupMsg = $"ok:Бекап створено: {Path.GetFileName(path)}";
        }
        catch (Exception ex)
        {
            _backupMsg = $"err:{ex.Message}";
        }
        _backingUp = false; StateHasChanged();
        await Task.Delay(3000); _backupMsg = ""; StateHasChanged();
    }

    // ── Teachers management ───────────────────────────────────────────────────
    private List<TeacherRecord> _teachers = [];
    private bool _teacherAddOpen, _savingTeacher;
    private string _tFirst = "", _tLast = "", _tEmail = "", _teacherMsg = "", _teacherTempPw = "";

    private async Task LoadTeachersAsync() =>
        _teachers = await Db.Teachers.AsNoTracking().Include(t => t.UserLink)
                                     .OrderBy(t => t.Id).ToListAsync();

    private async Task AddTeacher()
    {
        _teacherMsg = ""; _teacherTempPw = "";
        var email = _tEmail.Trim();
        if (string.IsNullOrWhiteSpace(_tFirst) || string.IsNullOrWhiteSpace(_tLast))
        { _teacherMsg = "err:Вкажіть ім'я та прізвище."; return; }
        if (!email.Contains('@'))
        { _teacherMsg = "err:Вкажіть коректний email."; return; }
        if (await UserManager.FindByEmailAsync(email) != null)
        { _teacherMsg = "err:Користувач з таким email вже існує."; return; }

        _savingTeacher = true; StateHasChanged();
        try
        {
            var temp = "tc-" + Guid.NewGuid().ToString("N")[..8];
            var user = new AppUser
            {
                UserName = email, Email = email, EmailConfirmed = true,
                FirstName = _tFirst.Trim(), LastName = _tLast.Trim(),
            };
            var created = await UserManager.CreateAsync(user, temp);
            if (!created.Succeeded)
            {
                _teacherMsg = "err:" + string.Join(" ", created.Errors.Select(e => e.Description));
            }
            else
            {
                await UserManager.AddToRoleAsync(user, "teacher");
                await Auth.LinkTeacherAsync(user);
                _teacherTempPw = temp;
                _teacherMsg = "ok:Викладача додано";
                _tFirst = _tLast = _tEmail = "";
                await LoadTeachersAsync();
            }
        }
        catch (Exception ex)
        {
            _teacherMsg = $"err:{ex.Message}";
        }
        _savingTeacher = false; StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        _firstName = App.Teacher.FirstName;
        _lastName  = App.Teacher.LastName;
        _posada    = App.Teacher.Title;
        _course    = App.Teacher.Course;
        // load email from DB (TeacherRecord.Email)
        var state = await AuthStateTask;
        var sub   = Auth.GetSub(state.User);
        var link  = await Db.UserLinks.AsNoTracking().FirstOrDefaultAsync(l => l.UserId == sub);
        if (link?.TeacherId is int tid)
        {
            var rec = await Db.Teachers.AsNoTracking().FirstOrDefaultAsync(t => t.Id == tid);
            _emailDisplay = _email = rec?.Email ?? Auth.GetEmail(state.User);
        }
        else
        {
            _emailDisplay = _email = Auth.GetEmail(state.User);
        }
        LoadSettingsFields();
        await LoadLabAttemptsAsync();
        await LoadTeachersAsync();
    }

    private async Task LoadLabAttemptsAsync()
    {
        var labs = await Db.Labs.OrderBy(l => l.Number).Select(l => new { l.Id, l.Number, l.Title, l.AttemptsMax }).ToListAsync();
        _labAttempts = labs.Select(l => new LabAttemptsRow
        {
            LabId = l.Id, Number = l.Number, Title = l.Title,
            Original = l.AttemptsMax, Value = l.AttemptsMax,
        }).ToList();
    }

    private void LoadSettingsFields()
    {
        _geminiKey   = Cfg["Gemini:ApiKey"]  ?? "";
        _geminiModel = Cfg["Gemini:Model"]   ?? "gemini-2.5-flash";
        _geminiLimit = int.TryParse(Cfg["Gemini:DailyLimit"], out var v) ? v : 50;
        _workRoot    = Cfg["Grading:WorkRoot"] ?? "";
    }

    // ── Toggle helpers ────────────────────────────────────────────────────────
    private void ChangeAttempts(LabAttemptsRow row, int delta)
    {
        row.Value = Math.Clamp(row.Value + delta, 1, 10);
    }

    private async Task SaveAttempts()
    {
        _savingAttempts = true; StateHasChanged();
        try
        {
            foreach (var row in _labAttempts.Where(r => r.Changed))
            {
                await Db.Labs.Where(l => l.Id == row.LabId)
                    .ExecuteUpdateAsync(l => l.SetProperty(x => x.AttemptsMax, row.Value));
                await Db.Submissions
                    .Where(s => s.LabDefId == row.LabId)
                    .ExecuteUpdateAsync(s => s.SetProperty(x => x.AttemptsMax, row.Value));
                row.Original = row.Value;
            }
            _attemptsMsg = "ok:Ліміти оновлено";
        }
        catch (Exception ex)
        {
            _attemptsMsg = $"err:{ex.Message}";
        }
        _savingAttempts = false; StateHasChanged();
        await Task.Delay(2000); _attemptsMsg = ""; StateHasChanged();
    }

    private void ToggleProfile()
    {
        _profileEdit = !_profileEdit; _profileMsg = ""; _pwEdit = false;
        if (_profileEdit)
        {
            _firstName = App.Teacher.FirstName;
            _lastName  = App.Teacher.LastName;
            _email     = _emailDisplay;
            _posada    = App.Teacher.Title;
            _course    = App.Teacher.Course;
        }
    }

    private async Task ChangePassword()
    {
        if (string.IsNullOrWhiteSpace(_pwNew))    { _pwMsg = "err:Новий пароль не може бути порожнім."; return; }
        if (_pwNew != _pwConfirm)                  { _pwMsg = "err:Паролі не збігаються."; return; }
        if (_pwNew.Length < 6)                     { _pwMsg = "err:Пароль має бути не менше 6 символів."; return; }
        if (string.IsNullOrWhiteSpace(_pwOld))     { _pwMsg = "err:Введіть поточний пароль."; return; }

        _savingPw = true; StateHasChanged();
        try
        {
            var state = await AuthStateTask;
            var user  = await UserManager.FindByIdAsync(Auth.GetSub(state.User));
            if (user == null)
            {
                _pwMsg = "err:Акаунт не знайдено.";
            }
            else
            {
                var result = await UserManager.ChangePasswordAsync(user, _pwOld, _pwNew);
                if (result.Succeeded)
                {
                    _pwMsg = "ok:Пароль успішно змінено";
                    _pwOld = _pwNew = _pwConfirm = "";
                }
                else
                {
                    var wrongOld = result.Errors.Any(e => e.Code == "PasswordMismatch");
                    _pwMsg = "err:" + (wrongOld
                        ? "Поточний пароль невірний."
                        : string.Join(" ", result.Errors.Select(e => e.Description)));
                }
            }
        }
        catch (Exception ex)
        {
            _pwMsg = $"err:{ex.Message}";
        }
        _savingPw = false; StateHasChanged();
        if (_pwMsg.StartsWith("ok:"))
        {
            // Security stamp changed → re-issue the auth cookie so the session stays valid
            await Task.Delay(1200);
            Nav.NavigateTo("/account/refresh-signin?returnUrl=/teacher/profile", forceLoad: true);
        }
    }

    private void ToggleSettings()
    {
        _settingsEdit = !_settingsEdit; _settingsMsg = "";
        if (_settingsEdit) LoadSettingsFields();
    }

    // ── Save profile ─────────────────────────────────────────────────────────
    private async Task SaveProfile()
    {
        _savingProfile = true; StateHasChanged();
        var state = await AuthStateTask;
        var sub   = Auth.GetSub(state.User);
        var link  = await Db.UserLinks.AsNoTracking().FirstOrDefaultAsync(l => l.UserId == sub);
        if (link?.TeacherId is int teacherId)
        {
            // Email is the login — keep the Identity account and the link in sync
            var newEmail = _email.Trim();
            var user = await UserManager.FindByIdAsync(sub);
            if (user != null && !string.IsNullOrEmpty(newEmail)
                && !string.Equals(user.Email, newEmail, StringComparison.OrdinalIgnoreCase))
            {
                string? err = null;
                if (!newEmail.Contains('@'))
                    err = "err:Некоректний email";
                else if (await UserManager.FindByEmailAsync(newEmail) is { } taken && taken.Id != user.Id)
                    err = "err:Цей email вже використовується іншим акаунтом";

                if (err != null)
                {
                    _profileMsg = err; _savingProfile = false; StateHasChanged();
                    await Task.Delay(2500); _profileMsg = ""; StateHasChanged();
                    return;
                }

                user.Email = newEmail;
                user.UserName = newEmail;
                await UserManager.UpdateAsync(user);
                await Db.UserLinks.Where(l => l.UserId == sub)
                    .ExecuteUpdateAsync(l => l.SetProperty(x => x.Email, newEmail));
            }

            var initials = (_firstName.Length > 0 ? _firstName[0].ToString() : "")
                         + (_lastName.Length  > 0 ? _lastName[0].ToString()  : "");
            await Db.Teachers.Where(t => t.Id == teacherId).ExecuteUpdateAsync(t => t
                .SetProperty(x => x.FirstName, _firstName.Trim())
                .SetProperty(x => x.LastName,  _lastName.Trim())
                .SetProperty(x => x.Initials,  initials)
                .SetProperty(x => x.Email,     newEmail)
                .SetProperty(x => x.Title,     _posada.Trim())
                .SetProperty(x => x.Course,    _course.Trim()));
            _emailDisplay = newEmail;
            await App.PreloadAsync(state.User);
            _profileMsg = "ok:Профіль оновлено";
        }
        else
        {
            _profileMsg = "err:Профіль викладача не знайдено";
        }
        _savingProfile = false; _profileEdit = false; StateHasChanged();
        await Task.Delay(2000); _profileMsg = ""; StateHasChanged();
    }

    // ── Save settings (writes appsettings.json + reloads config) ─────────────
    private async Task SaveSettings()
    {
        _savingSettings = true; StateHasChanged();
        try
        {
            var path = Path.Combine(Env.ContentRootPath, "appsettings.json");
            var json = await File.ReadAllTextAsync(path);
            var node = System.Text.Json.Nodes.JsonNode.Parse(json)!;

            node["Gemini"]!["ApiKey"]     = _geminiKey.Trim();
            node["Gemini"]!["Model"]      = string.IsNullOrWhiteSpace(_geminiModel) ? "gemini-2.5-flash" : _geminiModel.Trim();
            node["Gemini"]!["DailyLimit"] = _geminiLimit > 0 ? _geminiLimit : 50;
            node["Grading"]!["WorkRoot"]  = _workRoot.Trim();

            var opts = new System.Text.Json.JsonSerializerOptions { WriteIndented = true };
            await File.WriteAllTextAsync(path, node.ToJsonString(opts));

            if (Cfg is IConfigurationRoot root) root.Reload();
            _settingsMsg = "ok:Налаштування збережено та застосовано";
        }
        catch (Exception ex)
        {
            _settingsMsg = $"err:{ex.Message}";
        }
        _savingSettings = false; _settingsEdit = false; StateHasChanged();
        await Task.Delay(2000); _settingsMsg = ""; StateHasChanged();
    }

    private static RenderFragment Feedback(string msg) => __builder =>
    {
        if (string.IsNullOrEmpty(msg)) return;
        var isErr = msg.StartsWith("err:");
        var text  = msg.StartsWith("ok:") || msg.StartsWith("err:") ? msg[3..] : msg;
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "style",
            $"padding:9px 13px;background:{(isErr ? "rgba(255,80,80,0.08)" : "rgba(118,199,173,0.1)")};border:1px solid {(isErr ? "rgba(255,80,80,0.25)" : "rgba(118,199,173,0.25)")};border-radius:9px;color:{(isErr ? "var(--st-red)" : "var(--st-green)")};font-size:13px");
        __builder.AddContent(2, text);
        __builder.CloseElement();
    };
}

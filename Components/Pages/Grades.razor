@page "/student/grades"
@inject IDataService Data

<TopBar Title="Журнал оцінок" Sub="Усі твої оцінки за семестр" />

<div class="screen-anim" style="padding:0 34px 40px;position:relative;z-index:1">

    @* summary stat strip *@
    <div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:14px;margin-bottom:20px">
        <StatCard Icon="target" Tone="var(--acc)" Value="@AvgStr" Label="Середній бал" Sub="по фінальних оцінках" />
        <StatCard Icon="check" Tone="var(--st-green)" Value="@($"{Done} / {Rows.Count}")" Label="Зараховано" Sub="@($"мінімум {Needed} для заліку")" />
        <StatCard Icon="spark" Tone="var(--st-yellow)" Value="@AvgAuto.ToString()" Label="Сер. авто-оцінка" Sub="точність коду" />
        <StatCard Icon="trophy" Tone="var(--st-blue)" Value="@Best.Final.ToString()" Label="Найкраща лаба" Sub="@($"Lab{Best.Id:D2} · {Best.Title}")" />
    </div>

    @* table *@
    <section class="glass" style="padding:0;overflow:hidden;margin-bottom:20px">
        <div style="display:flex;align-items:center;gap:12px;padding:18px 24px;border-bottom:1px solid var(--line)">
            <Icon Name="grades" Size="18" Style="color:var(--acc)" />
            <h3 style="margin:0;font-size:16px;font-weight:720;letter-spacing:-0.02em">Журнал оцінок</h3>
            <span class="badge badge-grey"><span class="dot"></span>Семестр 2</span>
            <span class="mono" style="margin-left:auto;font-size:12.5px;color:var(--tx-3)">оновлено щойно</span>
        </div>
        <div style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse;min-width:680px">
                <thead>
                    <tr style="font-size:11.5px;color:var(--tx-3);text-transform:uppercase;letter-spacing:0.05em">
                        <th style="padding:12px 14px;text-align:left;padding-left:24px;font-weight:600">Лабораторна</th>
                        <th style="padding:12px 14px;text-align:center;font-weight:600">Авто-оцінка</th>
                        <th style="padding:12px 14px;text-align:center;font-weight:600">Викладач</th>
                        <th style="padding:12px 14px;text-align:center;font-weight:600">Фінальна</th>
                        <th style="padding:12px 14px;text-align:right;padding-right:24px;font-weight:600">Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Rows)
                    {
                        var locked = r.Status == LabStatus.Locked;
                        <tr class="grow" style="border-top:1px solid var(--line);opacity:@(locked ? "0.5" : "1")">
                            <td style="padding:13px 14px;padding-left:24px;vertical-align:middle">
                                <div style="display:flex;align-items:center;gap:12px">
                                    <span class="mono" style="font-size:12px;font-weight:700;color:@(locked ? "var(--tx-faint)" : "var(--acc)");background:@(locked ? "var(--st-grey-bg)" : "var(--acc-dim)");padding:3px 8px;border-radius:7px;border:1px solid @(locked ? "transparent" : "var(--glass-border)")">@r.Id.ToString("D2")</span>
                                    <span style="font-size:13.5px;font-weight:600;color:@(locked ? "var(--tx-3)" : "var(--tx-1)")">@r.Title</span>
                                </div>
                            </td>
                            <td style="padding:13px 14px;text-align:center"><ScorePill Value="r.Auto" /></td>
                            <td style="padding:13px 14px;text-align:center"><ScorePill Value="r.Defense" /></td>
                            <td style="padding:13px 14px;text-align:center">
                                @if (r.Final is not null)
                                {
                                    <span class="mono tnum" style="font-size:16px;font-weight:780;color:var(--acc-bright)">@r.Final</span>
                                }
                                else
                                {
                                    <span class="faint mono">—</span>
                                }
                            </td>
                            <td style="padding:13px 14px;text-align:right;padding-right:24px">
                                @if (locked)
                                {
                                    <span style="display:inline-flex;align-items:center;gap:6px;color:var(--tx-faint);font-size:12.5px"><Icon Name="lock" Size="13" />Не здано</span>
                                }
                                else
                                {
                                    <Badge Status="r.Status" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @* залік progress *@
    <section class="glass" style="padding:24px 28px;position:relative;overflow:hidden">
        <div style="position:absolute;right:-30px;top:-50px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle, rgba(118,199,173,0.12), transparent 65%);pointer-events:none"></div>
        <div style="display:flex;align-items:center;gap:24px;flex-wrap:wrap;position:relative">
            <div style="flex:1 1 360px;min-width:0">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
                    <Icon Name="flame" Size="19" Style="color:var(--acc)" Fill="true" />
                    <h3 style="margin:0;font-size:16px;font-weight:720">Прогрес до заліку</h3>
                    @if (Done >= Needed)
                    {
                        <span class="badge badge-green"><span class="dot"></span>Допуск отримано</span>
                    }
                    else
                    {
                        <span class="badge badge-yellow"><span class="dot pulse"></span>Ще @(Needed - Done) лаб</span>
                    }
                </div>
                <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--tx-2);margin-bottom:8px">
                    <span><b style="color:var(--acc-bright)">@Done</b> зараховано</span>
                    <span class="mono faint">поріг заліку: @Needed</span>
                    <span>усього @Rows.Count</span>
                </div>
                <div style="position:relative">
                    <Progress Value="@(100.0 * Done / Rows.Count)" />
                    <span style="position:absolute;top:-3px;left:calc(@(100.0 * Needed / Rows.Count)% - 1px);width:2px;height:14px;background:var(--st-yellow);border-radius:2px"></span>
                </div>
                <p style="margin:16px 0 0;font-size:13px;color:var(--tx-3);line-height:1.6;max-width:480px">Для допуску до заліку потрібно <b style="color:var(--tx-1)">@Needed</b> зарахованих лабораторних. У тебе вже <b style="color:var(--acc-bright)">@Done</b> — продовжуй у тому ж темпі! 🎯</p>
            </div>
            <div style="flex:none;display:flex;flex-direction:column;align-items:center;gap:8px;padding-left:8px">
                <div style="text-align:center">
                    <div class="mono tnum" style="font-size:46px;font-weight:800;letter-spacing:-0.04em;color:var(--acc-bright);line-height:1">@AvgStr</div>
                    <div style="font-size:12px;color:var(--tx-3);margin-top:4px">середній бал курсу</div>
                </div>
                <div style="display:flex;gap:4px;margin-top:4px">
                    @for (int n = 1; n <= 5; n++)
                    {
                        <Icon Name="spark" Size="15" Style="@($"color:{(n <= Math.Round(Avg / 20.0) ? "var(--st-yellow)" : "var(--tx-faint)")}")" />
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private List<Lab> Rows = [];
    private const int Needed = 7;

    protected override async Task OnInitializedAsync()
    {
        Rows = await Data.GetStudentLabsAsync();
    }

    private List<int> Finals => Rows.Where(r => r.Final.HasValue).Select(r => r.Final!.Value).ToList();
    private double Avg    => Finals.Count > 0 ? Finals.Average() : 0;
    private string AvgStr => Avg.ToString("0.0");
    private int Done      => Rows.Count(r => r.Status == LabStatus.Done);
    private int AvgAuto   => Rows.Any(r => r.Auto.HasValue)
        ? (int)Math.Round(Rows.Where(r => r.Auto.HasValue).Average(r => r.Auto!.Value))
        : 0;
    private Lab Best => Rows.Where(r => r.Final.HasValue).OrderByDescending(r => r.Final).FirstOrDefault()
        ?? new Lab { Id = 0, Title = "—", Final = 0 };
}

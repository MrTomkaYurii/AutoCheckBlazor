@page "/student/grades"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "student")]
@inject IDataService Data
@inject NavigationManager Nav
@inject AppState App

<TopBar Title="Журнал оцінок" Sub="Усі твої оцінки за семестр" />

<div class="screen-anim page">

    @* summary stat strip *@
    <div class="stat-strip">
        <StatCard Icon="target" Tone="var(--acc)" Value="@AvgStr" Label="Середній бал" Sub="по фінальних оцінках" />
        <StatCard Icon="check" Tone="var(--st-green)" Value="@($"{Done} / {Rows.Count}")" Label="Зараховано" Sub="@($"мінімум {Needed} для заліку")" />
        <StatCard Icon="spark" Tone="var(--st-yellow)" Value="@AvgAuto.ToString()" Label="Сер. авто-оцінка" Sub="точність коду" />
        <StatCard Icon="trophy" Tone="var(--st-blue)" Value="@Best.Final.ToString()" Label="Найкраща лаба" Sub="@($"Lab{Best.Id:D2} · {Best.Title}")" />
    </div>

    @* table *@
    <section class="glass table-card">
        <div class="table-head">
            <Icon Name="grades" Size="18" Style="color:var(--acc)" />
            <h3 class="table-title">Журнал оцінок</h3>
            <span class="badge badge-grey"><span class="dot"></span>Семестр 2</span>
            <span class="mono table-updated">оновлено щойно</span>
        </div>
        <div class="table-scroll">
            <table>
                <thead>
                    <tr>
                        <th class="th-lab">Лабораторна</th>
                        <th class="th-attempt">Спроба 1</th>
                        <th class="th-attempt">Спроба 2</th>
                        <th class="th-attempt">Спроба 3</th>
                        <th class="th-mid">Авто-оцінка</th>
                        <th class="th-mid">Викладач</th>
                        <th class="th-mid">Фінальна</th>
                        <th class="th-status">Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Rows)
                    {
                        var locked = r.Status == LabStatus.Locked;
                        var bestAuto = new[] { r.Attempt1 ?? 0, r.Attempt2 ?? 0, r.Attempt3 ?? 0 }.Max();
                        <tr class="grow row" @onclick="@(() => Nav.NavigateTo($"/student/lab/{r.Id}"))" style="opacity:@(locked ? "0.5" : "1")">
                            <td class="cell-lab">
                                <div class="cell-lab-inner">
                                    <span class="mono lab-number" style="color:@(locked ? "var(--tx-faint)" : "var(--acc)");background:@(locked ? "var(--st-grey-bg)" : "var(--acc-dim)");border:1px solid @(locked ? "transparent" : "var(--glass-border)")">@r.Id.ToString("D2")</span>
                                    <span class="lab-title" style="color:@(locked ? "var(--tx-3)" : "var(--tx-1)")">@r.Title</span>
                                </div>
                            </td>
                            @foreach (var attempt in new[] { r.Attempt1, r.Attempt2, r.Attempt3 })
                            {
                                var isBest = attempt.HasValue && attempt.Value == bestAuto && bestAuto > 0;
                                <td class="cell-attempt">
                                    @if (attempt.HasValue)
                                    {
                                        <span class="mono tnum attempt-value" style="font-weight:@(isBest ? "780" : "600");color:@(isBest ? "var(--st-green)" : "var(--tx-2)");background:@(isBest ? "rgba(118,199,173,0.12)" : "rgba(255,255,255,0.04)");border:1px solid @(isBest ? "rgba(118,199,173,0.3)" : "var(--line)")">@attempt</span>
                                    }
                                    else
                                    {
                                        <span class="mono attempt-empty">—</span>
                                    }
                                </td>
                            }
                            <td class="cell-mid"><ScorePill Value="@(r.Status == LabStatus.Rejected ? null : r.Auto)" /></td>
                            <td class="cell-mid"><ScorePill Value="r.Defense" /></td>
                            <td class="cell-mid">
                                @if (r.Final is not null)
                                {
                                    <span class="mono tnum final-value">@r.Final</span>
                                }
                                else
                                {
                                    <span class="faint mono">—</span>
                                }
                            </td>
                            <td class="cell-status">
                                @if (locked)
                                {
                                    <span class="locked-label"><Icon Name="lock" Size="13" />Не здано</span>
                                }
                                else
                                {
                                    <Badge Status="r.Status" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @* залік progress *@
    <section class="glass progress-card">
        <div class="progress-glow"></div>
        <div class="progress-inner">
            <div class="progress-text-block">
                <div class="progress-head">
                    <Icon Name="flame" Size="19" Style="color:var(--acc)" Fill="true" />
                    <h3 class="progress-head-title">Прогрес до заліку</h3>
                    @if (Done >= Needed)
                    {
                        <span class="badge badge-green"><span class="dot"></span>Допуск отримано</span>
                    }
                    else
                    {
                        <span class="badge badge-yellow"><span class="dot pulse"></span>Ще @(Needed - Done) лаб</span>
                    }
                </div>
                <div class="progress-legend">
                    <span><b class="progress-legend-done">@Done</b> зараховано</span>
                    <span class="mono faint">поріг заліку: @Needed</span>
                    <span>усього @Rows.Count</span>
                </div>
                <div class="progress-bar-wrap">
                    <Progress Value="@(100.0 * Done / Rows.Count)" />
                    <span class="progress-threshold" style="left:calc(@(100.0 * Needed / Rows.Count)% - 1px)"></span>
                </div>
                <p class="progress-note">Для допуску до заліку потрібно <b class="progress-note-strong">@Needed</b> зарахованих лабораторних. У тебе вже <b class="progress-note-accent">@Done</b> — продовжуй у тому ж темпі! 🎯</p>
            </div>
            <div class="avg-block">
                <div class="avg-value-wrap">
                    <div class="mono tnum avg-value">@AvgStr</div>
                    <div class="avg-label">середній бал курсу</div>
                </div>
                <div class="star-row">
                    @for (int n = 1; n <= 5; n++)
                    {
                        <Icon Name="spark" Size="15" Style="@($"color:{(n <= Math.Round(Avg / 20.0) ? "var(--st-yellow)" : "var(--tx-faint)")}")" />
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private List<Lab> Rows = [];
    private const int Needed = 7;

    protected override async Task OnInitializedAsync()
    {
        // default parameter = student #1 — must pass the logged-in student's id
        Rows = await Data.GetStudentLabsAsync(App.StudentDbId ?? 1);
    }

    private List<int> Finals => Rows.Where(r => r.Final.HasValue).Select(r => r.Final!.Value).ToList();
    private double Avg    => Finals.Count > 0 ? Finals.Average() : 0;
    private string AvgStr => Avg.ToString("0.0");
    private int Done      => Rows.Count(r => r.Status == LabStatus.Done);
    private int AvgAuto   => Rows.Any(r => r.Auto.HasValue)
        ? (int)Math.Round(Rows.Where(r => r.Auto.HasValue).Average(r => r.Auto!.Value))
        : 0;
    private Lab Best => Rows.Where(r => r.Final.HasValue).OrderByDescending(r => r.Final).FirstOrDefault()
        ?? new Lab { Id = 0, Title = "—", Final = 0 };
}

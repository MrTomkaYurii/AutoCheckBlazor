@page "/register"
@layout LoginLayout
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject AppDbContext Db
@inject IConfiguration Cfg
@using Microsoft.EntityFrameworkCore

<div class="page">
    <div class="glass screen-anim card">

        @* Logo *@
        <div class="logo-row">
            <div class="logo-badge">{}</div>
            <div class="logo-text">
                <div class="logo-name">AutoCheck</div>
                <div class="logo-sub">C# OOP Course</div>
            </div>
        </div>

        <div class="heading">
            <h2 class="heading-title">Реєстрація студента</h2>
            <p class="heading-sub">Створіть акаунт, щоб здавати лабораторні</p>
        </div>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="error-box">@Error</div>
        }

        <form method="post" action="/account/register">
            <div class="row2">
                <div class="field">
                    <label>Ім'я</label>
                    <input class="input" name="firstName" value="@FirstName" placeholder="Петро" required />
                </div>
                <div class="field">
                    <label>Прізвище</label>
                    <input class="input" name="lastName" value="@LastName" placeholder="Іваненко" required />
                </div>
            </div>
            <div class="field">
                <label>Email</label>
                <input class="input" type="email" name="email" value="@Email" placeholder="you@example.com" required autocomplete="username" />
            </div>
            <div class="field">
                <label>Група</label>
                <select class="input group-select" name="group" required>
                    <option value="" disabled selected="@string.IsNullOrEmpty(Group)">Оберіть групу…</option>
                    @foreach (var g in _groups)
                    {
                        <option value="@g" selected="@(g == Group)">@g</option>
                    }
                </select>
            </div>
            <div class="row2">
                <div class="field">
                    <label>Пароль</label>
                    <input class="input" type="password" name="password" placeholder="мін. 6 символів" required minlength="6" autocomplete="new-password" />
                </div>
                <div class="field">
                    <label>Підтвердження</label>
                    <input class="input" type="password" name="confirm" placeholder="ще раз" required minlength="6" autocomplete="new-password" />
                </div>
            </div>
            <button type="submit" class="submit-btn">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                Зареєструватися
            </button>
        </form>

        @if (_googleEnabled)
        {
            <div class="divider-row">
                <div class="divider-line"></div>
                <span class="divider-label">або</span>
                <div class="divider-line"></div>
            </div>

            <a href="/account/google-login" class="google-btn">
                <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18A10.96 10.96 0 0 0 1 12c0 1.77.43 3.45 1.18 4.94l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
                Продовжити з Google
            </a>
        }

        <div class="footer-row">
            Вже маєте акаунт?
            <a href="/" class="footer-link">Увійти</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? FirstName { get; set; }
    [SupplyParameterFromQuery] public string? LastName { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Group { get; set; }

    private List<string> _groups = [];
    private bool _googleEnabled;

    protected override async Task OnInitializedAsync()
    {
        _googleEnabled = !string.IsNullOrEmpty(Cfg["Authentication:Google:ClientId"]);
        _groups = await Db.Groups.OrderBy(g => g.OrderIndex).ThenBy(g => g.Name)
                                 .Select(g => g.Name).ToListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Nav.NavigateTo("/", replace: true);
    }
}

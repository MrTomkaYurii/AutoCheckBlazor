@page "/teacher/monitoring"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "teacher")]
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IDataService DataSvc
@inject ICommentService CommentSvc
@inject IDialogService Dialog
@inject NavigationManager Nav
@inject PlagiarismService Plagiarism

<TopBar Title="Моніторинг" Sub="Детальна аналітика курсу" />

<div class="screen-anim page">

    @* Stat strip *@
    <div class="stat-strip">
        <TStat Icon="users"   Tone="var(--acc)"       Value="@_stats.Students.ToString()"     Label="Студентів" />
        <TStat Icon="upload"  Tone="var(--st-blue)"   Value="@_stats.Submissions.ToString()"  Label="Здач всього" />
        <TStat Icon="target"  Tone="var(--st-green)"  Value="@($"{_stats.PassRate}%")"         Label="Успішність" />
        <TStat Icon="clock"   Tone="var(--st-yellow)" Value="@_stats.PendingReview.ToString()" Label="Очікують захисту" />
    </div>

    @* Lab activity *@
    <section class="glass section">
        <div class="section-head">
            <Icon Name="grades" Size="18" Style="color:var(--acc)" />
            <h3 class="section-title">Активність по лабах</h3>
            <button class="btn btn-ghost btn-sm manage-btn" @onclick="@(() => Nav.NavigateTo("/teacher/labs"))">Керувати лабами<Icon Name="settings" Size="15" /></button>
        </div>
        <div class="lab-activity-grid">
            @foreach (var l in _labStats)
            {
                var pct = l.Total > 0 ? (int)Math.Round(100.0 * l.Submitted / l.Total) : 0;
                var fill = pct >= 70 ? "linear-gradient(90deg,var(--acc),var(--acc-bright))" : pct >= 40 ? "linear-gradient(90deg,#c9a52f,var(--st-yellow))" : "linear-gradient(90deg,#cf6650,var(--st-red))";
                <div class="lab-activity-row">
                    <span class="mono lab-short">@l.Short</span>
                    <div class="lab-activity-body">
                        <div class="lab-activity-head">
                            <span class="lab-activity-title">@l.Title</span>
                            <span class="mono tnum lab-activity-count">@l.Submitted/@l.Total</span>
                        </div>
                        <div class="prog" style="height:6px"><span style="width:@pct%;background:@fill;box-shadow:none"></span></div>
                    </div>
                    @if (l.Avg is not null)
                    {
                        <span class="mono tnum lab-activity-avg">@l.Avg</span>
                    }
                </div>
            }
        </div>
    </section>

    <div class="two-col">

        @* Score distribution *@
        <section class="glass panel">
            <h4 class="panel-title">
                <Icon Name="target" Size="16" Style="color:var(--acc)" />Розподіл фінальних оцінок
            </h4>
            @{ var bands = GetBands(); }
            @foreach (var (label, count, color) in bands)
            {
                var pct = _totalFinals > 0 ? (int)Math.Round(100.0 * count / _totalFinals) : 0;
                <div class="band-row">
                    <span class="mono band-label">@label</span>
                    <div class="prog band-bar">
                        <span style="width:@pct%;background:@color;border-radius:5px;box-shadow:none"></span>
                    </div>
                    <span class="mono tnum band-count">@count</span>
                </div>
            }
        </section>

        @* Top students *@
        <section class="glass panel">
            <h4 class="panel-title">
                <Icon Name="spark" Size="16" Style="color:var(--st-yellow)" />Топ студентів
            </h4>
            @foreach (var (s, rank) in _topStudents.Select((s, i) => (s, i + 1)))
            {
                <div class="top-student-row">
                    <span class="mono rank">@rank.</span>
                    <div class="avatar">@s.Initials</div>
                    <div class="top-student-info">
                        <div class="top-student-name">@s.Last @(s.First.Length > 0 ? s.First[0] + "." : "")</div>
                        <div class="top-student-meta">@s.Group · @s.DoneCount зараховано</div>
                    </div>
                    <span class="mono tnum top-student-avg">@s.Avg</span>
                </div>
            }
        </section>
    </div>

    <div class="two-col-list">

        @* Recent submissions *@
        <section class="glass list-card">
            <div class="list-head">
                <Icon Name="clock" Size="16" Style="color:var(--tx-3)" />
                <h4 class="list-title">Останні здачі</h4>
            </div>
            @foreach (var r in _recent)
            {
                <div class="list-row">
                    <div class="avatar">@r.Initials</div>
                    <div class="list-row-info">
                        <div class="list-row-name">@r.Name</div>
                        <div class="list-row-sub">@r.LabShort · @r.LabTitle</div>
                    </div>
                    <div class="list-row-meta">
                        <span class="mono tnum list-row-score" style="color:@(r.Auto >= 85 ? "var(--st-green)" : r.Auto >= 60 ? "var(--st-yellow)" : "var(--st-red)")">@r.Auto</span>
                        <div class="list-row-time">@r.When</div>
                    </div>
                </div>
            }
            @if (_recent.Count == 0)
            {
                <div class="list-empty">Здач поки немає</div>
            }
        </section>

        @* Problematic students *@
        <section class="glass list-card">
            <div class="list-head">
                <Icon Name="warn" Size="16" Style="color:var(--st-yellow)" />
                <h4 class="list-title">Найбільше відхилень</h4>
            </div>
            @foreach (var s in _problematic)
            {
                <div class="list-row">
                    <div class="avatar">@s.Initials</div>
                    <div class="list-row-info">
                        <div class="list-row-name">@s.Last @(s.First.Length > 0 ? s.First[0] + "." : "")</div>
                        <div class="list-row-sub">@s.Group</div>
                    </div>
                    <div class="list-row-meta">
                        <span class="rejected-count">@s.Labs.Count(c => c.Kind == "rejected") відхилено</span>
                        <div class="list-row-time">@s.DoneCount зараховано</div>
                    </div>
                </div>
            }
            @if (_problematic.Count == 0)
            {
                <div class="list-empty">Немає відхилених здач</div>
            }
        </section>
    </div>

    @* ── Журнал переписки ────────────────────────────────────────────────────── *@
    <section class="glass threads-card">
        <div class="threads-head">
            <Icon Name="spark" Size="18" Style="color:var(--acc)" />
            <h3 class="section-title">Журнал переписки</h3>
            @{
                var needReply = _threads.Count(t => t.NeedsReply);
                var totalThreads = _threads.Count;
            }
            @if (needReply > 0)
            {
                <span class="badge badge-yellow"><span class="dot pulse"></span>@needReply потребують відповіді</span>
            }
            <span class="badge badge-grey" style="margin-left:@(needReply > 0 ? "2px" : "auto")">@totalThreads діалогів</span>
            @if (needReply > 0) { <span style="margin-left:auto"></span> }
        </div>

        @if (_threads.Count == 0)
        {
            <div class="threads-empty">
                Переписок поки немає
            </div>
        }
        else
        {
            @for (int i = 0; i < _threads.Count; i++)
            {
                var t    = _threads[i];
                var last = i == _threads.Count - 1;
                var roleIcon  = t.LastAuthorRole == "teacher" ? "var(--acc)" : "var(--st-yellow)";
                var roleLabel = t.LastAuthorRole == "teacher" ? "Викладач" : "Студент";
                <div class="grow thread-row" @onclick="@(() => OpenThread(t))"
                     style="border-bottom:@(last ? "none" : "1px solid var(--line)");background:@(t.NeedsReply ? "rgba(231,193,75,0.03)" : "transparent")">

                    @* Avatar with unread dot *@
                    <div class="thread-avatar-wrap">
                        <div class="avatar">@t.Initials</div>
                        @if (t.NeedsReply)
                        {
                            <span class="thread-unread-dot"></span>
                        }
                    </div>

                    @* Info *@
                    <div class="thread-info">
                        <div class="thread-info-head">
                            <span class="thread-student-name" style="font-weight:@(t.NeedsReply ? "680" : "600")">@t.StudentName</span>
                            <span class="thread-group">@t.Group</span>
                            <span class="mono thread-lab-badge">@t.LabShort</span>
                        </div>
                        <div class="thread-preview-row">
                            <span class="thread-role-label" style="color:@roleIcon">@roleLabel:</span>
                            <span class="thread-preview-text">@t.LastPreview</span>
                        </div>
                    </div>

                    @* Meta *@
                    <div class="thread-meta">
                        <div class="thread-meta-time">@FormatWhen(t.LastAt)</div>
                        <span class="badge badge-grey thread-meta-count">@t.TotalComments повід.</span>
                    </div>

                    <button class="btn btn-outline btn-sm thread-action" @onclick:stopPropagation @onclick="@(() => OpenThread(t))">
                        @(t.NeedsReply ? "Відповісти" : "Переглянути")
                    </button>
                </div>
            }
        }
    </section>

    @* ── Перевірка на плагіат ─────────────────────────────────────────────── *@
    <section class="glass section" style="margin-top:18px">
        <div class="plag-head">
            <Icon Name="search" Size="18" Style="color:var(--st-red)" />
            <h3 class="section-title">Перевірка на плагіат</h3>
            <span class="plag-hint">— порівняння коду здач між студентами</span>
            <div class="plag-controls">
                <select class="input plag-select" @bind="_plagLab">
                    <option value="0" disabled>Оберіть лабу…</option>
                    @foreach (var (id, sh, title) in _labCols)
                    {
                        <option value="@id">@sh · @title</option>
                    }
                </select>
                <button class="btn btn-primary btn-sm" @onclick="RunPlagiarism" disabled="@(_plagLab == 0 || _plagRunning)">
                    <Icon Name="search" Size="14" />@(_plagRunning ? "Аналіз…" : "Перевірити")
                </button>
            </div>
        </div>

        @if (_plagChecked)
        {
            @if (_plagPairs.Count == 0)
            {
                <div class="plag-state">
                    Підозрілих збігів не знайдено (поріг 50% спільного коду) ✓
                </div>
            }
            else
            {
                <div class="plag-list">
                    @foreach (var p in _plagPairs)
                    {
                        var pct = (int)Math.Round(p.Similarity * 100);
                        var tone = pct >= 80 ? "var(--st-red)" : "var(--st-yellow)";
                        <div class="plag-pair-row" style="border:1px solid @(tone)33">
                            <span class="mono tnum plag-pct" style="color:@tone">@pct%</span>
                            <div class="plag-names">
                                <b>@p.StudentA</b> <span class="plag-group">(@p.GroupA)</span>
                                <span class="plag-arrow"> ↔ </span>
                                <b>@p.StudentB</b> <span class="plag-group">(@p.GroupB)</span>
                            </div>
                            <span class="plag-shared">@p.SharedLines спільних рядків коду</span>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="plag-state-idle">
                Оберіть лабу і натисніть «Перевірити» — система порівняє код усіх зданих робіт попарно.
            </div>
        }
    </section>
</div>

@code {
    private TeacherStats _stats = new();
    private List<RosterStudent> _topStudents = [];
    private List<RosterStudent> _problematic = [];
    private List<ReviewItem>    _recent = [];
    private List<LabStat>       _labStats = [];
    private List<CommentThread> _threads = [];
    private int _totalFinals;
    private List<int> _finals = [];

    // ── Plagiarism ────────────────────────────────────────────────────────────
    private List<(int Id, string Short, string Title)> _labCols = [];
    private int _plagLab;
    private bool _plagRunning, _plagChecked;
    private List<PlagPair> _plagPairs = [];

    private async Task RunPlagiarism()
    {
        if (_plagLab == 0) return;
        _plagRunning = true; StateHasChanged();
        try
        {
            _plagPairs = await Plagiarism.CheckLabAsync(_plagLab);
            _plagChecked = true;
        }
        finally
        {
            _plagRunning = false; StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _labCols = await DataSvc.GetLabColumnsAsync();
        _stats = await DataSvc.GetStatsAsync();
        var roster = await DataSvc.GetRosterAsync();
        _topStudents = roster.Where(s => s.Avg.HasValue).OrderByDescending(s => s.Avg).Take(5).ToList();
        _problematic = roster.Where(s => s.Labs.Any(c => c.Kind == "rejected")).OrderByDescending(s => s.Labs.Count(c => c.Kind == "rejected")).Take(5).ToList();
        _recent   = await DataSvc.GetReviewQueueAsync();
        _labStats = await DataSvc.GetLabStatsAsync();
        _threads  = await CommentSvc.GetAllThreadsAsync();

        await using var Db = await DbFactory.CreateDbContextAsync();
        _finals      = await Db.Submissions.Where(s => s.FinalScore.HasValue).Select(s => s.FinalScore!.Value).ToListAsync();
        _totalFinals = _finals.Count;
    }

    private async Task OpenThread(CommentThread t)
    {
        var p = new DialogParameters
        {
            ["SubmissionId"] = t.SubmissionId,
            ["LabTitle"]     = t.LabTitle,
            ["StudentName"]  = t.StudentName,
            ["CanDelete"]    = true,
        };
        var opt = new DialogOptions { BackdropClick = true, NoHeader = true };
        var dlg = await Dialog.ShowAsync<AutoCheck.Components.Dialogs.CommentDialog>("", p, opt);
        await dlg.Result;
        _threads = await CommentSvc.GetAllThreadsAsync();
        StateHasChanged();
    }

    private static string FormatWhen(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 2)  return "щойно";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} хв тому";
        if (diff.TotalHours   < 24) return $"{(int)diff.TotalHours} год тому";
        return dt.ToLocalTime().ToString("dd.MM HH:mm");
    }

    private List<(string Label, int Count, string Color)> GetBands() =>
    [
        ("91–100", _finals.Count(f => f >= 91),              "var(--st-green)"),
        ("81–90",  _finals.Count(f => f >= 81 && f <= 90),   "var(--acc)"),
        ("71–80",  _finals.Count(f => f >= 71 && f <= 80),   "var(--acc)"),
        ("61–70",  _finals.Count(f => f >= 61 && f <= 70),   "var(--st-yellow)"),
        ("51–60",  _finals.Count(f => f >= 51 && f <= 60),   "var(--st-yellow)"),
        ("36–50",  _finals.Count(f => f >= 36 && f <= 50),   "var(--st-red)"),
        ("0–35",   _finals.Count(f => f <= 35),               "var(--st-red)"),
    ];
}

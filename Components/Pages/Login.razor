@page "/"
@layout LoginLayout
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject AppState App
@inject IConfiguration Cfg
@inject IWebHostEnvironment Env

<div class="page">

    @* ── Left brand panel ────────────────────────────────────────────────────── *@
    <div class="auth-left left-panel">
        <div class="left-glow"></div>
        <div class="mono left-code">@CodeText</div>

        @* Logo + University *@
        <div class="brand-block">
            <div class="brand-row">
                <div class="brand-badge">{}</div>
                <div class="brand-text">
                    <div class="brand-name">AutoCheck</div>
                    <div class="brand-sub">C# OOP Course</div>
                </div>
            </div>
            @* University badge *@
            <div class="uni-badge">
                <span class="uni-text">
                    Кафедра комп'ютерних наук<br />
                    <span class="uni-text-dept">Чернівецький національний університет ім. Ю. Федьковича</span>
                </span>
            </div>
        </div>

        @* Hero text *@
        <div class="hero">
            <div class="badge badge-green hero-badge"><span class="dot pulse"></span>Семестр 2 · @AppInfo.AcademicYear</div>
            <h1 class="hero-title">
                Об'єктно-орієнтоване<br />програмування <span class="hero-accent">на C#</span>
            </h1>
            <p class="hero-text">
                Здавайте лабораторні, отримуйте миттєву авто-перевірку коду та фідбек, відстежуйте прогрес до заліку — в одному місці.
            </p>
            <div class="stats-row">
                @foreach (var (a, b) in new[] { ("22", "лабораторних"), ("auto", "перевірка коду"), ("GitHub", "інтеграція") })
                {
                    <div>
                        <div class="mono stat-value">@a</div>
                        <div class="stat-label">@b</div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="left-footer">
            © @AppInfo.AcademicYear · Кафедра КН · ЧНУ ім. Ю. Федьковича<br />
            <a href="/about" style="color:var(--tx-3);text-decoration:none;font-weight:600">@AppInfo.Name v@(AppInfo.Version)</a>
            · Розроблено @AppInfo.Author
        </div>
    </div>

    @* ── Right login panel ────────────────────────────────────────────────────── *@
    <div class="right-panel">
        <div class="glass screen-anim card">

            <div class="card-head">
                <h2 class="card-title">
                    @if (_loading)
                    { <span>Завантаження…</span> }
                    else
                    { <span>З поверненням 👋</span> }
                </h2>
                <p class="card-sub">
                    Увійдіть у свій акаунт AutoCheck
                </p>
            </div>

            @if (_loading)
            {
                <div class="loading-row">
                    <span class="spinner"></span>
                    Перевірка авторизації…
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="error-box">@Error</div>
                }

                @* Email + password form (plain POST — auth cookie is set outside the circuit) *@
                <form method="post" action="/account/login">
                    <input type="hidden" name="returnUrl" value="@_returnUrl" />
                    <div class="field">
                        <label>Email</label>
                        <input class="input" type="email" name="email" value="@Email" placeholder="you@example.com" required autocomplete="username" />
                    </div>
                    <div class="field">
                        <label>Пароль</label>
                        <input class="input" type="password" name="password" placeholder="••••••••" required autocomplete="current-password" />
                    </div>
                    <div style="text-align:right;margin:-6px 0 10px">
                        <a href="/forgot" class="footer-link" style="font-size:.85rem">Забули пароль?</a>
                    </div>
                    <button type="submit" class="submit-btn">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                        Увійти
                    </button>
                </form>

                @if (_googleEnabled)
                {
                    <div class="divider-row">
                        <div class="divider-line"></div>
                        <span class="divider-label">або</span>
                        <div class="divider-line"></div>
                    </div>

                    <a href="/account/google-login?returnUrl=@Uri.EscapeDataString(_returnUrl)" class="google-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18A10.96 10.96 0 0 0 1 12c0 1.77.43 3.45 1.18 4.94l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
                        Увійти через Google
                    </a>
                }

                <div class="register-row">
                    Немає акаунта?
                    <a href="/register" class="register-link">Зареєструватися</a>
                </div>

                @* Test accounts — development only, never advertise credentials in prod *@
                @if (Env.IsDevelopment())
                {
                    <div class="test-divider-row">
                        <div class="divider-line"></div>
                        <span class="divider-label">тестові акаунти</span>
                        <div class="divider-line"></div>
                    </div>

                    <div class="test-list">
                        @foreach (var (role, email, icon, tone) in new[]
                        {
                            ("Студент",   "student@test.com",  "profile", "var(--acc)"),
                            ("Викладач",  "teacher@test.com",  "users",   "var(--st-yellow)"),
                        })
                        {
                            <div class="test-row">
                                <span class="test-icon" style="background:@(tone)18;color:@tone">
                                    <Icon Name="@icon" Size="16" />
                                </span>
                                <div class="test-text">
                                    <div class="test-role">@role</div>
                                    <div class="mono test-email">@email</div>
                                </div>
                                <code class="mono test-password">Test1234!</code>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private bool _loading = true;
    private bool _googleEnabled;
    private string _returnUrl = "/";

    protected override void OnInitialized()
    {
        _googleEnabled = !string.IsNullOrEmpty(Cfg["Authentication:Google:ClientId"]);
        _returnUrl = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') ? ReturnUrl : "/";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // If already authenticated → redirect to appropriate dashboard
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            var dest = App.IsTeacher(state.User) ? "/teacher" : "/student";
            Nav.NavigateTo(dest, replace: true);
            return;
        }
        _loading = false;
        StateHasChanged();
    }

    private const string CodeText =
@"public class Student : IGradable
{
    public string Name { get; init; }
    private List<Lab> _labs = new();

    public double Average() =>
        _labs.Average(l => l.Final);
}";
}

@page "/"
@layout LoginLayout
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider
@inject AppState App
@inject IConfiguration Cfg
@inject IWebHostEnvironment Env

<div style="position:relative;z-index:1;min-height:100%;display:grid;grid-template-columns:1.05fr 0.95fr">

    @* ── Left brand panel ────────────────────────────────────────────────────── *@
    <div class="auth-left" style="position:relative;overflow:hidden;padding:56px 60px;display:flex;flex-direction:column;justify-content:space-between;border-right:1px solid var(--line)">
        <div style="position:absolute;inset:0;z-index:0;pointer-events:none;background:radial-gradient(700px 500px at 20% 10%, rgba(118,199,173,0.14), transparent 60%), radial-gradient(600px 500px at 90% 100%, rgba(118,199,173,0.08), transparent 55%)"></div>
        <div class="mono" style="position:absolute;right:-10px;bottom:120px;z-index:0;opacity:0.06;font-size:15px;line-height:1.85;color:var(--acc-bright);white-space:pre;transform:rotate(-4deg);pointer-events:none;user-select:none">@CodeText</div>

        @* Logo + University *@
        <div style="position:relative;z-index:1">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px">
                <div style="width:46px;height:46px;border-radius:12px;flex:none;display:grid;place-items:center;background:linear-gradient(150deg, var(--acc-bright), var(--acc));color:#08110d;box-shadow:0 8px 22px -10px rgba(118,199,173,0.8), inset 0 1px 0 rgba(255,255,255,0.35);font-weight:800;font-family:var(--mono);font-size:23px;letter-spacing:-0.04em">{}</div>
                <div style="line-height:1.2">
                    <div style="font-weight:750;font-size:16px;letter-spacing:-0.02em">AutoCheck</div>
                    <div style="font-size:11px;color:var(--acc);font-weight:600">C# OOP Course</div>
                </div>
            </div>
            @* University badge *@
            <div style="display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:9px;background:rgba(118,199,173,0.07);border:1px solid rgba(118,199,173,0.18)">
                <span style="font-size:11.5px;color:var(--tx-2);line-height:1.4">
                    Кафедра комп'ютерних наук<br />
                    <span style="color:var(--tx-3)">Чернівецький національний університет ім. Ю. Федьковича</span>
                </span>
            </div>
        </div>

        @* Hero text *@
        <div style="position:relative;z-index:1;max-width:460px">
            <div class="badge badge-green" style="margin-bottom:22px"><span class="dot pulse"></span>Семестр 2 · 2025–2026</div>
            <h1 style="margin:0;font-size:38px;line-height:1.1;letter-spacing:-0.035em;font-weight:780">
                Об'єктно-орієнтоване<br />програмування <span style="color:var(--acc)">на C#</span>
            </h1>
            <p style="margin:18px 0 0;font-size:15.5px;line-height:1.65;color:var(--tx-2);max-width:420px">
                Здавайте лабораторні, отримуйте миттєву авто-перевірку коду та фідбек, відстежуйте прогрес до заліку — в одному місці.
            </p>
            <div style="display:flex;gap:30px;margin-top:38px">
                @foreach (var (a, b) in new[] { ("22", "лабораторних"), ("auto", "перевірка коду"), ("GitHub", "інтеграція") })
                {
                    <div>
                        <div class="mono" style="font-size:22px;font-weight:750;color:var(--acc-bright);letter-spacing:-0.02em">@a</div>
                        <div style="font-size:12px;color:var(--tx-3);margin-top:3px">@b</div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div style="position:relative;z-index:1;font-size:11.5px;color:var(--tx-faint)">
            © 2025–2026 · Кафедра КН · ЧНУ ім. Ю. Федьковича
        </div>
    </div>

    @* ── Right login panel ────────────────────────────────────────────────────── *@
    <div style="display:grid;place-items:center;padding:40px 28px">
        <div class="glass screen-anim" style="width:100%;max-width:408px;padding:34px">

            <div style="margin-bottom:24px">
                <h2 style="margin:0 0 6px;font-size:24px;font-weight:730;letter-spacing:-0.025em">
                    @if (_loading)
                    { <span>Завантаження…</span> }
                    else
                    { <span>З поверненням 👋</span> }
                </h2>
                <p style="margin:0;color:var(--tx-3);font-size:13.5px">
                    Увійдіть у свій акаунт AutoCheck
                </p>
            </div>

            @if (_loading)
            {
                <div style="display:flex;align-items:center;justify-content:center;gap:12px;padding:20px 0;color:var(--tx-2)">
                    <span style="width:20px;height:20px;border-radius:50%;border:2.5px solid var(--acc-dim-2);border-top-color:var(--acc);animation:spin .8s linear infinite"></span>
                    Перевірка авторизації…
                </div>
            }
            else
            {
                @if (!string.IsNullOrEmpty(Error))
                {
                    <div style="margin-bottom:16px;padding:10px 14px;background:rgba(255,80,80,0.08);border:1px solid rgba(255,80,80,0.25);border-radius:10px;color:var(--st-red);font-size:13px;line-height:1.5">@Error</div>
                }

                @* Email + password form (plain POST — auth cookie is set outside the circuit) *@
                <form method="post" action="/account/login" style="display:flex;flex-direction:column;gap:14px">
                    <input type="hidden" name="returnUrl" value="@_returnUrl" />
                    <div class="field">
                        <label>Email</label>
                        <input class="input" type="email" name="email" value="@Email" placeholder="you@example.com" required autocomplete="username" />
                    </div>
                    <div class="field">
                        <label>Пароль</label>
                        <input class="input" type="password" name="password" placeholder="••••••••" required autocomplete="current-password" />
                    </div>
                    <button type="submit"
                            style="display:flex;align-items:center;justify-content:center;gap:11px;height:50px;border:none;cursor:pointer;border-radius:13px;background:linear-gradient(160deg, var(--acc-bright), var(--acc));color:#08110d;font-weight:750;font-size:15px;box-shadow:0 8px 24px -10px rgba(118,199,173,0.8),inset 0 1px 0 rgba(255,255,255,0.25);transition:opacity .18s;letter-spacing:-0.01em;font-family:inherit">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                        Увійти
                    </button>
                </form>

                @if (_googleEnabled)
                {
                    <div style="display:flex;align-items:center;gap:12px;margin:18px 0">
                        <div style="flex:1;height:1px;background:var(--line)"></div>
                        <span style="font-size:12px;color:var(--tx-faint)">або</span>
                        <div style="flex:1;height:1px;background:var(--line)"></div>
                    </div>

                    <a href="/account/google-login?returnUrl=@Uri.EscapeDataString(_returnUrl)"
                       style="display:flex;align-items:center;justify-content:center;gap:11px;height:48px;border-radius:13px;background:rgba(255,255,255,0.04);border:1px solid var(--line-strong);color:var(--tx-1);font-weight:650;font-size:14px;text-decoration:none;transition:background .18s,border-color .18s">
                        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18A10.96 10.96 0 0 0 1 12c0 1.77.43 3.45 1.18 4.94l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
                        Увійти через Google
                    </a>
                }

                <div style="text-align:center;margin-top:20px;font-size:13px;color:var(--tx-3)">
                    Немає акаунта?
                    <a href="/register" style="color:var(--acc-bright);font-weight:650;text-decoration:none">Зареєструватися</a>
                </div>

                @* Divider *@
                @* Test accounts — development only, never advertise credentials in prod *@
                @if (Env.IsDevelopment())
                {
                    <div style="display:flex;align-items:center;gap:12px;margin:22px 0 14px">
                        <div style="flex:1;height:1px;background:var(--line)"></div>
                        <span style="font-size:12px;color:var(--tx-faint)">тестові акаунти</span>
                        <div style="flex:1;height:1px;background:var(--line)"></div>
                    </div>

                    <div style="display:flex;flex-direction:column;gap:8px">
                        @foreach (var (role, email, icon, tone) in new[]
                        {
                            ("Студент",   "student@test.com",  "profile", "var(--acc)"),
                            ("Викладач",  "teacher@test.com",  "users",   "var(--st-yellow)"),
                        })
                        {
                            <div style="display:flex;align-items:center;gap:12px;padding:11px 14px;border-radius:11px;background:rgba(255,255,255,0.025);border:1px solid var(--line)">
                                <span style="width:32px;height:32px;border-radius:9px;flex:none;display:grid;place-items:center;background:@(tone)18;color:@tone">
                                    <Icon Name="@icon" Size="16" />
                                </span>
                                <div style="flex:1;min-width:0">
                                    <div style="font-size:12px;color:var(--tx-3);font-weight:600">@role</div>
                                    <div class="mono" style="font-size:12.5px;color:var(--tx-2)">@email</div>
                                </div>
                                <code class="mono" style="font-size:11.5px;color:var(--tx-faint);background:rgba(255,255,255,0.04);padding:3px 8px;border-radius:6px;border:1px solid var(--line)">Test1234!</code>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private bool _loading = true;
    private bool _googleEnabled;
    private string _returnUrl = "/";

    protected override void OnInitialized()
    {
        _googleEnabled = !string.IsNullOrEmpty(Cfg["Authentication:Google:ClientId"]);
        _returnUrl = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') ? ReturnUrl : "/";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // If already authenticated → redirect to appropriate dashboard
        var state = await AuthProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            var dest = App.IsTeacher(state.User) ? "/teacher" : "/student";
            Nav.NavigateTo(dest, replace: true);
            return;
        }
        _loading = false;
        StateHasChanged();
    }

    private const string CodeText =
@"public class Student : IGradable
{
    public string Name { get; init; }
    private List<Lab> _labs = new();

    public double Average() =>
        _labs.Average(l => l.Final);
}";
}

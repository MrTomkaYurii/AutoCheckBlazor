@page "/forgot"
@layout LoginLayout

<div class="page">
    <div class="glass screen-anim card">

        <div class="logo-row">
            <div class="logo-badge">{}</div>
            <div class="logo-text">
                <div class="logo-name">AutoCheck</div>
                <div class="logo-sub">C# OOP Course</div>
            </div>
        </div>

        <div class="heading">
            <h2 class="heading-title">Відновлення паролю</h2>
            <p class="heading-sub">Надішлемо посилання для зміни паролю на вашу пошту</p>
        </div>

        @if (Sent == "1")
        {
            <div class="error-box" style="border-color:var(--st-green);color:var(--st-green)">
                Якщо акаунт з такою поштою існує — лист із посиланням надіслано.
                Перевірте вхідні та «Спам».
            </div>
            <div class="footer-row">
                <a href="/" class="footer-link">← Повернутися до входу</a>
            </div>
        }
        else
        {
            <form method="post" action="/account/forgot">
                <div class="field">
                    <label>Email</label>
                    <input class="input" type="email" name="email" value="@Email"
                           placeholder="you@chnu.edu.ua" required autocomplete="username" />
                </div>
                <button type="submit" class="submit-btn">Надіслати посилання</button>
            </form>

            <div class="footer-row">
                Згадали пароль?
                <a href="/" class="footer-link">Увійти</a>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Sent { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
}

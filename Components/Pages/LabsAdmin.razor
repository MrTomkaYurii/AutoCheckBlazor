@page "/teacher/labs"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "teacher")]
@inject ILabManagementService LabSvc
@inject IDialogService Dialog
@inject IDataService DataSvc
@inject AppDbContext Db
@inject IJSRuntime JS

<TopBar Title="Лабораторні" Sub="Управління лабами та завданнями" />

<div class="screen-anim page">

    @* Header toolbar *@
    <div class="toolbar">
        <div class="input-wrap search-wrap">
            <span class="lead"><Icon Name="search" Size="16" /></span>
            <input class="input search-input" placeholder="Пошук лаби…" @bind="_query" @bind:event="oninput" />
        </div>
        <button class="btn btn-ghost btn-sm import-btn" @onclick="OpenImport">
            <Icon Name="upload" Size="15" />Імпорт з MD
        </button>
        <button class="btn btn-primary btn-sm" @onclick="AddLab">
            <Icon Name="braces" Size="15" />Нова лаба
        </button>
    </div>

    @* Lab list *@
    <section class="glass card">
        <div class="card-head">
            <Icon Name="settings" Size="18" Style="color:var(--acc)" />
            <h3 class="card-title">Лабораторні роботи</h3>
            <span class="badge badge-grey"><span class="dot"></span>@Filtered.Count лаб</span>
        </div>

        @if (Filtered.Count == 0 && !_loading)
        {
            <div class="empty">Лаби не знайдено. Натисніть «Нова лаба» або «Імпорт з MD».</div>
        }

        @foreach (var lab in Filtered)
        {
            var stat = _stats.FirstOrDefault(s => s.Id == lab.Number);
            var isExpanded = _expanded == lab.Id;
            <div class="lab-block">
                @* Lab row *@
                <div class="lab-row">
                    <span class="mono lab-number">@lab.Number.ToString("D2")</span>
                    <div>
                        <div class="lab-title">@lab.Title</div>
                        <div class="lab-sub">
                            @if (!string.IsNullOrEmpty(lab.BranchName))
                            {
                                <span class="mono lab-branch">@lab.BranchName</span>
                            }
                            <span class="lab-taskcount">@lab.Tasks.Count завд.</span>
                        </div>
                    </div>
                    @* Deadline column *@
                    <div class="deadline-col">
                        @if (lab.Deadline.HasValue)
                        {
                            var dlLocal = lab.Deadline.Value.ToLocalTime();
                            var dlOver  = DateTime.UtcNow > lab.Deadline.Value;
                            <div class="deadline-row">
                                <div class="deadline-date" style="color:@(dlOver ? "var(--st-red)" : "var(--tx-3)")">
                                    <Icon Name="calendar" Size="11" />
                                    <span>@dlLocal.ToString("dd.MM.yy")</span>
                                </div>
                                @if (dlOver) { <span class="deadline-overdue">прострочено</span> }
                            </div>
                        }
                        else
                        {
                            <span class="deadline-empty">—</span>
                        }
                    </div>
                    @* Stats column *@
                    <div class="stats-col">
                        @if (stat is not null)
                        {
                            <div>Здано: <span class="mono stats-submitted">@stat.Submitted / @stat.Total</span></div>
                            @if (stat.Avg.HasValue)
                            {
                                <div>Серед.: <span class="mono stats-avg">@stat.Avg</span></div>
                            }
                        }
                    </div>

                    @* Status breakdown column *@
                    <div class="status-col">
                        @if (stat is null || (stat.Done == 0 && stat.Review == 0 && stat.Rejected == 0))
                        {
                            <span class="badge badge-grey status-badge"><span class="dot"></span>Немає здач</span>
                        }
                        else
                        {
                            @if (stat.Done > 0)
                            {
                                <span class="badge badge-green status-badge"><span class="dot"></span>@stat.Done зарах.</span>
                            }
                            @if (stat.Review > 0)
                            {
                                <span class="badge badge-yellow status-badge"><span class="dot pulse"></span>@stat.Review захист</span>
                            }
                            @if (stat.Rejected > 0)
                            {
                                <span class="badge badge-red status-badge"><span class="dot"></span>@stat.Rejected відхил.</span>
                            }
                        }
                    </div>
                    <div class="lab-actions">
                        <button class="btn btn-ghost btn-sm" @onclick="@(() => ToggleExpand(lab.Id))" title="@(isExpanded ? "Закрити" : "Завдання")">
                            <Icon Name="@(isExpanded ? "x" : "spark")" Size="14" />
                            @(isExpanded ? "Закрити" : "Завдання")
                        </button>
                        <button class="btn btn-ghost btn-sm" @onclick="@(() => EditLab(lab))" title="Редагувати"><Icon Name="settings" Size="14" /></button>
                        <button class="btn btn-ghost btn-sm delete-btn" @onclick="@(() => DeleteLab(lab))" title="Видалити"><Icon Name="x" Size="14" /></button>
                    </div>
                </div>

                @* Expanded task section *@
                @if (isExpanded)
                {
                    <div class="task-panel">
                        <div class="task-panel-head">
                            <span class="task-panel-title">Завдання</span>
                            <button class="btn btn-primary btn-sm" @onclick="@(() => AddTask(lab))">
                                <Icon Name="braces" Size="13" />Нове завдання
                            </button>
                        </div>
                        @if (lab.Tasks.Count == 0)
                        {
                            <div class="task-empty">Завдань ще немає</div>
                        }
                        else
                        {
                            @foreach (var t in lab.Tasks.OrderBy(t => t.Number))
                            {
                                <div class="task-row">
                                    <span class="mono task-num">@t.Number</span>
                                    <span class="task-title">@t.Title</span>
                                    <span class="task-stars">@("⭐".PadRight(t.Difficulty, '⭐').Trim())</span>
                                    <div class="task-actions">
                                        <button class="btn btn-ghost btn-sm" @onclick="@(() => EditTask(lab, t))"><Icon Name="settings" Size="13" /></button>
                                        <button class="btn btn-ghost btn-sm delete-btn" @onclick="@(() => DeleteTask(t))"><Icon Name="x" Size="13" /></button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }
    </section>
</div>

@code {
    private List<LabDef> _labs = [];
    private List<LabStat> _stats = [];
    private string _query = "";
    private int _expanded;
    private bool _loading = true;

    private List<LabDef> Filtered => string.IsNullOrEmpty(_query)
        ? _labs
        : _labs.Where(l => l.Title.Contains(_query, StringComparison.OrdinalIgnoreCase)
                         || l.Number.ToString().Contains(_query)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        _loading = false;
    }

    private async Task Reload()
    {
        _labs  = await LabSvc.GetAllAsync();
        _stats = await DataSvc.GetLabStatsAsync();
    }

    private void ToggleExpand(int id) => _expanded = _expanded == id ? 0 : id;

    private async Task AddLab()
    {
        var dlg = await Dialog.ShowAsync<LabDialog>("", new DialogOptions { BackdropClick = true, NoHeader = true });
        if ((await dlg.Result)?.Data is true) await Reload();
    }

    private async Task EditLab(LabDef lab)
    {
        var p = new DialogParameters { ["Existing"] = lab };
        var dlg = await Dialog.ShowAsync<LabDialog>("", p, new DialogOptions { BackdropClick = true, NoHeader = true });
        if ((await dlg.Result)?.Data is true) await Reload();
    }

    private async Task DeleteLab(LabDef lab)
    {
        // deleting a lab cascade-removes every student's submissions, results and
        // comments for it — must be confirmed, there is no undo
        var stat = _stats.FirstOrDefault(s => s.Id == lab.Number);
        var submitted = stat?.Submitted ?? 0;
        var warn = submitted > 0
            ? $"\n\nУВАГА: буде втрачено здачі та оцінки {submitted} студент(ів) по цій лабі."
            : "";
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Видалити Lab{lab.Number:D2} «{lab.Title}»?{warn}");
        if (!ok) return;

        await LabSvc.DeleteAsync(lab.Id);
        await Reload();
    }

    private static readonly DialogOptions TaskDlgOpts = new()
    {
        BackdropClick = true,
        NoHeader      = true,
    };

    private async Task AddTask(LabDef lab)
    {
        var p = new DialogParameters { ["LabId"] = lab.Id };
        var dlg = await Dialog.ShowAsync<TaskDialog>("", p, TaskDlgOpts);
        if ((await dlg.Result)?.Data is true) await Reload();
    }

    private async Task EditTask(LabDef lab, LabTask t)
    {
        var p = new DialogParameters { ["LabId"] = lab.Id, ["Existing"] = t };
        var dlg = await Dialog.ShowAsync<TaskDialog>("", p, TaskDlgOpts);
        if ((await dlg.Result)?.Data is true) await Reload();
    }

    private async Task DeleteTask(LabTask t)
    {
        // task deletion cascades to every student's TaskResults for it
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Видалити завдання {t.Number} «{t.Title}»? Результати перевірок цього завдання буде втрачено.");
        if (!ok) return;

        await LabSvc.DeleteTaskAsync(t.Id);
        await Reload();
    }

    private async Task OpenImport()
    {
        var dlg = await Dialog.ShowAsync<MdImportDialog>("", new DialogOptions { BackdropClick = false, NoHeader = true });
        if ((await dlg.Result)?.Data is true) await Reload();
    }
}

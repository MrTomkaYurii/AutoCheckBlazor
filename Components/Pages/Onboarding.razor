@page "/onboarding"
@layout LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NavigationManager Nav
@inject AppDbContext Db
@inject IAuthService Auth
@inject AppState App
@using Microsoft.EntityFrameworkCore

<div style="position:relative;z-index:1;min-height:100%;display:grid;place-items:center;padding:40px 28px">
    <div class="glass screen-anim" style="width:100%;max-width:440px;padding:34px">

        <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px">
            <div style="width:40px;height:40px;border-radius:11px;flex:none;display:grid;place-items:center;background:linear-gradient(150deg, var(--acc-bright), var(--acc));color:#08110d;box-shadow:0 8px 22px -10px rgba(118,199,173,0.8), inset 0 1px 0 rgba(255,255,255,0.35);font-weight:800;font-family:var(--mono);font-size:20px;letter-spacing:-0.04em">{}</div>
            <div style="line-height:1.2">
                <div style="font-weight:750;font-size:15px;letter-spacing:-0.02em">AutoCheck</div>
                <div style="font-size:11px;color:var(--acc);font-weight:600">C# OOP Course</div>
            </div>
        </div>

        <div style="margin-bottom:22px">
            <h2 style="margin:0 0 6px;font-size:23px;font-weight:730;letter-spacing:-0.025em">Майже готово 🎓</h2>
            <p style="margin:0;color:var(--tx-3);font-size:13.5px;line-height:1.5">
                Заповніть дані студента, щоб викладач бачив вас у журналі своєї групи.
            </p>
        </div>

        @if (_sessionStale)
        {
            <div style="display:flex;flex-direction:column;gap:16px">
                <div style="padding:12px 16px;background:rgba(255,80,80,0.08);border:1px solid rgba(255,80,80,0.25);border-radius:10px;color:var(--st-red);font-size:13px;line-height:1.5">
                    Сесія застаріла — акаунт не знайдено (можливо, базу даних було скинуто). Увійдіть заново.
                </div>
                <form method="post" action="/account/logout">
                    <AntiforgeryToken />
                    <button type="submit"
                            style="width:100%;display:flex;align-items:center;justify-content:center;gap:11px;height:48px;border:none;cursor:pointer;border-radius:13px;background:linear-gradient(160deg, var(--acc-bright), var(--acc));color:#08110d;font-weight:750;font-size:15px;box-shadow:0 8px 24px -10px rgba(118,199,173,0.8),inset 0 1px 0 rgba(255,255,255,0.25);font-family:inherit">
                        <Icon Name="logout" Size="17" />Увійти заново
                    </button>
                </form>
            </div>
        }
        else if (_student == null)
        {
            <div style="display:flex;align-items:center;justify-content:center;gap:12px;padding:20px 0;color:var(--tx-2)">
                <span style="width:20px;height:20px;border-radius:50%;border:2.5px solid var(--acc-dim-2);border-top-color:var(--acc);animation:spin .8s linear infinite"></span>
                Завантаження…
            </div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:14px">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                    <div class="field"><label>Ім'я</label><input class="input" @bind="_firstName" placeholder="Петро" /></div>
                    <div class="field"><label>Прізвище</label><input class="input" @bind="_lastName" placeholder="Іваненко" /></div>
                </div>
                <div class="field">
                    <label>Група</label>
                    <select class="input" @bind="_group" style="appearance:auto">
                        <option value="" disabled>Оберіть групу…</option>
                        @foreach (var g in _groups)
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>GitHub репо <span style="color:var(--tx-faint);font-weight:400">(можна додати пізніше у профілі)</span></label>
                    <input class="input mono" @bind="_github" placeholder="https://github.com/username/repo" />
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div style="padding:10px 14px;background:rgba(255,80,80,0.08);border:1px solid rgba(255,80,80,0.25);border-radius:10px;color:var(--st-red);font-size:13px">@_error</div>
                }

                <button @onclick="SaveAsync" disabled="@_saving"
                        style="display:flex;align-items:center;justify-content:center;gap:11px;height:50px;border:none;cursor:pointer;border-radius:13px;background:linear-gradient(160deg, var(--acc-bright), var(--acc));color:#08110d;font-weight:750;font-size:15px;box-shadow:0 8px 24px -10px rgba(118,199,173,0.8),inset 0 1px 0 rgba(255,255,255,0.25);letter-spacing:-0.01em;font-family:inherit;opacity:@(_saving ? "0.6" : "1")">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    @(_saving ? "Збереження…" : "Розпочати навчання")
                </button>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private StudentRecord? _student;
    private List<string> _groups = [];
    private string _firstName = "", _lastName = "", _group = "", _github = "", _error = "";
    private bool _saving, _sessionStale;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask;
        if (Auth.IsTeacher(state.User))
        {
            Nav.NavigateTo("/teacher", replace: true);
            return;
        }

        await Auth.EnsureLinkedAsync(state.User);
        _student = await Auth.GetStudentRecordAsync(state.User);
        if (_student == null)
        {
            // Auth cookie points to a user that no longer exists (e.g. DB was reset)
            _sessionStale = true;
            return;
        }

        // Already onboarded → straight to the dashboard
        if (!string.IsNullOrEmpty(_student.Group))
        {
            Nav.NavigateTo("/student", replace: true);
            return;
        }

        _firstName = _student.FirstName == "Новий"   ? "" : _student.FirstName;
        _lastName  = _student.LastName  == "Студент" ? "" : _student.LastName;
        _github    = _student.Github;
        _groups    = await Db.Groups.OrderBy(g => g.OrderIndex).ThenBy(g => g.Name)
                                    .Select(g => g.Name).ToListAsync();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))
        { _error = "Вкажіть ім'я та прізвище."; return; }
        if (string.IsNullOrEmpty(_group))
        { _error = "Оберіть групу."; return; }

        _saving = true; _error = ""; StateHasChanged();

        var initials = _firstName.Trim()[0].ToString() + _lastName.Trim()[0];
        await Db.Students.Where(s => s.Id == _student!.Id).ExecuteUpdateAsync(s => s
            .SetProperty(x => x.FirstName, _firstName.Trim())
            .SetProperty(x => x.LastName,  _lastName.Trim())
            .SetProperty(x => x.Initials,  initials)
            .SetProperty(x => x.Group,     _group)
            .SetProperty(x => x.Github,    _github.Trim()));

        var state = await AuthStateTask;
        await App.PreloadAsync(state.User);
        Nav.NavigateTo("/student", replace: true);
    }
}

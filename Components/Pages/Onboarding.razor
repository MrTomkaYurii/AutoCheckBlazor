@page "/onboarding"
@layout LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NavigationManager Nav
@inject AppDbContext Db
@inject IAuthService Auth
@inject AppState App
@using Microsoft.EntityFrameworkCore

<div class="page">
    <div class="glass screen-anim card">

        <div class="logo-row">
            <div class="logo-badge">{}</div>
            <div class="logo-text">
                <div class="logo-name">AutoCheck</div>
                <div class="logo-sub">C# OOP Course</div>
            </div>
        </div>

        <div class="heading">
            <h2 class="heading-title">Майже готово 🎓</h2>
            <p class="heading-sub">
                Заповніть дані студента, щоб викладач бачив вас у журналі своєї групи.
            </p>
        </div>

        @if (_sessionStale)
        {
            <div class="stale-box">
                <div class="error-box">
                    Сесія застаріла — акаунт не знайдено (можливо, базу даних було скинуто). Увійдіть заново.
                </div>
                <form method="post" action="/account/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="cta-btn">
                        <Icon Name="logout" Size="17" />Увійти заново
                    </button>
                </form>
            </div>
        }
        else if (_student == null)
        {
            <div class="loading-row">
                <span class="spinner"></span>
                Завантаження…
            </div>
        }
        else
        {
            <div class="form-body">
                <div class="row2">
                    <div class="field"><label>Ім'я</label><input class="input" @bind="_firstName" placeholder="Петро" /></div>
                    <div class="field"><label>Прізвище</label><input class="input" @bind="_lastName" placeholder="Іваненко" /></div>
                </div>
                <div class="field">
                    <label>Група</label>
                    <select class="input group-select" @bind="_group">
                        <option value="" disabled>Оберіть групу…</option>
                        @foreach (var g in _groups)
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>GitHub репо <span class="field-hint">(можна додати пізніше у профілі)</span></label>
                    <input class="input mono" @bind="_github" placeholder="https://github.com/username/repo" />
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="error-box-sm">@_error</div>
                }

                <button @onclick="SaveAsync" disabled="@_saving" class="submit-btn" style="opacity:@(_saving ? "0.6" : "1")">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    @(_saving ? "Збереження…" : "Розпочати навчання")
                </button>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private StudentRecord? _student;
    private List<string> _groups = [];
    private string _firstName = "", _lastName = "", _group = "", _github = "", _error = "";
    private bool _saving, _sessionStale;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask;
        if (Auth.IsTeacher(state.User))
        {
            Nav.NavigateTo("/teacher", replace: true);
            return;
        }

        await Auth.EnsureLinkedAsync(state.User);
        _student = await Auth.GetStudentRecordAsync(state.User);
        if (_student == null)
        {
            // Auth cookie points to a user that no longer exists (e.g. DB was reset)
            _sessionStale = true;
            return;
        }

        // Already onboarded → straight to the dashboard
        if (!string.IsNullOrEmpty(_student.Group))
        {
            Nav.NavigateTo("/student", replace: true);
            return;
        }

        _firstName = _student.FirstName == "Новий"   ? "" : _student.FirstName;
        _lastName  = _student.LastName  == "Студент" ? "" : _student.LastName;
        _github    = _student.Github;
        _groups    = await Db.Groups.OrderBy(g => g.OrderIndex).ThenBy(g => g.Name)
                                    .Select(g => g.Name).ToListAsync();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))
        { _error = "Вкажіть ім'я та прізвище."; return; }
        if (string.IsNullOrEmpty(_group))
        { _error = "Оберіть групу."; return; }

        _saving = true; _error = ""; StateHasChanged();

        var initials = _firstName.Trim()[0].ToString() + _lastName.Trim()[0];
        await Db.Students.Where(s => s.Id == _student!.Id).ExecuteUpdateAsync(s => s
            .SetProperty(x => x.FirstName, _firstName.Trim())
            .SetProperty(x => x.LastName,  _lastName.Trim())
            .SetProperty(x => x.Initials,  initials)
            .SetProperty(x => x.Group,     _group)
            .SetProperty(x => x.Github,    _github.Trim()));

        var state = await AuthStateTask;
        await App.PreloadAsync(state.User);
        Nav.NavigateTo("/student", replace: true);
    }
}

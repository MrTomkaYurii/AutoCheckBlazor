@page "/teacher/journal"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "teacher")]
@inject IDialogService Dialog
@inject IDataService Data
@inject IJSRuntime JS

<TopBar Title="Журнал оцінок" Sub="Матриця оцінок по всіх лабах" />

<div class="screen-anim page">

    @* filter bar *@
    <section class="glass filter-bar">
        <div class="group-block">
            <Icon Name="users" Size="17" Style="color:var(--tx-3)" />
            <div class="group-tabs">
                @foreach (var g in _groups)
                {
                    var on = _group == g;
                    <button @onclick="@(() => _group = g)" class="group-tab" style="background:@(on ? "var(--acc-dim-2)" : "transparent");color:@(on ? "var(--acc-bright)" : "var(--tx-3)")">@g</button>
                }
            </div>
        </div>

        <div class="input-wrap search-wrap">
            <span class="lead"><Icon Name="search" Size="16" /></span>
            <input class="input search-input" placeholder="Пошук студента…" value="@_query" @oninput="@(e => _query = e.Value?.ToString() ?? "")" />
        </div>

        <div class="focus-block">
            <span class="focus-label">Фокус лаби:</span>
            <select class="select focus-select" value="@_focusLab" @onchange="@(e => _focusLab = int.Parse(e.Value?.ToString() ?? "0"))">
                <option value="0">Усі лаби</option>
                @foreach (var c in _labCols)
                {
                    <option value="@c.Id">@c.Short · @c.Title</option>
                }
            </select>
        </div>
    </section>

    @* matrix *@
    <section class="glass matrix-card">
        <div class="matrix-head">
            <Icon Name="grades" Size="18" Style="color:var(--acc)" />
            <h3 class="matrix-title">Журнал оцінок</h3>
            <span class="badge badge-grey"><span class="dot"></span>@Filtered.Count студентів</span>
            <button class="btn btn-ghost btn-sm pdf-btn" @onclick="GeneratePdfAsync" title="Сформувати PDF поточного журналу">
                <Icon Name="file-text" Size="15" />PDF
            </button>
            <div class="legend">
                <span class="legend-item"><span class="legend-dot legend-dot-done"></span>зараховано</span>
                <span class="legend-item"><span class="legend-dot legend-dot-review"><Icon Name="clock" Size="8" Stroke="2.4" /></span>на перевірці</span>
                <span class="legend-item"><span class="legend-dot legend-dot-rejected"></span>відхилено</span>
            </div>
        </div>

        <div class="matrix-scroll">
            <table style="min-width:@(NameW + AvgW + _labCols.Count * CellW)px">
                <thead>
                    <tr>
                        <th class="col-name">
                            <span class="th-label">Студент</span>
                        </th>
                        @foreach (var c in _labCols)
                        {
                            var focused = _focusLab == c.Id;
                            <th @onclick="@(() => _focusLab = focused ? 0 : c.Id)" title="@c.Title"
                                class="col-lab" style="background:@(focused ? "var(--acc-dim)" : "transparent")">
                                <span class="mono" style="font-size:11.5px;font-weight:700;color:@(focused ? "var(--acc-bright)" : "var(--tx-3)")">@c.Id.ToString("D2")</span>
                            </th>
                        }
                        <th class="col-avg">
                            <span class="th-label">Серед.</span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Filtered)
                    {
                        <tr class="jrow">
                            <td class="cell-name">
                                <div class="cell-name-inner">
                                    <div class="avatar">@s.Initials</div>
                                    <div style="min-width:0">
                                        <div class="student-name">@s.Last @FirstInitial(s.First)</div>
                                        <div class="student-group">@s.Group</div>
                                    </div>
                                </div>
                            </td>
                            @for (int ci = 0; ci < s.Labs.Count; ci++)
                            {
                                var idx = ci;
                                <td class="cell-lab" style="background:@(_focusLab == idx + 1 ? "rgba(118,199,173,0.05)" : "transparent")">
                                    <GradeCell Cell="s.Labs[idx]" Dim="@(_focusLab != 0 && _focusLab != idx + 1)" OnClick="@(() => OpenGrade(s.Id, idx + 1))" />
                                </td>
                            }
                            <td class="cell-avg">
                                <span class="mono tnum avg-value" style="color:@(s.Avg is null ? "var(--tx-faint)" : "var(--acc-bright)")">@(s.Avg?.ToString() ?? "—")</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Filtered.Count == 0)
        {
            <div class="empty-row">Нікого не знайдено за запитом «@_query»</div>
        }
    </section>
    <p class="footnote">
        <Icon Name="dot" Size="14" Fill="true" Style="color:var(--st-yellow)" />Натисніть на клітинку зі статусом «на перевірці», щоб виставити оцінку захисту.
    </p>
</div>

@code {
    private string _group = "Усі групи";
    private string _query = "";
    private int _focusLab = 0;

    private const int NameW = 230, AvgW = 74, CellW = 50;

    private string[] _groups = ["Усі групи"];
    private List<(int Id, string Short, string Title)> _labCols = [];
    private List<RosterStudent> _allStudents = [];

    protected override async Task OnInitializedAsync()
    {
        _groups      = await Data.GetTeacherGroupsAsync();
        _labCols     = await Data.GetLabColumnsAsync();
        _allStudents = await Data.GetRosterAsync();
    }

    private static string FirstInitial(string first) =>
        first.Length > 0 ? first[..1] + "." : "";

    private List<RosterStudent> Filtered => _allStudents.Where(s =>
        (_group == "Усі групи" || s.Group == _group) &&
        (_query == "" || (s.Last + " " + s.First).Contains(_query, StringComparison.OrdinalIgnoreCase))).ToList();

    private async Task GeneratePdfAsync()
    {
        var rows    = Filtered;
        var cols    = _labCols;

        var filters = new List<string>();
        if (_group != "Усі групи") filters.Add($"Група: {_group}");
        if (!string.IsNullOrEmpty(_query)) filters.Add($"Пошук: «{_query}»");
        if (_focusLab != 0)
        {
            var fl = cols.FirstOrDefault(c => c.Id == _focusLab);
            if (fl != default) filters.Add($"Фокус: Lab{fl.Id:D2} · {fl.Title}");
        }
        var filterLine = filters.Count > 0 ? string.Join(" · ", filters) : "усі студенти";

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"<h1>Журнал оцінок</h1>");
        sb.AppendLine($"<div class=\"sub\">{DateTime.Now:dd.MM.yyyy HH:mm} · {filterLine} · {rows.Count} студентів</div>");
        sb.AppendLine("<table><thead><tr>");
        sb.AppendLine("<th class=\"nc\">Студент</th>");
        foreach (var c in cols)
            sb.AppendLine($"<th title=\"{c.Title}\">L{c.Id:D2}</th>");
        sb.AppendLine("<th>Серед.</th>");
        sb.AppendLine("</tr></thead><tbody>");

        foreach (var s in rows)
        {
            sb.AppendLine("<tr>");
            sb.AppendLine($"<td class=\"nc\">{s.Last} {(s.First.Length > 0 ? s.First[0] + "." : "")} <span style=\"color:#888;font-size:9.5px\">{s.Group}</span></td>");
            foreach (var cell in s.Labs)
            {
                var (text, css) = cell.Kind switch
                {
                    "done"     => (cell.Final?.ToString() ?? cell.Auto?.ToString() ?? "✓", "d"),
                    "review"   => (cell.Auto?.ToString() ?? "…", "r"),
                    "rejected" => (cell.Auto?.ToString() ?? "×", "rej"),
                    _          => ("—", "lo"),
                };
                sb.AppendLine($"<td class=\"{css}\">{text}</td>");
            }
            sb.AppendLine($"<td class=\"av\">{s.Avg?.ToString() ?? "—"}</td>");
            sb.AppendLine("</tr>");
        }

        sb.AppendLine("</tbody></table>");
        sb.AppendLine("<div class=\"leg\">" +
            "<b>Легенда:</b> жирний = зараховано (фінальна оцінка) &nbsp;·&nbsp; " +
            "курсив = на перевірці (авто-оцінка) &nbsp;·&nbsp; " +
            "закреслений = відхилено &nbsp;·&nbsp; — = не здано" +
            "</div>");

        await JS.InvokeVoidAsync("printJournal", sb.ToString());
    }

    private async Task OpenGrade(int studentId, int labId)
    {
        var p = new DialogParameters { ["StudentId"] = studentId, ["LabId"] = labId };
        var opt = new DialogOptions { BackdropClick = true, NoHeader = true };
        var dlg = await Dialog.ShowAsync<AutoCheck.Components.Dialogs.GradeDialog>("", p, opt);
        var result = await dlg.Result;
        // reload so a just-entered grade/rejection shows in the matrix immediately
        if (result?.Canceled == false)
            _allStudents = await Data.GetRosterAsync();
        StateHasChanged();
    }
}

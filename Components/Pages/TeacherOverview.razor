@page "/teacher"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "teacher")]
@inject NavigationManager Nav
@inject IDialogService Dialog
@inject IDataService Data
@inject GeminiQuotaService Quota
@implements IDisposable

<TopBar Title="Огляд курсу" Sub="ООП на C# · Семестр 2">
    <button class="btn btn-outline btn-sm journal-btn" @onclick="@(() => Nav.NavigateTo("/teacher/journal"))">
        <Icon Name="grades" Size="15" />Відкрити журнал
    </button>
</TopBar>

<div class="screen-anim page">

    @* stat strip *@
    @{
        var _qRem   = Quota.Remaining;
        var _qLim   = Quota.DailyLimit;
        var _qUsed  = Quota.TodayCount;
        var _qPct   = _qLim > 0 ? (int)Math.Round(100.0 * _qUsed / _qLim) : 0;
        var _qTone  = _qRem == 0 ? "var(--st-red)" : _qRem <= 5 ? "var(--st-yellow)" : "var(--st-green)";
    }
    <div class="stat-strip">
        <TStat Icon="users"   Tone="var(--acc)"       Value="@Stats.Students.ToString()"      Label="Студентів на курсі"  Hint="2 групи" />
        <TStat Icon="upload"  Tone="var(--st-blue)"   Value="@Stats.Submissions.ToString()"   Label="Здач загалом" />
        <TStat Icon="target"  Tone="var(--st-green)"  Value="@($"{Stats.PassRate}%")"         Label="Успішність" />
        <TStat Icon="clock"   Tone="var(--st-yellow)" Value="@Stats.PendingReview.ToString()" Label="Очікують захисту"    Hint="нові" />
        <div class="glass lift quota-card">
            <div class="quota-glow" style="background:radial-gradient(circle,@(_qTone)1c,transparent 65%)"></div>
            <div class="quota-head">
                <span class="quota-icon" style="background:@(_qTone)1e;color:@_qTone;border:1px solid @(_qTone)33">
                    <Icon Name="spark" Size="19" />
                </span>
                <span class="badge quota-badge" style="color:@_qTone;background:@(_qTone)18;border:1px solid @(_qTone)44">
                    @(_qRem == 0 ? "вичерп." : $"{_qPct}%")
                </span>
            </div>
            <div class="mono tnum quota-value">
                @_qRem<span class="quota-value-suffix"> / @_qLim</span>
            </div>
            <div class="quota-label">Gemini сьогодні</div>
            <div class="quota-track">
                <div class="quota-fill" style="width:@_qPct%;background:@_qTone"></div>
            </div>
        </div>
    </div>

    <div class="columns">

        @* ── Черга на перевірку ──────────────────────────────────────────────── *@
        <section class="glass panel">
            <div class="panel-head">
                <Icon Name="clock" Size="18" Style="color:var(--st-yellow)" />
                <h3 class="panel-title">Черга на перевірку</h3>
                <span class="badge badge-yellow"><span class="dot pulse"></span>@Queue.Count</span>
                <div class="panel-sort-row">
                    <button @onclick='() => SetQueueSort("date")'
                            class="sort-chip @(_queueSort == "date" ? "active" : "")">За датою</button>
                    <button @onclick='() => SetQueueSort("group")'
                            class="sort-chip @(_queueSort == "group" ? "active" : "")">За групою</button>
                    <button class="btn btn-ghost btn-sm" @onclick="@(() => Nav.NavigateTo("/teacher/journal"))">
                        Журнал<Icon Name="arrowR" Size="15" />
                    </button>
                </div>
            </div>

            @if (Queue.Count == 0)
            {
                <div class="panel-empty">
                    Черга порожня — усі роботи перевірені 🎉
                </div>
            }
            else if (_queueSort == "group")
            {
                var byGroup = SortedQueue.GroupBy(r => r.Group).OrderBy(g => g.Key);
                @foreach (var grp in byGroup)
                {
                    <div class="group-head">
                        <span class="group-head-name">@grp.Key</span>
                        <span class="mono group-head-count">@grp.Count() робіт</span>
                    </div>
                    @foreach (var (q, last) in grp.Select((x, i) => (x, i == grp.Count() - 1)))
                    {
                        <div class="qrow" @onclick="@(() => OpenResults(q.StudentId, q.LabId))"
                             style="border-bottom:@(last ? "none" : "1px solid var(--line)")">
                            <div class="avatar">@q.Initials</div>
                            <div class="qrow-info">
                                <div class="qrow-name">@q.Name</div>
                                <div class="qrow-meta">
                                    <span>@q.Group</span><span class="qrow-meta-dot">·</span><span class="mono">@q.LabShort</span><span>@q.LabTitle</span>
                                </div>
                            </div>
                            <div class="qrow-score">
                                <div class="qrow-score-label">авто</div>
                                <span class="mono tnum qrow-score-value" style="color:@ScoreColor(q.Auto)">@q.Auto</span>
                            </div>
                            <span class="qrow-time">@q.When</span>
                            <button class="btn btn-ghost btn-sm qrow-action" title="Переглянути результати автоперевірки" @onclick:stopPropagation @onclick="@(() => OpenResults(q.StudentId, q.LabId))"><Icon Name="search" Size="14" />Результати</button>
                            <button class="btn btn-ghost btn-sm qrow-action" title="Структурна схожість коду з іншими студентами (лише для викладача)" @onclick:stopPropagation @onclick="@(() => OpenSimilarity(q))"><Icon Name="users" Size="14" />Схожість</button>
                            <button class="btn btn-outline btn-sm qrow-action" @onclick:stopPropagation @onclick="@(() => OpenGrade(q.StudentId, q.LabId))">Оцінити</button>
                        </div>
                    }
                }
            }
            else
            {
                @for (int i = 0; i < SortedQueue.Count; i++)
                {
                    var q    = SortedQueue[i];
                    var last = i == SortedQueue.Count - 1;
                    <div class="qrow" @onclick="@(() => OpenResults(q.StudentId, q.LabId))"
                         style="border-bottom:@(last ? "none" : "1px solid var(--line)")">
                        <div class="avatar">@q.Initials</div>
                        <div class="qrow-info">
                            <div class="qrow-name">@q.Name</div>
                            <div class="qrow-meta">
                                <span>@q.Group</span><span class="qrow-meta-dot">·</span><span class="mono">@q.LabShort</span><span>@q.LabTitle</span>
                            </div>
                        </div>
                        <div class="qrow-score">
                            <div class="qrow-score-label">авто</div>
                            <span class="mono tnum qrow-score-value" style="color:@ScoreColor(q.Auto)">@q.Auto</span>
                        </div>
                        <span class="qrow-time">@q.When</span>
                        <button class="btn btn-ghost btn-sm qrow-action" title="Переглянути результати автоперевірки" @onclick:stopPropagation @onclick="@(() => OpenResults(q.StudentId, q.LabId))"><Icon Name="search" Size="14" />Результати</button>
                        <button class="btn btn-ghost btn-sm qrow-action" title="Структурна схожість коду з іншими студентами (лише для викладача)" @onclick:stopPropagation @onclick="@(() => OpenSimilarity(q))"><Icon Name="users" Size="14" />Схожість</button>
                        <button class="btn btn-outline btn-sm qrow-action" @onclick:stopPropagation @onclick="@(() => OpenGrade(q.StudentId, q.LabId))">Оцінити</button>
                    </div>
                }
            }
        </section>

        @* ── Відхилені до захисту ────────────────────────────────────────────── *@
        <section class="glass panel">
            <div class="panel-head">
                <Icon Name="x" Size="18" Style="color:var(--st-red)" />
                <h3 class="panel-title">Відхилені до захисту</h3>
                <span class="badge badge-red"><span class="dot"></span>@Rejected.Count</span>
                <div class="panel-sort-row">
                    <button @onclick='() => SetRejSort("date")'
                            class="sort-chip @(_rejSort == "date" ? "active" : "")">За датою</button>
                    <button @onclick='() => SetRejSort("group")'
                            class="sort-chip @(_rejSort == "group" ? "active" : "")">За групою</button>
                </div>
            </div>

            @if (Rejected.Count == 0)
            {
                <div class="panel-empty">
                    Відхилених робіт немає 🎉
                </div>
            }
            else if (_rejSort == "group")
            {
                var byGroup = SortedRejected.GroupBy(r => r.Group).OrderBy(g => g.Key);
                @foreach (var grp in byGroup)
                {
                    <div class="group-head">
                        <span class="group-head-name">@grp.Key</span>
                        <span class="mono group-head-count">@grp.Count() робіт</span>
                    </div>
                    @foreach (var (q, last) in grp.Select((x, i) => (x, i == grp.Count() - 1)))
                    {
                        <div class="qrow" @onclick="@(() => OpenResults(q.StudentId, q.LabId))"
                             style="border-bottom:@(last ? "none" : "1px solid var(--line)")">
                            <div class="avatar-red">@q.Initials</div>
                            <div class="qrow-info">
                                <div class="qrow-name">@q.Name</div>
                                <div class="qrow-meta">
                                    <span>@q.Group</span><span class="qrow-meta-dot">·</span>
                                    <span class="mono">@q.LabShort</span><span>@q.LabTitle</span>
                                </div>
                            </div>
                            <div class="qrow-score">
                                <div class="qrow-score-label">найкраща спроба</div>
                                <span class="mono tnum qrow-score-value" style="color:var(--st-red)">@q.Auto</span>
                            </div>
                            <span class="qrow-time">@q.When</span>
                            <button class="btn btn-ghost btn-sm qrow-action" title="Переглянути результати автоперевірки" @onclick:stopPropagation @onclick="@(() => OpenResults(q.StudentId, q.LabId))"><Icon Name="search" Size="14" />Результати</button>
                        </div>
                    }
                }
            }
            else
            {
                @for (int i = 0; i < SortedRejected.Count; i++)
                {
                    var q    = SortedRejected[i];
                    var last = i == SortedRejected.Count - 1;
                    <div class="qrow" @onclick="@(() => OpenResults(q.StudentId, q.LabId))"
                         style="border-bottom:@(last ? "none" : "1px solid var(--line)")">
                        <div class="avatar-red">@q.Initials</div>
                        <div class="qrow-info">
                            <div class="qrow-name">@q.Name</div>
                            <div class="qrow-meta">
                                <span>@q.Group</span><span class="qrow-meta-dot">·</span>
                                <span class="mono">@q.LabShort</span><span>@q.LabTitle</span>
                            </div>
                        </div>
                        <div class="qrow-score">
                            <div class="qrow-score-label">найкраща спроба</div>
                            <span class="mono tnum qrow-score-value" style="color:var(--st-red)">@q.Auto</span>
                        </div>
                        <span class="qrow-time">@q.When</span>
                        <button class="btn btn-ghost btn-sm qrow-action" title="Переглянути результати автоперевірки" @onclick:stopPropagation @onclick="@(() => OpenResults(q.StudentId, q.LabId))"><Icon Name="search" Size="14" />Результати</button>
                    </div>
                }
            }
        </section>
    </div>
</div>


@code {
    private TeacherStats Stats = new();
    private List<ReviewItem> Queue    = [];
    private List<ReviewItem> Rejected = [];
    private PeriodicTimer? _timer;

    private string _queueSort = "date";
    private string _rejSort   = "date";

    private List<ReviewItem> SortedQueue => _queueSort == "group"
        ? Queue.OrderBy(r => r.Group).ThenByDescending(r => r.SubmittedAt).ToList()
        : Queue.OrderByDescending(r => r.SubmittedAt).ToList();

    private List<ReviewItem> SortedRejected => _rejSort == "group"
        ? Rejected.OrderBy(r => r.Group).ThenByDescending(r => r.SubmittedAt).ToList()
        : Rejected.OrderByDescending(r => r.SubmittedAt).ToList();

    private void SetQueueSort(string s) { _queueSort = s; StateHasChanged(); }
    private void SetRejSort(string s)   { _rejSort   = s; StateHasChanged(); }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(20));
        _ = PollAsync();
    }

    private async Task LoadData()
    {
        Stats    = await Data.GetStatsAsync();
        Queue    = await Data.GetReviewQueueAsync();
        Rejected = await Data.GetRejectedQueueAsync();
    }

    private async Task PollAsync()
    {
        while (_timer is not null && await _timer.WaitForNextTickAsync())
        {
            await LoadData();
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() { _timer?.Dispose(); _timer = null; }

    private static string ScoreColor(int auto) =>
        auto >= 85 ? "var(--st-green)" : auto >= 60 ? "var(--st-yellow)" : "var(--st-red)";

    private void OpenResults(int studentId, int labId) =>
        Nav.NavigateTo($"/teacher/results/{studentId}/{labId}");

    private async Task OpenGrade(int studentId, int labId)
    {
        var p = new DialogParameters { ["StudentId"] = studentId, ["LabId"] = labId };
        var opt = new DialogOptions { BackdropClick = true, NoHeader = true };
        var dlg = await Dialog.ShowAsync<AutoCheck.Components.Dialogs.GradeDialog>("", p, opt);
        await dlg.Result;
        await LoadData();
        StateHasChanged();
    }

    // Teacher-only structural code-similarity report (students never see this).
    private async Task OpenSimilarity(ReviewItem q)
    {
        var p = new DialogParameters
        {
            ["StudentId"]   = q.StudentId,
            ["LabNumber"]   = q.LabId,
            ["StudentName"] = q.Name,
            ["LabTitle"]    = q.LabTitle,
        };
        var opt = new DialogOptions
        {
            BackdropClick = true, NoHeader = true,
            MaxWidth = MaxWidth.Large, FullWidth = true,
        };
        await Dialog.ShowAsync<AutoCheck.Components.Dialogs.SimilarityDialog>("", p, opt);
    }
}

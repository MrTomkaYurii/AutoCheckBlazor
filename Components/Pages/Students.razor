@page "/teacher/students"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "teacher")]
@inject NavigationManager Nav
@inject IDataService Data
@inject IDialogService Dialog
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<AppUser> UserManager
@inject IJSRuntime JS

<TopBar Title="Студенти" Sub="Прогрес та управління студентами курсу">
    <button class="btn btn-primary btn-sm" @onclick="AddStudent"><Icon Name="profile" Size="15" />Додати студента</button>
</TopBar>

<div class="screen-anim page">

    <section class="glass filter-bar">
        <Icon Name="users" Size="18" Style="color:var(--tx-3)" />
        <div class="group-tabs">
            @foreach (var g in _groups)
            {
                var on = _group == g;
                <button @onclick="@(() => _group = g)" class="group-tab" style="background:@(on ? "var(--acc-dim-2)" : "transparent");color:@(on ? "var(--acc-bright)" : "var(--tx-3)")">@g</button>
            }
        </div>
        <div class="input-wrap search-wrap">
            <span class="lead"><Icon Name="search" Size="16" /></span>
            <input class="input search-input" placeholder="Пошук…" @bind="_query" @bind:event="oninput" />
        </div>
        <span class="badge badge-grey count-badge"><span class="dot"></span>@Filtered.Count студентів</span>
    </section>

    <div class="cards-grid">
        @{ int i = 0; }
        @foreach (var s in Filtered)
        {
            var idx = i++;
            var pct = Total > 0 ? (int)Math.Round(100.0 * s.DoneCount / Total) : 0;
            <article class="glass lift card" style="animation-delay:@(idx * 0.03)s">
                <div class="card-head">
                    <div class="avatar">@s.Initials</div>
                    <div class="card-info">
                        <div class="card-name">@s.Last @s.First</div>
                        <div class="card-group">@s.Group</div>
                    </div>
                    <div class="avg-block">
                        <div class="mono tnum avg-value" style="color:@(s.Avg is null ? "var(--tx-faint)" : "var(--acc-bright)")">@(s.Avg?.ToString() ?? "—")</div>
                        <div class="avg-label">серед.</div>
                    </div>
                </div>

                <div class="progress-summary">
                    <span class="progress-summary-text"><b class="progress-summary-strong">@s.DoneCount</b> / @Total зараховано</span>
                    @if (s.ReviewCount > 0)
                    {
                        <span class="review-hint"><Icon Name="clock" Size="12" />@s.ReviewCount ⏳</span>
                    }
                </div>
                <Progress Value="pct" />

                <div class="lab-dots">
                    @foreach (var c in s.Labs)
                    {
                        var color = c.Kind == "done" ? "var(--st-green)" : c.Kind == "review" ? "var(--st-yellow)" : c.Kind == "rejected" ? "var(--st-red)" : "rgba(255,255,255,0.08)";
                        <span class="lab-dot" style="background:@color"></span>
                    }
                </div>

                <div class="card-actions">
                    <button class="btn btn-ghost btn-block btn-sm" @onclick="@(() => Nav.NavigateTo("/teacher/journal"))"><Icon Name="grades" Size="14" />Журнал</button>
                    <button class="btn btn-ghost btn-sm" title="Скинути пароль" @onclick="@(() => ResetPassword(s.Id))"><Icon Name="lock" Size="14" /></button>
                    <button class="btn btn-ghost btn-sm" @onclick="@(() => EditStudent(s.Id))"><Icon Name="settings" Size="14" /></button>
                    <button class="btn btn-ghost btn-sm delete-btn" @onclick="@(() => DeleteStudent(s.Id))"><Icon Name="x" Size="14" /></button>
                </div>
            </article>
        }
    </div>
</div>

@* password-reset result overlay *@
@if (_resetOpen)
{
    <div @onclick="@(() => _resetOpen = false)" class="overlay">
        <div @onclick:stopPropagation class="glass overlay-card">
            <div class="overlay-head">
                <Icon Name="lock" Size="18" Style="color:var(--acc)" />
                <h3 class="overlay-title">Скидання пароля</h3>
            </div>
            @if (_resetError != "")
            {
                <div class="overlay-error">@_resetError</div>
            }
            else
            {
                <p class="overlay-text">
                    Пароль для <b class="overlay-name">@_resetName</b> скинуто. Передайте студенту тимчасовий пароль — він зможе змінити його у профілі:
                </p>
                <div class="password-box">
                    <code class="mono password-value">@_resetPassword</code>
                </div>
            }
            <div class="overlay-actions">
                <button class="btn btn-primary btn-sm" @onclick="@(() => _resetOpen = false)">Готово</button>
            </div>
        </div>
    </div>
}

@code {
    private string _group = "Усі групи", _query = "";
    private string[] _groups = ["Усі групи"];
    private List<RosterStudent> _allStudents = [];
    private int _totalLabs;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _groups      = await Data.GetTeacherGroupsAsync();
        _allStudents = await Data.GetRosterAsync();
        _totalLabs   = (await Data.GetLabColumnsAsync()).Count;
    }

    private int Total => _totalLabs;
    private List<RosterStudent> Filtered => _allStudents.Where(s =>
        (_group == "Усі групи" || s.Group == _group) &&
        (_query == "" || (s.Last + " " + s.First).Contains(_query, StringComparison.OrdinalIgnoreCase))).ToList();

    private async Task AddStudent()
    {
        var dlg = await Dialog.ShowAsync<StudentDialog>("", new DialogOptions { BackdropClick = true, NoHeader = true });
        if ((await dlg.Result)?.Data is true) await Reload();
    }

    private async Task EditStudent(int id)
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var rec = await Db.Students.FindAsync(id);
        if (rec is null) return;
        var p = new DialogParameters { ["Existing"] = rec };
        var dlg = await Dialog.ShowAsync<StudentDialog>("", p, new DialogOptions { BackdropClick = true, NoHeader = true });
        if ((await dlg.Result)?.Data is true) await Reload();
    }

    private async Task DeleteStudent(int id)
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var rec = await Db.Students.FindAsync(id);
        if (rec is null) return;

        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Видалити студента {rec.LastName} {rec.FirstName}? " +
            "Усі його здачі, оцінки та акаунт для входу буде видалено безповоротно.");
        if (!ok) return;

        // Also remove the login account and link — otherwise the orphaned account
        // still signs in and dead-ends on the onboarding screen
        var link = await Db.UserLinks.FirstOrDefaultAsync(l => l.StudentId == id);
        if (link is not null)
        {
            var user = await UserManager.FindByIdAsync(link.UserId);
            if (user is not null) await UserManager.DeleteAsync(user);
            Db.UserLinks.Remove(link);
        }

        Db.Students.Remove(rec);
        await Db.SaveChangesAsync();
        await Reload();
    }

    // ── Password reset ────────────────────────────────────────────────────────
    private bool _resetOpen;
    private string _resetName = "", _resetPassword = "", _resetError = "";

    private async Task ResetPassword(int studentId)
    {
        _resetName = _resetPassword = _resetError = "";

        await using var Db = await DbFactory.CreateDbContextAsync();
        var rec  = await Db.Students.FindAsync(studentId);
        var link = await Db.UserLinks.AsNoTracking().FirstOrDefaultAsync(l => l.StudentId == studentId);
        var user = link is null ? null : await UserManager.FindByIdAsync(link.UserId);

        if (rec is null || user is null)
        {
            _resetError = "Студент ще не має акаунта в системі (не реєструвався). Скидати нічого.";
            _resetOpen = true;
            return;
        }

        // 10 lowercase+digits chars — easy to dictate, satisfies the min-length policy
        var temp = "st-" + Guid.NewGuid().ToString("N")[..8];

        if (await UserManager.HasPasswordAsync(user))
            await UserManager.RemovePasswordAsync(user);
        var result = await UserManager.AddPasswordAsync(user, temp);

        if (!result.Succeeded)
        {
            _resetError = string.Join(" ", result.Errors.Select(e => e.Description));
        }
        else
        {
            _resetName = $"{rec.LastName} {rec.FirstName} ({user.Email})";
            _resetPassword = temp;
        }
        _resetOpen = true;
    }
}

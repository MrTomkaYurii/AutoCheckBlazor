@page "/teacher/results/{StudentId:int}/{LabId:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "teacher")]
@inject NavigationManager Nav
@inject IDataService Data
@inject IDialogService Dialog
@inject AppState App
@inject IDbContextFactory<AppDbContext> DbFactory
@inject INotificationService Notif

<TopBar Title="@($"Lab{LabId:D2} · Результати автоперевірки")"
        Crumbs="@(new[] { "Огляд", $"Lab{LabId:D2}" })" />

<div class="screen-anim page">

    @* header: student + score + actions *@
    <section class="glass header-bar">
        <div class="avatar">@_initials</div>
        <div class="header-info">
            <h2 class="student-name">@_name</h2>
            <div class="header-meta">
                <span class="badge badge-grey header-meta-badge"><span class="dot"></span>@_group</span>
                <span class="mono">Lab@(LabId.ToString("D2"))</span>
                <span>· @LabInfo.Title</span>
                <span class="header-meta-sep">·</span>
                <span>Спроб використано: @LabInfo.AttemptsUsed з @LabInfo.AttemptsMax</span>
            </div>
        </div>
        <div class="score-block">
            <div class="score-label">Авто-оцінка</div>
            <div class="mono tnum score-value" style="color:@(LabInfo.Auto >= 85 ? "var(--st-green)" : LabInfo.Auto >= 60 ? "var(--st-yellow)" : "var(--st-red)")">@LabInfo.Auto<span class="score-suffix">/100</span></div>
        </div>
        <div class="header-actions">
            <button class="btn btn-ghost btn-sm" @onclick="@(() => Nav.NavigateTo("/teacher"))"><Icon Name="arrowR" Size="15" Style="transform:rotate(180deg)" />Назад</button>
            <button class="btn btn-primary btn-sm" @onclick="OpenGrade"><Icon Name="check" Size="15" />Оцінити</button>
        </div>
    </section>

    @* plagiarism flag *@
    @if (LabInfo.PlagFlag)
    {
        <section class="glass plag-box">
            <span class="plag-icon">
                <Icon Name="warn" Size="18" Stroke="2.2" />
            </span>
            <div class="plag-text">
                <div class="plag-title">Виявлено плагіат — здачу відхилено автоматично</div>
                <div class="plag-note">@LabInfo.PlagNote</div>
            </div>
            @if (LabInfo.PlagApproved)
            {
                <span class="badge badge-yellow plag-approved-badge"><span class="dot"></span>дозволено повторну здачу</span>
            }
            else
            {
                <button class="btn btn-outline btn-sm plag-approve-btn" @onclick="ApprovePlagiarism" disabled="@_approving">
                    <Icon Name="check" Size="14" />@(_approving ? "Збереження…" : "Дозволити здачу попри збіг")
                </button>
            }
        </section>
    }

    @* attempt switcher *@
    @if (LabInfo.Attempts.Count > 1)
    {
        <div class="attempt-switcher">
            <span class="attempt-switcher-label">Результати спроби</span>
            @foreach (var a in LabInfo.Attempts)
            {
                var on = a.No == LabInfo.SelectedAttempt;
                <button @onclick="@(() => SelectAttempt(a.No))" class="attempt-chip"
                        style="border:1px solid @(on ? "var(--glass-border-hover)" : "var(--line)");background:@(on ? "var(--acc-dim)" : "rgba(255,255,255,0.025)");color:@(on ? "var(--acc-bright)" : "var(--tx-3)")">
                    Спроба @a.No
                    <span class="mono tnum" style="font-size:12.5px;font-weight:750;color:@(a.Score is null ? "var(--tx-faint)" : on ? "var(--acc-bright)" : "var(--tx-2)")">@(a.Score?.ToString() ?? "—")</span>
                    @if (a.IsBest)
                    {
                        <span title="Найкраща спроба — зарахована як авто-оцінка" class="attempt-trophy"><Icon Name="trophy" Size="12" /></span>
                    }
                </button>
            }
        </div>
    }

    @* master / detail *@
    <div class="split">

        @* LEFT — task list *@
        <div class="task-list">
            <div class="task-list-head">
                <span class="task-list-title">Завдання</span>
                <span class="mono task-list-count">@LabInfo.Tasks.Count</span>
            </div>
            @foreach (var t in LabInfo.Tasks)
            {
                var v = t.View();
                var on = t.Id == _activeId;
                <button @onclick="@(() => { _activeId = t.Id; _diffOpen = false; })" class="tasktab glass"
                        style="border-color:@(on ? v.Tone : "var(--glass-border)");background:@(on ? $"linear-gradient(180deg, {v.Tone}14, var(--glass-bg))" : "var(--glass-bg)")">
                    @if (on)
                    {
                        <span class="tasktab-active-mark" style="background:@v.Tone;box-shadow:0 0 10px @v.Tone"></span>
                    }
                    <div class="tasktab-head">
                        <span class="tasktab-icon" style="background:@(v.Tone)22;color:@v.Tone;border:1px solid @(v.Tone)44"><Icon Name="@v.Icon" Size="14" Stroke="2.2" /></span>
                        <span class="mono tasktab-n">task@(t.N)</span>
                        <span class="mono tnum tasktab-score" style="color:@v.Tone">@t.Score</span>
                    </div>
                    <div class="tasktab-title">@t.Title</div>
                    <Progress Value="t.Score" Tone="@(t.State == "pass" ? "" : t.ColorClass)" />
                </button>
            }
        </div>

        @* RIGHT — feedback / analysis / diff (read-only) *@
        <div @key="_activeId" class="screen-anim detail-panel">
            @{
                var task = LabInfo.Tasks.FirstOrDefault(x => x.Id == _activeId)
                        ?? LabInfo.Tasks.FirstOrDefault();
            }
            @if (task is null)
            {
                <div class="glass empty-tasks">Результатів для цієї спроби немає</div>
            }
            else
            {
            var tv = task.View();

            <section class="glass task-header-card">
                <div class="task-header-row">
                    <div class="task-header-left">
                        <span class="task-icon" style="background:@(tv.Tone)22;color:@tv.Tone;border:1px solid @(tv.Tone)44"><Icon Name="@tv.Icon" Size="18" Stroke="2.2" /></span>
                        <div>
                            <div class="task-badge-row">
                                <span class="mono task-n">task@(task.N)</span>
                                <span class="badge badge-@task.ColorClass task-status-badge"><span class="dot"></span>@tv.Label</span>
                            </div>
                            <h3 class="task-title">@task.Title</h3>
                        </div>
                    </div>
                    <ScorePill Value="task.Score" Size="lg" />
                </div>
                <div class="md task-brief"><MarkdownText Text="@task.Brief" /></div>
            </section>

            var (fbDone, fbIssues, fbAnalysis) = ParseFeedback(task.Feedback);
            <section class="glass feedback-card" style="border-color:@(tv.Tone)33">
                <div class="feedback-head">
                    <div class="feedback-head-left">
                        <Icon Name="spark" Size="17" Style="@($"color:{tv.Tone}")" />
                        <h4 class="feedback-title">Фідбек перевірки</h4>
                    </div>
                    @if (fbDone.Length + fbIssues.Length > 0)
                    {
                        <span class="feedback-summary">
                            <span class="feedback-done-count">@fbDone.Length виконано</span>
                            @if (fbIssues.Length > 0) { <span> · <span class="feedback-issue-count">@fbIssues.Length з помилкою</span></span> }
                            <span> · оцінка: <b style="color:@tv.Tone">@task.Score</b></span>
                        </span>
                    }
                </div>
                @if (fbDone.Length > 0 || fbIssues.Length > 0)
                {
                    @if (fbDone.Length > 0)
                    {
                        <div class="feedback-list @(fbIssues.Length > 0 ? "feedback-list-divider" : "")">
                            @foreach (var d in fbDone)
                            {
                                <div class="feedback-item">
                                    <span class="feedback-check">✓</span>
                                    <span class="feedback-item-text">@d</span>
                                </div>
                            }
                        </div>
                    }
                    @if (fbIssues.Length > 0)
                    {
                        <div class="feedback-list">
                            @foreach (var issue in fbIssues)
                            {
                                <div class="feedback-item">
                                    <span class="feedback-cross">✗</span>
                                    <span class="feedback-item-text">@issue</span>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="feedback-analysis">@fbAnalysis</p>
                }
            </section>

            <section class="glass analysis-card">
                <div class="analysis-head">
                    <Icon Name="doc" Size="16" Style="color:var(--acc)" />
                    <h4 class="analysis-title">Аналіз виконаного завдання</h4>
                </div>
                <div class="analysis-body">
                    @if (!string.IsNullOrEmpty(fbAnalysis))
                    {
                        <p class="feedback-analysis">@fbAnalysis</p>
                    }
                    else
                    {
                        <p class="analysis-empty">Аналіз недоступний.</p>
                    }
                </div>
            </section>

            @if (task.Diff.Any(d => d.Type is "add" or "del"))
            {
                var adds = task.Diff.Count(d => d.Type == "add");
                var dels = task.Diff.Count(d => d.Type == "del");
                <section class="glass diff-card">
                    <button @onclick="@(() => _diffOpen = !_diffOpen)" class="diff-toggle">
                        <Icon Name="braces" Size="16" Style="color:var(--acc)" />
                        <span class="diff-toggle-title">Diff коміту</span>
                        <span class="mono diff-adds">+@adds</span>
                        <span class="mono diff-dels">-@dels</span>
                        <span class="diff-toggle-hint">@(_diffOpen ? "сховати ↑" : "показати ↓")</span>
                    </button>
                    @if (_diffOpen)
                    {
                        <div class="diff-body">
                            <table class="diff-table">
                                @foreach (var dl in task.Diff)
                                {
                                    string bg, fg, pfx, lnStr;
                                    if (dl.Type == "add")
                                    { bg = "rgba(118,199,173,0.10)"; fg = "var(--st-green)"; pfx = "+"; lnStr = dl.N2?.ToString() ?? ""; }
                                    else if (dl.Type == "del")
                                    { bg = "rgba(232,128,107,0.10)"; fg = "var(--st-red)"; pfx = "-"; lnStr = dl.N1?.ToString() ?? ""; }
                                    else if (dl.Type == "hdr")
                                    { bg = "rgba(255,255,255,0.035)"; fg = "var(--tx-3)"; pfx = ""; lnStr = ""; }
                                    else
                                    { bg = "transparent"; fg = "var(--tx-2)"; pfx = " "; lnStr = (dl.N2 ?? dl.N1)?.ToString() ?? ""; }
                                    <tr style="background:@bg">
                                        <td class="diff-ln">@lnStr</td>
                                        <td class="diff-pfx" style="color:@(dl.Type is "add" or "del" ? fg : "var(--tx-faint)")">@pfx</td>
                                        <td class="diff-text" style="color:@fg">@dl.Text</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    }
                </section>
            }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int StudentId { get; set; }
    [Parameter] public int LabId { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private LabDetail LabInfo = new();
    private string _activeId = "task1";
    private string _name = "", _initials = "", _group = "";
    private bool _diffOpen;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask;
        if (!App.IsTeacher(state.User))
        {
            Nav.NavigateTo("/student", replace: true);
            return;
        }

        await using var Db = await DbFactory.CreateDbContextAsync();
        var student = await Db.Students.FindAsync(StudentId);
        if (student is not null)
        {
            _name     = student.LastName + " " + student.FirstName;
            _initials = student.Initials;
            _group    = student.Group;
        }
        await LoadDetailAsync(null);
    }

    private async Task LoadDetailAsync(int? attemptNo)
    {
        // Teacher sees the best attempt by default — that's where AutoScore came from
        var detail = await Data.GetLabDetailAsync(LabId, StudentId, attemptNo);
        if (detail is null)
        {
            // лабу вимкнено з курсу (або немає) — повертаємо в журнал
            Nav.NavigateTo("/teacher/journal", replace: true);
            return;
        }

        if (attemptNo is null && detail.Attempts.Count > 0)
        {
            var best = detail.Attempts.First(a => a.IsBest).No;
            if (best != detail.SelectedAttempt)
                detail = await Data.GetLabDetailAsync(LabId, StudentId, best) ?? detail;
        }

        LabInfo = detail;
        if (LabInfo.Tasks.All(t => t.Id != _activeId))
            _activeId = "task" + (LabInfo.Tasks.FirstOrDefault()?.N ?? 1);
    }

    private async Task SelectAttempt(int no)
    {
        await LoadDetailAsync(no);
        _diffOpen = false;
    }

    private bool _approving;

    // Teacher override: return the burned attempt and let the student resubmit —
    // the next grading run skips the plagiarism gate for this submission.
    private async Task ApprovePlagiarism()
    {
        _approving = true; StateHasChanged();

        await using var Db = await DbFactory.CreateDbContextAsync();
        var sub = await Db.Submissions
            .Include(s => s.LabDef)
            .FirstOrDefaultAsync(s => s.StudentId == StudentId && s.LabDef.Number == LabId);
        if (sub != null && sub.PlagiarismFlag && !sub.PlagiarismApproved)
        {
            sub.PlagiarismApproved = true;
            sub.AttemptsUsed = Math.Max(0, sub.AttemptsUsed - 1);   // refund the attempt

            Db.GradeAudits.Add(new GradeAudit
            {
                SubmissionId = sub.Id,
                Actor  = $"{App.Teacher.LastName} {App.Teacher.FirstName}".Trim(),
                Action = "plagiarism-approve",
                OldValue = sub.PlagiarismNote,
                NewValue = "дозволено повторну здачу, спробу повернено",
            });
            await Db.SaveChangesAsync();

            await Notif.SendAsync(StudentId,
                $"Lab{LabId:D2}: дозволено повторну здачу",
                "Викладач розглянув збіг коду і дозволив здати роботу ще раз. Спробу повернено.",
                "info");

            await LoadDetailAsync(LabInfo.SelectedAttempt == 0 ? null : LabInfo.SelectedAttempt);
        }
        _approving = false; StateHasChanged();
    }

    private async Task OpenGrade()
    {
        var p = new DialogParameters { ["StudentId"] = StudentId, ["LabId"] = LabId };
        var opt = new DialogOptions { BackdropClick = true, NoHeader = true };
        var dlg = await Dialog.ShowAsync<AutoCheck.Components.Dialogs.GradeDialog>("", p, opt);
        var result = await dlg.Result;
        if (result?.Canceled == false)
            Nav.NavigateTo("/teacher");
    }

    private static (string[] Done, string[] Issues, string Analysis) ParseFeedback(string? raw) =>
        FeedbackJson.Parse(raw);
}

@page "/reset"
@layout LoginLayout

<div class="page">
    <div class="glass screen-anim card">

        <div class="logo-row">
            <div class="logo-badge">{}</div>
            <div class="logo-text">
                <div class="logo-name">AutoCheck</div>
                <div class="logo-sub">C# OOP Course</div>
            </div>
        </div>

        <div class="heading">
            <h2 class="heading-title">Новий пароль</h2>
            <p class="heading-sub">@(string.IsNullOrEmpty(Email) ? "" : Email)</p>
        </div>

        @if (string.IsNullOrEmpty(Token) || string.IsNullOrEmpty(Email))
        {
            <div class="error-box">
                Посилання недійсне або неповне. Запросіть новий лист.
            </div>
            <div class="footer-row">
                <a href="/forgot" class="footer-link">← Запросити посилання</a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="error-box">@Error</div>
            }

            <form method="post" action="/account/reset">
                <input type="hidden" name="email" value="@Email" />
                <input type="hidden" name="token" value="@Token" />
                <div class="row2">
                    <div class="field">
                        <label>Пароль</label>
                        <input class="input" type="password" name="password"
                               placeholder="мін. 6 символів" required minlength="6" autocomplete="new-password" />
                    </div>
                    <div class="field">
                        <label>Підтвердження</label>
                        <input class="input" type="password" name="confirm"
                               placeholder="ще раз" required minlength="6" autocomplete="new-password" />
                    </div>
                </div>
                <button type="submit" class="submit-btn">Змінити пароль</button>
            </form>

            <div class="footer-row">
                <a href="/" class="footer-link">← До входу</a>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
}

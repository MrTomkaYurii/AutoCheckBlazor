@page "/student/lab/{Id:int}"
@namespace AutoCheck.Components.Pages.LabPage
@inject NavigationManager Nav
@inject IDataService Data
@inject IGradingService Grader
@inject IDialogService Dialog
@inject AppState App
@inject AppDbContext Db
@inject GitHubService GitHub

<TopBar Title="@($"Lab{LabInfo.Id:D2} · {LabInfo.Title}")" Crumbs="@(new[] { "Мої лаби", $"Lab{LabInfo.Id:D2}" })" />

<div class="screen-anim" style="padding:0 34px 40px;position:relative;z-index:1">

    @* lab header bar *@
    <section class="glass" style="padding:20px 24px;margin-bottom:18px;display:flex;align-items:center;gap:20px">
        <div style="display:flex;align-items:center;gap:14px;flex:1 1 auto;min-width:0">
            <span class="mono" style="font-size:17px;font-weight:750;color:var(--acc-bright);background:var(--acc-dim);padding:8px 12px;border-radius:11px;border:1px solid var(--glass-border)">@LabInfo.Id.ToString("D2")</span>
            <div style="min-width:0">
                <div style="display:flex;align-items:center;gap:10px">
                    <h2 style="margin:0;font-size:20px;font-weight:740;letter-spacing:-0.02em">@LabInfo.Title</h2>
                    <Badge Status="LabInfo.Auto > 0 ? LabStatus.Review : LabStatus.Locked" />
                </div>
                <div style="display:flex;gap:16px;margin-top:6px;font-size:12.5px;color:var(--tx-3);flex-wrap:wrap">
                    @if (LabInfo.DeadlineAt.HasValue)
                    {
                        var dl = LabInfo.DeadlineAt.Value.ToLocalTime();
                        var dlColor = LabInfo.IsOverdue ? "var(--st-red)" : (dl - DateTime.Now).TotalHours <= 24 ? "var(--st-yellow)" : "inherit";
                        <span style="display:flex;align-items:center;gap:6px;color:@dlColor">
                            <Icon Name="calendar" Size="14" />
                            @(LabInfo.IsOverdue ? "Дедлайн минув · " : "Здати до ")@dl.ToString("dd.MM.yyyy HH:mm")
                        </span>
                    }
                    <span style="display:flex;align-items:center;gap:6px"><Icon Name="refresh" Size="14" />Спроба @LabInfo.AttemptsUsed з @LabInfo.AttemptsMax</span>
                    @if (!string.IsNullOrEmpty(App.Student.Github))
                    {
                        <span style="display:flex;align-items:center;gap:6px"><Icon Name="github" Size="14" />@App.Student.Github</span>
                    }
                </div>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:18px;flex:none">
            <div style="text-align:right">
                <div style="font-size:11px;color:var(--tx-3);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:4px">Авто-оцінка</div>
                <div class="mono tnum" style="font-size:30px;font-weight:780;line-height:1;color:var(--st-yellow)">@LabInfo.Auto<span style="font-size:15px;opacity:0.5">/100</span></div>
            </div>
            <div style="display:flex;gap:8px">
                <button class="btn btn-ghost btn-sm" @onclick="OpenComments"><Icon Name="spark" Size="15" />Коментарі</button>
                @if (LabInfo.IsOverdue)
                {
                    <button class="btn btn-ghost btn-sm" disabled style="opacity:0.45;color:var(--st-red)"><Icon Name="lock" Size="15" />Дедлайн минув</button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="OpenResubmit"><Icon Name="refresh" Size="17" />Здати</button>
                }
            </div>
        </div>
    </section>

    @* master / detail *@
    <div style="display:grid;grid-template-columns:340px 1fr;gap:18px;align-items:start">

        @* LEFT — task list *@
        <div style="display:flex;flex-direction:column;gap:12px;position:sticky;top:90px">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:0 4px">
                <span style="font-size:12.5px;font-weight:700;color:var(--tx-2);text-transform:uppercase;letter-spacing:0.05em">Завдання</span>
                <span class="mono" style="font-size:12px;color:var(--tx-3)">@LabInfo.Tasks.Count</span>
            </div>
            @foreach (var t in LabInfo.Tasks)
            {
                var v = t.View();
                var on = t.Id == _activeId;
                <button @onclick="@(() => SelectTask(t.Id))" class="tasktab glass"
                        style="text-align:left;padding:14px 15px;cursor:pointer;border:1px solid;border-color:@(on ? v.Tone : "var(--glass-border)");background:@(on ? $"linear-gradient(180deg, {v.Tone}14, var(--glass-bg))" : "var(--glass-bg)");transition:all .18s;position:relative;display:block;width:100%">
                    @if (on)
                    {
                        <span style="position:absolute;left:0;top:14px;bottom:14px;width:3px;border-radius:3px;background:@v.Tone;box-shadow:0 0 10px @v.Tone"></span>
                    }
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:7px">
                        <span style="width:24px;height:24px;border-radius:7px;flex:none;display:grid;place-items:center;background:@(v.Tone)22;color:@v.Tone;border:1px solid @(v.Tone)44"><Icon Name="@v.Icon" Size="14" Stroke="2.2" /></span>
                        <span class="mono" style="font-size:12px;color:var(--tx-3);font-weight:600">task@(t.N)</span>
                        <span class="mono tnum" style="margin-left:auto;font-size:13px;font-weight:700;color:@v.Tone">@t.Score</span>
                    </div>
                    <div style="font-size:14px;font-weight:640;letter-spacing:-0.01em;margin-bottom:8px;color:var(--tx-1)">@t.Title</div>
                    <Progress Value="t.Score" Tone="@(t.State == "pass" ? "" : t.ColorClass)" />
                </button>
            }

        </div>

        @* RIGHT — results *@
        <div @key="_activeId" class="screen-anim" style="display:flex;flex-direction:column;gap:16px;min-width:0">
            @{
                var task = LabInfo.Tasks.FirstOrDefault(x => x.Id == _activeId)
                        ?? LabInfo.Tasks.FirstOrDefault();
            }
            @if (task is null)
            {
                <div class="glass" style="padding:40px;text-align:center;color:var(--tx-3)">Завдань поки немає</div>
            }
            else
            {
            var tv = task.View();

            <section class="glass" style="padding:22px 24px">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;flex-wrap:wrap;gap:12px">
                    <div style="display:flex;align-items:center;gap:12px">
                        <span style="width:32px;height:32px;border-radius:9px;display:grid;place-items:center;background:@(tv.Tone)22;color:@tv.Tone;border:1px solid @(tv.Tone)44"><Icon Name="@tv.Icon" Size="18" Stroke="2.2" /></span>
                        <div>
                            <div style="display:flex;align-items:center;gap:9px">
                                <span class="mono" style="font-size:12.5px;color:var(--tx-3)">task@(task.N)</span>
                                <span class="badge badge-@task.ColorClass" style="height:22px"><span class="dot"></span>@tv.Label</span>
                            </div>
                            <h3 style="margin:4px 0 0;font-size:18px;font-weight:720;letter-spacing:-0.02em">@task.Title</h3>
                        </div>
                    </div>
                    <ScorePill Value="task.Score" Size="lg" />
                </div>
                <div class="md" style="font-size:13.5px;line-height:1.7;color:var(--tx-2)"><MarkdownText Text="@task.Brief" /></div>
            </section>

            var (fbDone, fbIssues, fbAnalysis) = ParseFeedback(task.Feedback);
            <section class="glass" style="padding:20px 24px;border-color:@(tv.Tone)33">
                <div style="display:flex;align-items:center;gap:9px;margin-bottom:14px">
                    <Icon Name="spark" Size="17" Style="@($"color:{tv.Tone}")" />
                    <h4 style="margin:0;font-size:14px;font-weight:700;letter-spacing:-0.01em">Фідбек перевірки</h4>
                </div>
                @if (fbDone.Length > 0 || fbIssues.Length > 0)
                {
                    @if (fbDone.Length > 0)
                    {
                        <div style="display:flex;flex-direction:column;gap:6px;@(fbIssues.Length > 0 ? "margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--line)" : "")">
                            @foreach (var d in fbDone)
                            {
                                <div style="display:flex;gap:10px;align-items:flex-start">
                                    <span style="color:var(--st-green);flex:none;font-size:15px;line-height:1.4">✓</span>
                                    <span style="font-size:13.5px;line-height:1.6;color:var(--tx-1)">@d</span>
                                </div>
                            }
                        </div>
                    }
                    @if (fbIssues.Length > 0)
                    {
                        <div style="display:flex;flex-direction:column;gap:6px">
                            @foreach (var issue in fbIssues)
                            {
                                <div style="display:flex;gap:10px;align-items:flex-start">
                                    <span style="color:var(--st-red);flex:none;font-size:15px;line-height:1.4">✗</span>
                                    <span style="font-size:13.5px;line-height:1.6;color:var(--tx-1)">@issue</span>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p style="margin:0;font-size:13.5px;line-height:1.7;color:var(--tx-1)">@fbAnalysis</p>
                }
            </section>

            <section class="glass" style="padding:0;overflow:hidden">
                <div style="display:flex;align-items:center;gap:10px;padding:14px 20px;border-bottom:1px solid var(--line)">
                    <Icon Name="file-text" Size="16" Style="color:var(--acc)" />
                    <h4 style="margin:0;font-size:14px;font-weight:700">Аналіз виконаного завдання</h4>
                </div>
                <div style="padding:16px 20px">
                    @if (!string.IsNullOrEmpty(fbAnalysis))
                    {
                        <p style="margin:0;font-size:13.5px;line-height:1.7;color:var(--tx-1)">@fbAnalysis</p>
                    }
                    else
                    {
                        <p style="margin:0;font-size:13.5px;color:var(--tx-3)">Аналіз недоступний.</p>
                    }
                </div>
            </section>

            @* diff viewer *@
            @if (task.Diff.Count > 0)
            {
                var adds = task.Diff.Count(d => d.Type == "add");
                var dels = task.Diff.Count(d => d.Type == "del");
                <section class="glass" style="padding:0;overflow:hidden">
                    <button @onclick="@(() => _diffOpen = !_diffOpen)"
                            style="width:100%;display:flex;align-items:center;gap:10px;padding:14px 20px;background:transparent;border:none;cursor:pointer;color:var(--tx-1)">
                        <Icon Name="braces" Size="16" Style="color:var(--acc)" />
                        <span style="font-size:14px;font-weight:700">Diff коміту</span>
                        <span class="mono" style="font-size:12px;color:var(--st-green);background:rgba(118,199,173,0.1);padding:2px 8px;border-radius:5px">+@adds</span>
                        <span class="mono" style="font-size:12px;color:var(--st-red);background:rgba(232,128,107,0.1);padding:2px 8px;border-radius:5px">-@dels</span>
                        <span style="margin-left:auto;font-size:12px;color:var(--tx-3)">@(_diffOpen ? "сховати ↑" : "показати ↓")</span>
                    </button>
                    @if (_diffOpen)
                    {
                        <div style="border-top:1px solid var(--line);overflow-x:auto;max-height:600px;overflow-y:auto">
                            <table style="border-collapse:collapse;width:100%">
                                @foreach (var dl in task.Diff)
                                {
                                    string bg, fg;
                                    string pfx;
                                    string lnStr;
                                    if (dl.Type == "add")
                                    {
                                        bg = "rgba(118,199,173,0.10)"; fg = "var(--st-green)"; pfx = "+";
                                        lnStr = dl.N2?.ToString() ?? "";
                                    }
                                    else if (dl.Type == "del")
                                    {
                                        bg = "rgba(232,128,107,0.10)"; fg = "var(--st-red)"; pfx = "-";
                                        lnStr = dl.N1?.ToString() ?? "";
                                    }
                                    else if (dl.Type == "hdr")
                                    {
                                        bg = "rgba(255,255,255,0.035)"; fg = "var(--tx-3)"; pfx = "";
                                        lnStr = "";
                                    }
                                    else
                                    {
                                        bg = "transparent"; fg = "var(--tx-2)"; pfx = " ";
                                        lnStr = (dl.N2 ?? dl.N1)?.ToString() ?? "";
                                    }
                                    <tr style="background:@bg">
                                        <td style="padding:1px 10px 1px 16px;font-family:var(--mono);font-size:11px;color:var(--tx-faint);text-align:right;user-select:none;white-space:nowrap;border-right:1px solid var(--line);min-width:38px">@lnStr</td>
                                        <td style="padding:1px 8px;font-family:var(--mono);font-size:11.5px;color:@(dl.Type is "add" or "del" ? fg : "var(--tx-faint)");user-select:none;width:16px;text-align:center">@pfx</td>
                                        <td style="padding:1px 20px 1px 0;font-family:var(--mono);font-size:12px;color:@fg;white-space:pre">@dl.Text</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    }
                </section>
            }
            } @* end @if (task is null) else *@
        </div>
    </div>
</div>

@* ---------- resubmit modal ---------- *@
@if (_modalOpen)
{
    var widePhase = _phase is "branch" or "map";
    <div @onclick="CloseResubmit" style="position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:24px;background:rgba(6,12,10,0.72);backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px)">
        <div @onclick:stopPropagation @onclick="NoOp" class="glass"
             style="width:100%;max-width:@(widePhase ? "860px" : "480px");padding:26px;animation:popIn .3s cubic-bezier(.22,1,.36,1) both;box-shadow:var(--shadow-pop)">

            @* ── PHASE: branch ── *@
            @if (_phase == "branch")
            {
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px">
                    <span style="width:40px;height:40px;border-radius:11px;display:grid;place-items:center;background:var(--acc-dim);color:var(--acc);border:1px solid var(--glass-border)"><Icon Name="braces" Size="20" /></span>
                    <div>
                        <h3 style="margin:0;font-size:18px;font-weight:720">Здати на перевірку</h3>
                        <p style="margin:3px 0 0;font-size:13px;color:var(--tx-3)">Lab@(Id.ToString("D2")) · @LabInfo.Title</p>
                    </div>
                </div>

                @if (string.IsNullOrWhiteSpace(App.Student.Github))
                {
                    <div style="background:rgba(232,128,107,0.1);border:1px solid rgba(232,128,107,0.3);border-radius:12px;padding:13px 16px;margin-bottom:14px;display:flex;gap:10px;align-items:flex-start">
                        <Icon Name="warn" Size="16" Style="color:var(--st-red);flex:none;margin-top:1px" />
                        <div style="font-size:13px;line-height:1.6;color:var(--tx-2)">
                            <b style="color:var(--st-red)">GitHub репозиторій не вказано.</b><br/>
                            Додайте URL у <a href="/student/profile" style="color:var(--acc)">профілі</a>. Без репо буде використано мок-коміти (режим симуляції).
                        </div>
                    </div>
                }
                else
                {
                    <div style="background:rgba(12,20,17,0.5);border:1px solid var(--line);border-radius:10px;padding:10px 14px;margin-bottom:14px;display:flex;align-items:center;gap:9px;font-size:13px">
                        <Icon Name="github" Size="15" Style="color:var(--tx-3)" />
                        <span class="mono" style="color:var(--acc)">@App.Student.Github</span>
                    </div>
                }

                <div class="field" style="margin-bottom:14px">
                    <label style="font-size:12.5px;font-weight:650;color:var(--tx-2);margin-bottom:6px;display:block">
                        Гілка
                        @if (_loadingBranches)
                        {
                            <span style="margin-left:8px;font-size:11px;color:var(--tx-3)">завантаження…</span>
                        }
                    </label>
                    @if (_branches.Count > 0)
                    {
                        <select class="select mono" style="width:100%;@(_mode=="graph" ? "opacity:0.5;pointer-events:none" : "")"
                                value="@_branchInput"
                                @onchange="@(e => _branchInput = e.Value?.ToString() ?? "")"
                                disabled="@(_mode == "graph")">
                            @foreach (var b in _branches)
                            {
                                <option value="@b.Name">@b.Name</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input class="input mono" @bind="_branchInput" @bind:event="oninput" placeholder="main" style="width:100%;@(_mode=="graph" ? "opacity:0.5" : "")" disabled="@(_mode == "graph")" />
                    }
                </div>

                <div style="margin-bottom:18px">
                    <label style="font-size:12.5px;font-weight:650;color:var(--tx-2);margin-bottom:8px;display:block">Режим вибору комітів</label>
                    <div style="display:flex;gap:8px">
                        <button class="btn @(_mode=="list" ? "btn-primary" : "btn-ghost")" style="flex:1;justify-content:center"
                                @onclick='() => _mode = "list"'>
                            <Icon Name="braces" Size="15" />Список комітів
                        </button>
                        <button class="btn @(_mode=="graph" ? "btn-primary" : "btn-ghost")" style="flex:1;justify-content:center"
                                @onclick='() => { _mode = "graph"; _branchInput = "main"; }'>
                            <Icon Name="spark" Size="15" />Граф гіта
                        </button>
                    </div>
                </div>

                @if (_loadError is not null)
                {
                    <div style="padding:9px 13px;background:rgba(232,128,107,0.1);border:1px solid rgba(232,128,107,0.3);border-radius:9px;color:var(--st-red);font-size:13px;margin-bottom:14px">@_loadError</div>
                }

                <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;font-size:12.5px;color:var(--tx-3)">
                    <Icon Name="warn" Size="14" Style="color:var(--st-yellow)" />
                    Залишилось спроб: <b style="color:var(--tx-1)">@(LabInfo.AttemptsMax - LabInfo.AttemptsUsed)</b>
                </div>

                <div style="display:flex;gap:10px">
                    <button class="btn btn-ghost btn-block" @onclick="CloseResubmit">Скасувати</button>
                    <button class="btn btn-primary btn-block" @onclick="LoadCommits" disabled="@(_loadingCommits || string.IsNullOrWhiteSpace(_branchInput))">
                        @if (_loadingCommits)
                        {
                            <span style="width:16px;height:16px;border-radius:50%;border:2px solid var(--acc-dim-2);border-top-color:var(--acc);animation:spin .7s linear infinite;flex:none"></span>
                        }
                        Далі →
                    </button>
                </div>
            }

            @* ── PHASE: map ── *@
            else if (_phase == "map")
            {
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
                    <button @onclick='() => _phase = "branch"' style="width:32px;height:32px;border-radius:9px;border:1px solid var(--line);background:transparent;color:var(--tx-2);cursor:pointer;display:grid;place-items:center;flex:none"><Icon Name="x" Size="14" /></button>
                    <div>
                        <h3 style="margin:0;font-size:17px;font-weight:720">Прив'яжіть коміти до завдань</h3>
                        <p style="margin:2px 0 0;font-size:12.5px;color:var(--tx-3)">
                            <span class="mono" style="color:var(--acc)">@_branchInput</span>
                            · @_commits.Count комітів
                            @if (string.IsNullOrWhiteSpace(App.Student.Github)) { <span style="color:var(--st-yellow)"> · симуляція</span> }
                        </p>
                    </div>
                    <div style="margin-left:auto;font-size:12px;color:var(--tx-3)">
                        @(_mapping.Count(kv => kv.Value > 0)) / @_labTasks.Count завд.
                    </div>
                </div>

                @* Commit list *@
                <div style="max-height:520px;overflow-y:auto;border:1px solid var(--line);border-radius:10px;margin-bottom:14px">
                    @for (int ci = 0; ci < _commits.Count; ci++)
                    {
                        var c       = _commits[ci];
                        var isFirst = ci == 0;
                        var isLast  = ci == _commits.Count - 1;
                        var isMerge = c.Parents.Length > 1;
                        var sha     = c.Sha;
                        var isSelected = sha == _selectedSha;
                        var gr        = ci < _graph.Count ? _graph[ci] : null;
                        var graphMode = _mode == "graph";

                        <div style="display:flex;align-items:stretch;border-bottom:@(isLast ? "none" : "1px solid var(--line)");background:@(isSelected ? "rgba(118,199,173,0.07)" : "transparent");cursor:@(graphMode ? "pointer" : "default");transition:background .15s"
                             @onclick="@(() => { if (graphMode) _selectedSha = isSelected ? null : sha; })">

                            @* ── Graph / list column ── *@
                            @if (graphMode && gr != null)
                            {
                                @* CSS git graph: one 22px column per lane *@
                                var lanes = Math.Max(1, _graphMaxLanes);
                                <div style="display:flex;flex:none;padding:0 4px;min-width:@(lanes * 22 + 8)px">
                                    @for (int l = 0; l < lanes; l++)
                                    {
                                        var lane     = l;
                                        var isNode   = lane == gr.Lane;
                                        var hasTop   = gr.InLanes.Contains(lane);
                                        var hasBot   = gr.OutLanes.Contains(lane);
                                        var color    = LC(lane);
                                        var dotSize  = isMerge && isNode ? "13px" : "10px";
                                        var dotBorder= isSelected && isNode
                                            ? $"2px solid rgba(255,255,255,0.9)"
                                            : "1.5px solid rgba(255,255,255,0.3)";
                                        var glow     = isSelected && isNode
                                            ? $"box-shadow:0 0 8px {color};" : "";
                                        <div style="width:22px;flex:none;display:flex;flex-direction:column;align-items:center">
                                            @* top line — hide for lanes freshly spawned by a fork *@
                                            @{ var isForkSpawn = !isNode && gr.Forks.Values.Any(ft => ft == lane) && !gr.InLanes.Contains(lane); }
                                            <div style="width:2px;flex:none;height:20px;background:@(hasTop && !isForkSpawn ? color : "transparent")"></div>
                                            @* node dot or spacer *@
                                            @if (isNode)
                                            {
                                                <div style="width:@dotSize;height:@dotSize;border-radius:50%;background:@color;flex:none;border:@dotBorder;@glow"></div>
                                            }
                                            else
                                            {
                                                <div style="width:10px;height:10px;flex:none"></div>
                                            }
                                            @* bottom: straight, converge arc, or fork arc *@
                                            @if (!hasBot && gr.Converges.TryGetValue(lane, out var convTo))
                                            {
                                                @* converge: branch merges back into main *@
                                                @if (convTo < lane)
                                                {
                                                    <div style="width:11px;flex:1;min-height:12px;margin-right:auto;border-left:2px solid @color;border-bottom:2px solid @color;border-bottom-left-radius:9px"></div>
                                                }
                                                else
                                                {
                                                    <div style="width:11px;flex:1;min-height:12px;margin-left:auto;border-right:2px solid @color;border-bottom:2px solid @color;border-bottom-right-radius:9px"></div>
                                                }
                                            }
                                            else if (isNode && gr.Forks.TryGetValue(lane, out var forkTo) && forkTo > lane)
                                            {
                                                @* fork: straight center line (first parent) + right arc (second parent) *@
                                                <div style="flex:1;min-height:12px;width:100%;position:relative">
                                                    <div style="position:absolute;inset:0;display:flex;justify-content:center">
                                                        <div style="width:2px;background:@(hasBot ? color : "transparent")"></div>
                                                    </div>
                                                    <div style="position:absolute;right:0;top:0;bottom:0;width:11px;border-right:2px solid @LC(forkTo);border-bottom:2px solid @LC(forkTo);border-bottom-right-radius:9px"></div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="width:2px;flex:1;min-height:12px;background:@(hasBot ? color : "transparent")"></div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                @* List mode: single accent dot *@
                                <div style="width:32px;flex:none;display:flex;flex-direction:column;align-items:center;padding:0 5px">
                                    <div style="width:2px;flex:none;height:20px;background:@(isFirst ? "transparent" : "var(--acc-dim-2)")"></div>
                                    <div style="width:@(isMerge ? "12px" : "10px");height:@(isMerge ? "12px" : "10px");border-radius:50%;flex:none;background:@(isMerge ? "var(--st-yellow)" : "var(--acc)");border:1.5px solid @(isMerge ? "var(--st-yellow)" : "var(--acc-bright)")"></div>
                                    <div style="width:2px;flex:1;min-height:12px;background:@(isLast ? "transparent" : "var(--acc-dim-2)")"></div>
                                </div>
                            }

                            @* Commit info + task dropdown *@
                            <div style="flex:1;padding:10px 12px 10px 6px;min-width:0;display:flex;align-items:center;gap:10px">
                                <div style="flex:1;min-width:0">
                                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px">
                                        <span class="mono" style="font-size:11.5px;color:@(gr != null ? LC(gr.Lane) : "var(--acc)");flex:none">@c.Short</span>
                                        @if (isMerge) { <span style="font-size:10px;padding:1px 6px;border-radius:4px;background:var(--st-yellow-bg);color:var(--st-yellow)">merge</span> }
                                        <span style="font-size:11px;color:var(--tx-3);margin-left:auto;flex:none">@c.Date.ToLocalTime().ToString("dd.MM HH:mm")</span>
                                    </div>
                                    <div style="font-size:13px;font-weight:580;color:var(--tx-1);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@c.Message</div>
                                    <div style="font-size:11px;color:var(--tx-3);margin-top:2px">@c.Author</div>
                                </div>
                                @{
                                    var mapped   = _mapping.GetValueOrDefault(sha, 0);
                                    var ddLabel  = mapped == 0
                                        ? "— не вказано —"
                                        : _labTasks.FirstOrDefault(t => t.Number == mapped) is { } tt
                                            ? $"Task{tt.Number}: {tt.Title}" : "— не вказано —";
                                    var ddOpen   = _openDropdownSha == sha;
                                    var ddBorder = isSelected ? LC(gr?.Lane ?? 0) : "var(--line)";
                                }
                                <div style="flex:none;width:180px;position:relative;font-size:12.5px"
                                     @onclick:stopPropagation>
                                    @* trigger button *@
                                    <div @onclick="@(() => _openDropdownSha = ddOpen ? null : sha)"
                                         style="display:flex;align-items:center;justify-content:space-between;gap:6px;padding:5px 10px;background:var(--bg-2);border:1px solid @ddBorder;border-radius:8px;cursor:pointer;color:@(mapped==0?"var(--tx-3)":"var(--tx-1)");transition:border-color .15s;user-select:none">
                                        <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@ddLabel</span>
                                        <svg style="flex:none;transform:rotate(@(ddOpen?"180deg":"0deg"));transition:transform .15s" width="11" height="7" viewBox="0 0 12 8" fill="none"><path d="M1 1.5L6 6.5L11 1.5" stroke="var(--tx-3)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </div>
                                    @* dropdown list *@
                                    @if (ddOpen)
                                    {
                                        <div style="position:absolute;top:calc(100% + 4px);right:0;z-index:200;width:220px;background:var(--bg-2);border:1px solid var(--glass-border-hover);border-radius:10px;box-shadow:0 8px 32px rgba(0,0,0,.55);overflow-y:auto;max-height:260px;animation:popIn .15s cubic-bezier(.22,1,.36,1) both">
                                            @{
                                                var options = new (int Val, string Lbl)[] { (0, "— не вказано —") }
                                                    .Concat(_labTasks.Select(t => (t.Number, $"Task{t.Number}: {t.Title}")));
                                            }
                                            @foreach (var (val, lbl) in options)
                                            {
                                                var isActive = mapped == val;
                                                <div class="dd-option @(isActive ? "active" : "")"
                                                     style="color:@(isActive ? "var(--acc-bright)" : val == 0 ? "var(--tx-3)" : "var(--tx-1)")"
                                                     @onclick="@(() => { SetMapping(sha, val.ToString()); _openDropdownSha = null; })">
                                                    @lbl
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* Summary chips *@
                <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px">
                    @foreach (var t in _labTasks)
                    {
                        var assignedSha = _mapping.FirstOrDefault(kv => kv.Value == t.Number).Key;
                        var mapped = assignedSha is not null;
                        <div style="display:flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;font-size:12px;border:1px solid;border-color:@(mapped ? "var(--st-green)" : "var(--line)");background:@(mapped ? "rgba(118,199,173,0.1)" : "transparent");color:@(mapped ? "var(--st-green)" : "var(--tx-3)")">
                            <Icon Name="@(mapped ? "check" : "x")" Size="11" />
                            Task@(t.Number)
                            @if (mapped) { <span class="mono" style="font-size:10.5px;opacity:0.7">@assignedSha[..7]</span> }
                        </div>
                    }
                </div>

                <div style="display:flex;gap:10px">
                    <button class="btn btn-ghost btn-block" @onclick='() => _phase = "branch"'>← Назад</button>
                    <button class="btn btn-primary btn-block" @onclick="RunCheck">
                        <Icon Name="upload" Size="16" />Запустити перевірку
                    </button>
                </div>
            }

            @* ── PHASE: running ── *@
            else if (_phase == "running")
            {
                <div style="padding:8px 0">
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:22px">
                        <span style="width:22px;height:22px;border-radius:50%;border:2.5px solid var(--acc-dim-2);border-top-color:var(--acc);animation:spin .8s linear infinite;flex:none"></span>
                        <h3 style="margin:0;font-size:17px;font-weight:700">Перевірка триває…</h3>
                    </div>
                    <div style="padding:12px 16px;background:rgba(12,20,17,0.5);border-radius:10px;border:1px solid var(--line)">
                        <span class="mono" style="font-size:13px;color:var(--acc-bright)">@_currentStep</span>
                    </div>
                </div>
            }

            @* ── PHASE: error ── *@
            else if (_phase == "error")
            {
                <div style="text-align:center;padding:10px 0">
                    <div style="width:60px;height:60px;border-radius:50%;margin:0 auto 16px;display:grid;place-items:center;background:rgba(220,60,60,0.1);border:1px solid rgba(220,60,60,0.3);color:var(--st-red)"><Icon Name="alert-triangle" Size="28" Stroke="2" /></div>
                    <h3 style="margin:0 0 10px;font-size:17px;font-weight:730;color:var(--tx-1)">Перевірка недоступна</h3>
                    <p style="margin:0 0 22px;font-size:13.5px;color:var(--tx-2);line-height:1.5">@_gradingError</p>
                    <button class="btn btn-outline btn-block" @onclick='() => _phase = "map"'>← Назад</button>
                </div>
            }

            @* ── PHASE: done ── *@
            else
            {
                var newScore = _result?.AutoScore ?? LabInfo.Auto;
                var delta    = newScore - _oldScore;
                <div style="text-align:center;padding:10px 0">
                    <div style="width:60px;height:60px;border-radius:50%;margin:0 auto 16px;display:grid;place-items:center;background:var(--st-green-bg);border:1px solid var(--glass-border-hover);color:var(--st-green)"><Icon Name="check" Size="30" Stroke="2.4" /></div>
                    <h3 style="margin:0;font-size:19px;font-weight:730">Перевірку завершено</h3>
                    <p style="margin:8px 0 4px;font-size:13.5px;color:var(--tx-2)">
                        Нова авто-оцінка: <b class="mono" style="color:var(--st-green);font-size:16px">@newScore</b>
                        @if (delta > 0) { <span style="color:var(--st-green)">▲ +@delta</span> }
                        else if (delta < 0) { <span style="color:var(--st-red)">▼ @delta</span> }
                    </p>
                    <button class="btn btn-primary btn-block" @onclick="CloseResubmit">Переглянути результати</button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private LabDetail LabInfo = new();
    private string _activeId = "task1";
    private int _studentId = 1;

    protected override async Task OnInitializedAsync()
    {
        _studentId = App.StudentDbId ?? 1;
    }

    protected override async Task OnParametersSetAsync()
    {
        var detail = await Data.GetLabDetailAsync(Id, _studentId);
        if (detail is not null)
        {
            LabInfo   = detail;
            _activeId = "task" + (detail.Tasks.FirstOrDefault()?.N ?? 1);
        }
    }

    // ── Resubmit modal ────────────────────────────────────────────────────────
    private bool _diffOpen;

    private void SelectTask(string id) { _activeId = id; _diffOpen = false; }

    private bool _modalOpen;
    private string _phase = "branch";
    private string _currentStep = "";
    private string _gradingError = "";
    private GradingResultDto? _result;

    private static (string[] Done, string[] Issues, string Analysis) ParseFeedback(string? raw)
    {
        if (string.IsNullOrEmpty(raw)) return ([], [], "");
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            var r = doc.RootElement;
            static string[] Arr(System.Text.Json.JsonElement root, string key) =>
                root.TryGetProperty(key, out var el) && el.ValueKind == System.Text.Json.JsonValueKind.Array
                    ? el.EnumerateArray().Select(x => x.GetString() ?? "").Where(s => s.Length > 0).ToArray()
                    : [];
            var analysis = r.TryGetProperty("analysis", out var a) ? a.GetString() ?? "" : "";
            return (Arr(r, "done"), Arr(r, "issues"), analysis);
        }
        catch { return ([], [], raw); }
    }
    private int _oldScore;

    // Commit-mapping state
    private string _mode = "list";
    private string _branchInput = "";
    private List<CommitInfo> _commits = [];
    private List<LabTask> _labTasks = [];
    private Dictionary<string, int> _mapping = new();
    private bool _loadingCommits;
    private string? _loadError;
    private string? _selectedSha;
    private string? _openDropdownSha;   // sha of commit whose dropdown is open
    private List<GitHubBranch> _branches = [];
    private bool _loadingBranches;

    // ── Git graph (CSS-based, no SVG) ────────────────────────────────────────
    // Each GraphRow knows: which lane the commit is on, which lanes have
    // incoming lines from above, and which lanes continue below.
    private record GraphRow(
        CommitInfo Commit, int Lane,
        int[] InLanes,                          // lanes with line coming in from top
        int[] OutLanes,                         // lanes with line going out to bottom
        IReadOnlyDictionary<int, int> Converges,// lane → target lane  (arc at bottom, branch merging back)
        IReadOnlyDictionary<int, int> Forks     // lane → target lane  (arc at bottom, new branch spawned)
    );
    private List<GraphRow> _graph = [];
    private int _graphMaxLanes = 1;

    private static string LC(int lane) => lane switch
    {
        0 => "#76c7ad",
        1 => "#6ee7b7",
        2 => "#fcd34d",
        3 => "#c084fc",
        4 => "#60a5fa",
        _ => "#6b7280",
    };

    private void BuildGraph()
    {
        _graph = [];
        if (_commits.Count == 0) { _graphMaxLanes = 1; return; }

        // slots[i] = sha expected at lane i  (null = free lane)
        var slots = new List<string?>();
        var prevOutLanes = Array.Empty<int>();

        foreach (var c in _commits)
        {
            var inLanes = prevOutLanes;  // lines arriving from row above

            // Find or assign a lane for this commit
            int myLane = slots.IndexOf(c.Sha);
            if (myLane < 0)
            {
                myLane = slots.IndexOf(null);
                if (myLane < 0) { myLane = slots.Count; slots.Add(null); }
            }
            slots[myLane] = null;  // consume this slot

            var outLaneSet = new HashSet<int>();
            var converges  = new Dictionary<int, int>(); // lane → target (merge arc)
            var forks      = new Dictionary<int, int>(); // lane → target (fork arc)

            // Assign lanes to parents
            for (int pi = 0; pi < c.Parents.Length; pi++)
            {
                var pSha = c.Parents[pi];
                int ex = slots.IndexOf(pSha);
                if (ex >= 0)
                {
                    // parent already tracked → myLane converges INTO ex
                    outLaneSet.Add(ex);
                    converges[myLane] = ex;
                }
                else if (pi == 0)
                {
                    // first parent continues in this commit's lane
                    slots[myLane] = pSha;
                    outLaneSet.Add(myLane);
                }
                else
                {
                    // additional parent → open a new lane, draw fork arc
                    int nl = slots.IndexOf(null);
                    if (nl < 0) { nl = slots.Count; slots.Add(null); }
                    slots[nl] = pSha;
                    outLaneSet.Add(nl);
                    forks[myLane] = nl; // diagonal from myLane going out to nl
                }
            }

            // All other active lanes pass through
            for (int s = 0; s < slots.Count; s++)
                if (slots[s] != null) outLaneSet.Add(s);

            // Trim trailing free slots
            while (slots.Count > 0 && slots[^1] == null) slots.RemoveAt(slots.Count - 1);

            var outLanes = outLaneSet.ToArray();
            _graph.Add(new GraphRow(c, myLane, inLanes, outLanes, converges, forks));
            prevOutLanes = outLanes;
        }

        _graphMaxLanes = _graph.Count > 0
            ? Math.Max(1, _graph.Max(r => Math.Max(
                r.InLanes.Length > 0 ? r.InLanes.Max() + 1 : 0,
                r.OutLanes.Length > 0 ? r.OutLanes.Max() + 1 : 0)))
            : 1;
        _graphMaxLanes = Math.Max(_graphMaxLanes,
            _graph.Count > 0 ? _graph.Max(r => r.Lane + 1) : 1);
    }

    private void OpenResubmit()
    {
        _modalOpen    = true;
        _phase        = "branch";
        _result       = null;
        _oldScore     = LabInfo.Auto;
        _branchInput  = LabInfo.Branch.Length > 0 ? LabInfo.Branch : "main";
        _commits      = [];
        _mapping      = new();
        _loadError    = null;
        _selectedSha  = null;
        _graph        = [];
        _branches     = [];
        _ = InvokeAsync(LoadBranchesAsync);  // safe fire-and-forget on Blazor dispatcher
    }

    private async Task LoadBranchesAsync()
    {
        if (string.IsNullOrWhiteSpace(App.Student.Github)) return;
        _loadingBranches = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _branches = await GitHub.GetBranchesAsync(App.Student.Github, App.Student.GithubToken.Length > 0 ? App.Student.GithubToken : null);
            var labBranch = LabInfo.Branch;
            if (!string.IsNullOrEmpty(labBranch) && _branches.Any(b => b.Name == labBranch))
                _branchInput = labBranch;
            else if (_branches.Count > 0)
                _branchInput = _branches[0].Name;
        }
        catch { /* GitHub недоступний — залишаємо текстовий input */ }
        finally
        {
            _loadingBranches = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseResubmit() => _modalOpen = false;
    private void NoOp() { _openDropdownSha = null; }

    private void SetMapping(string sha, string? value) =>
        _mapping[sha] = int.TryParse(value, out var n) ? n : 0;

    private async Task LoadCommits()
    {
        _loadingCommits = true;
        _loadError      = null;
        StateHasChanged();
        try
        {
            var labDef = await Db.Labs
                .Include(l => l.Tasks)
                .FirstOrDefaultAsync(l => l.Number == Id);
            _labTasks = labDef?.Tasks.OrderBy(t => t.Number).ToList() ?? [];

            var token = App.Student.GithubToken.Length > 0 ? App.Student.GithubToken : null;
            _commits = await GitHub.GetBranchCommitInfosAsync(App.Student.Github, _branchInput, token);
            _mapping      = _commits.ToDictionary(c => c.Sha, _ => 0);
            _selectedSha  = null;
            BuildGraph();
            _phase        = "map";
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loadingCommits = false;
            StateHasChanged();
        }
    }

    private async Task RunCheck()
    {
        _phase = "running";
        StateHasChanged();

        var sub = await Db.Submissions
            .Include(s => s.LabDef)
            .FirstOrDefaultAsync(s => s.StudentId == _studentId && s.LabDef.Number == Id);
        if (sub is null) return;

        // Persist branch override + commit mapping before grading
        sub.BranchOverride = _branchInput.Length > 0 ? _branchInput : null;
        var mapEntries = _mapping
            .Where(kv => kv.Value > 0)
            .Select(kv => new CommitTaskMap(kv.Key, kv.Value))
            .ToList();
        sub.CommitMappingJson = mapEntries.Count > 0
            ? System.Text.Json.JsonSerializer.Serialize(mapEntries)
            : null;
        await Db.SaveChangesAsync();

        var progress = new Progress<string>(step => { _currentStep = step; InvokeAsync(StateHasChanged); });
        try
        {
            _result = await Grader.RunAsync(sub.Id, _studentId, progress);
            var detail = await Data.GetLabDetailAsync(Id, _studentId);
            if (detail is not null) { LabInfo = detail; _activeId = "task" + (detail.Tasks.FirstOrDefault()?.N ?? 1); }
            _phase = "done";
        }
        catch (Exception ex)
        {
            _gradingError = ex.Message;
            _phase = "error";
        }
        StateHasChanged();
    }

    // ── Comments ──────────────────────────────────────────────────────────────
    private async Task OpenComments()
    {
        var sub = await Db.Submissions.Include(s => s.LabDef)
            .FirstOrDefaultAsync(s => s.StudentId == _studentId && s.LabDef.Number == Id);
        if (sub is null) return;
        var p = new DialogParameters
        {
            ["SubmissionId"] = sub.Id,
            ["LabTitle"]     = LabInfo.Title,
            ["StudentName"]  = App.Student.FirstName + " " + App.Student.LastName,
            ["CanDelete"]    = false,
        };
        await Dialog.ShowAsync<CommentDialog>("", p, new DialogOptions { BackdropClick = true, NoHeader = true });
    }
}

@page "/student/lab/{Id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "student")]
@namespace AutoCheck.Components.Pages.LabPage
@inject NavigationManager Nav
@inject IDataService Data
@inject IGradingService Grader
@inject IDialogService Dialog
@inject AppState App
@inject IDbContextFactory<AppDbContext> DbFactory
@inject GitHubService GitHub
@inject GeminiQuotaService Quota

<TopBar Title="@($"Lab{LabInfo.Id:D2} · {LabInfo.Title}")" Crumbs="@(new[] { "Мої лаби", $"Lab{LabInfo.Id:D2}" })" />

<div class="screen-anim page">

    @* lab header bar *@
    <section class="glass header-bar">
        <div class="header-left">
            <span class="mono lab-number">@LabInfo.Id.ToString("D2")</span>
            <div class="title-block">
                <div class="title-row">
                    <h2 class="lab-title">@LabInfo.Title</h2>
                    <Badge Status="LabInfo.Auto > 0 ? LabStatus.Review : LabStatus.Locked" />
                </div>
                <div class="meta-row">
                    @if (LabInfo.DeadlineAt.HasValue)
                    {
                        var dl = LabInfo.DeadlineAt.Value.ToLocalTime();
                        var dlColor = LabInfo.IsOverdue ? "var(--st-red)" : (dl - DateTime.Now).TotalHours <= 24 ? "var(--st-yellow)" : "inherit";
                        <span class="meta-item" style="color:@dlColor">
                            <Icon Name="calendar" Size="14" />
                            @(LabInfo.IsOverdue ? "Дедлайн минув · " : "Здати до ")@dl.ToString("dd.MM.yyyy HH:mm")
                        </span>
                    }
                    @{ var _attLeft = LabInfo.AttemptsMax - LabInfo.AttemptsUsed; }
                    <span class="meta-item" style="color:@(_attLeft <= 0 ? "var(--st-red)" : _attLeft == 1 ? "var(--st-yellow)" : "inherit")">
                        <Icon Name="refresh" Size="14" />
                        Спроба @LabInfo.AttemptsUsed з @LabInfo.AttemptsMax
                        @if (_attLeft <= 0) { <span style="font-weight:700">(вичерпано)</span> }
                    </span>
                    @if (!string.IsNullOrEmpty(App.Student.Github))
                    {
                        <span class="meta-item"><Icon Name="github" Size="14" />@App.Student.Github</span>
                    }
                    @{
                        var _qOk    = Quota.Remaining > 0;
                        var _qClr   = _qOk ? "var(--st-green)" : "var(--st-red)";
                        var _qLabel = _qOk ? "Перевірка доступна" : "Перевірка недоступна";
                    }
                    <span class="meta-item" style="color:@_qClr">
                        <span class="quota-dot" style="background:@_qClr;@(_qOk ? "box-shadow:0 0 5px var(--st-green)44" : "")"></span>
                        @_qLabel
                    </span>
                </div>
            </div>
        </div>
        <div class="header-right">
            <div class="auto-score-block">
                <div class="auto-score-label">Авто-оцінка</div>
                <div class="mono tnum auto-score-value">@LabInfo.Auto<span class="auto-score-suffix">/100</span></div>
            </div>
            <div class="header-actions">
                <button class="btn btn-ghost btn-sm" @onclick="OpenComments"><Icon Name="spark" Size="15" />Коментарі</button>
                @if (LabInfo.IsOverdue)
                {
                    <button class="btn btn-ghost btn-sm locked-btn" disabled><Icon Name="lock" Size="15" />Дедлайн минув</button>
                }
                else if (LabInfo.AttemptsUsed >= LabInfo.AttemptsMax)
                {
                    <button class="btn btn-ghost btn-sm locked-btn" disabled><Icon Name="lock" Size="15" />Спроби вичерпано</button>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="OpenResubmit"><Icon Name="refresh" Size="17" />Здати</button>
                }
            </div>
        </div>
    </section>

    @* plagiarism notice *@
    @if (LabInfo.PlagFlag)
    {
        <section class="glass plag-box">
            <span class="plag-icon">
                <Icon Name="warn" Size="16" Stroke="2.2" />
            </span>
            <div class="plag-text">
                @if (LabInfo.PlagApproved)
                {
                    <b style="color:var(--st-yellow)">Викладач дозволив повторну здачу.</b>
                    <span style="color:var(--tx-2)"> Попередню здачу було відхилено через збіг з чужою роботою — здайте власний код.</span>
                }
                else
                {
                    <b style="color:var(--st-red)">Здачу відхилено:</b>
                    <span style="color:var(--tx-2)"> виявлено повний збіг вашого коду з роботою іншого студента. Зверніться до викладача.</span>
                }
            </div>
        </section>
    }

    @* attempt history switcher *@
    @if (LabInfo.Attempts.Count > 1)
    {
        <div class="attempt-switcher">
            <span class="attempt-switcher-label">Результати спроби</span>
            @foreach (var a in LabInfo.Attempts)
            {
                var on = a.No == LabInfo.SelectedAttempt;
                var tone = on ? "var(--acc-bright)" : "var(--tx-3)";
                <button @onclick="@(() => SelectAttempt(a.No))" class="attempt-chip"
                        style="border:1px solid @(on ? "var(--glass-border-hover)" : "var(--line)");background:@(on ? "var(--acc-dim)" : "rgba(255,255,255,0.025)");color:@tone">
                    Спроба @a.No
                    <span class="mono tnum" style="font-size:12.5px;font-weight:750;color:@(a.Score is null ? "var(--tx-faint)" : on ? "var(--acc-bright)" : "var(--tx-2)")">@(a.Score?.ToString() ?? "—")</span>
                    @if (a.IsBest && LabInfo.Attempts.Count > 1)
                    {
                        <span title="Найкраща спроба — зарахована як авто-оцінка" class="attempt-trophy"><Icon Name="trophy" Size="12" /></span>
                    }
                </button>
            }
        </div>
    }

    @* master / detail *@
    <div class="split">

        @* LEFT — task list *@
        <div class="task-list">
            <div class="task-list-head">
                <span class="task-list-title">Завдання</span>
                <span class="mono task-list-count">@LabInfo.Tasks.Count</span>
            </div>
            @foreach (var t in LabInfo.Tasks)
            {
                var v = t.View();
                var on = t.Id == _activeId;
                <button @onclick="@(() => SelectTask(t.Id))" class="tasktab glass"
                        style="border-color:@(on ? v.Tone : "var(--glass-border)");background:@(on ? $"linear-gradient(180deg, {v.Tone}14, var(--glass-bg))" : "var(--glass-bg)")">
                    @if (on)
                    {
                        <span class="tasktab-active-mark" style="background:@v.Tone;box-shadow:0 0 10px @v.Tone"></span>
                    }
                    <div class="tasktab-head">
                        <span class="tasktab-icon" style="background:@(v.Tone)22;color:@v.Tone;border:1px solid @(v.Tone)44"><Icon Name="@v.Icon" Size="14" Stroke="2.2" /></span>
                        <span class="mono tasktab-n">task@(t.N)</span>
                        <span class="mono tnum tasktab-score" style="color:@v.Tone">@t.Score</span>
                    </div>
                    <div class="tasktab-title">@t.Title</div>
                    <Progress Value="t.Score" Tone="@(t.State == "pass" ? "" : t.ColorClass)" />
                </button>
            }

        </div>

        @* RIGHT — results *@
        <div @key="_activeId" class="screen-anim detail-panel">
            @{
                var task = LabInfo.Tasks.FirstOrDefault(x => x.Id == _activeId)
                        ?? LabInfo.Tasks.FirstOrDefault();
            }
            @if (task is null)
            {
                <div class="glass empty-tasks">Завдань поки немає</div>
            }
            else
            {
            var tv = task.View();

            <section class="glass task-header-card">
                <div class="task-header-row">
                    <div class="task-header-left">
                        <span class="task-icon" style="background:@(tv.Tone)22;color:@tv.Tone;border:1px solid @(tv.Tone)44"><Icon Name="@tv.Icon" Size="18" Stroke="2.2" /></span>
                        <div>
                            <div class="task-badge-row">
                                <span class="mono task-n">task@(task.N)</span>
                                <span class="badge badge-@task.ColorClass task-status-badge"><span class="dot"></span>@tv.Label</span>
                            </div>
                            <h3 class="task-title">@task.Title</h3>
                        </div>
                    </div>
                    <ScorePill Value="task.Score" Size="lg" />
                </div>
                <div class="md task-brief"><MarkdownText Text="@task.Brief" /></div>
            </section>

            var (fbDone, fbIssues, fbAnalysis) = ParseFeedback(task.Feedback);
            <section class="glass feedback-card" style="border-color:@(tv.Tone)33">
                <div class="feedback-head">
                    <div class="feedback-head-left">
                        <Icon Name="spark" Size="17" Style="@($"color:{tv.Tone}")" />
                        <h4 class="feedback-title">Фідбек перевірки</h4>
                    </div>
                    @if (fbDone.Length + fbIssues.Length > 0)
                    {
                        <span class="feedback-summary">
                            <span class="feedback-done-count">@fbDone.Length виконано</span>
                            @if (fbIssues.Length > 0) { <span> · <span class="feedback-issue-count">@fbIssues.Length з помилкою</span></span> }
                            <span> · оцінка = @fbDone.Length/@(fbDone.Length + fbIssues.Length) × 100 = <b style="color:@tv.Tone">@task.Score</b></span>
                        </span>
                    }
                </div>
                @if (fbDone.Length > 0 || fbIssues.Length > 0)
                {
                    @if (fbDone.Length > 0)
                    {
                        <div class="feedback-list @(fbIssues.Length > 0 ? "feedback-list-divider" : "")">
                            @foreach (var d in fbDone)
                            {
                                <div class="feedback-item">
                                    <span class="feedback-check">✓</span>
                                    <span class="feedback-item-text">@d</span>
                                </div>
                            }
                        </div>
                    }
                    @if (fbIssues.Length > 0)
                    {
                        <div class="feedback-list">
                            @foreach (var issue in fbIssues)
                            {
                                <div class="feedback-item">
                                    <span class="feedback-cross">✗</span>
                                    <span class="feedback-item-text">@issue</span>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="feedback-analysis">@fbAnalysis</p>
                }
            </section>

            <section class="glass analysis-card">
                <div class="analysis-head">
                    <Icon Name="file-text" Size="16" Style="color:var(--acc)" />
                    <h4 class="analysis-title">Аналіз виконаного завдання</h4>
                </div>
                <div class="analysis-body">
                    @if (!string.IsNullOrEmpty(fbAnalysis))
                    {
                        <p class="feedback-analysis">@fbAnalysis</p>
                    }
                    else
                    {
                        <p class="analysis-empty">Аналіз недоступний.</p>
                    }
                </div>
            </section>

            @* diff viewer — shown only when commit was mapped (actual add/del lines present) *@
            @if (task.Diff.Any(d => d.Type is "add" or "del"))
            {
                var adds = task.Diff.Count(d => d.Type == "add");
                var dels = task.Diff.Count(d => d.Type == "del");
                <section class="glass diff-card">
                    <button @onclick="@(() => _diffOpen = !_diffOpen)" class="diff-toggle">
                        <Icon Name="braces" Size="16" Style="color:var(--acc)" />
                        <span class="diff-toggle-title">Diff коміту</span>
                        <span class="mono diff-adds">+@adds</span>
                        <span class="mono diff-dels">-@dels</span>
                        <span class="diff-toggle-hint">@(_diffOpen ? "сховати ↑" : "показати ↓")</span>
                    </button>
                    @if (_diffOpen)
                    {
                        <div class="diff-body">
                            <table class="diff-table">
                                @foreach (var dl in task.Diff)
                                {
                                    string bg, fg;
                                    string pfx;
                                    string lnStr;
                                    if (dl.Type == "add")
                                    {
                                        bg = "rgba(118,199,173,0.10)"; fg = "var(--st-green)"; pfx = "+";
                                        lnStr = dl.N2?.ToString() ?? "";
                                    }
                                    else if (dl.Type == "del")
                                    {
                                        bg = "rgba(232,128,107,0.10)"; fg = "var(--st-red)"; pfx = "-";
                                        lnStr = dl.N1?.ToString() ?? "";
                                    }
                                    else if (dl.Type == "hdr")
                                    {
                                        bg = "rgba(255,255,255,0.035)"; fg = "var(--tx-3)"; pfx = "";
                                        lnStr = "";
                                    }
                                    else
                                    {
                                        bg = "transparent"; fg = "var(--tx-2)"; pfx = " ";
                                        lnStr = (dl.N2 ?? dl.N1)?.ToString() ?? "";
                                    }
                                    <tr style="background:@bg">
                                        <td class="diff-ln">@lnStr</td>
                                        <td class="diff-pfx" style="color:@(dl.Type is "add" or "del" ? fg : "var(--tx-faint)")">@pfx</td>
                                        <td class="diff-text" style="color:@fg">@dl.Text</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    }
                </section>
            }
            } @* end @if (task is null) else *@
        </div>
    </div>
</div>

@* ---------- resubmit modal ---------- *@
@if (_modalOpen)
{
    var widePhase = _phase is "branch" or "map";
    <div @onclick="CloseResubmit" class="modal-overlay">
        <div @onclick:stopPropagation @onclick="NoOp" class="glass modal-card"
             style="max-width:@(widePhase ? "860px" : "480px")">

            @* ── PHASE: branch ── *@
            @if (_phase == "branch")
            {
                <div class="modal-head">
                    <span class="modal-icon"><Icon Name="braces" Size="20" /></span>
                    <div>
                        <h3 class="modal-title">Здати на перевірку</h3>
                        <p class="modal-sub">Lab@(Id.ToString("D2")) · @LabInfo.Title</p>
                    </div>
                </div>

                @if (string.IsNullOrWhiteSpace(App.Student.Github))
                {
                    <div class="warn-box">
                        <Icon Name="warn" Size="16" Style="color:var(--st-red);flex:none;margin-top:1px" />
                        <div class="warn-box-text">
                            <b style="color:var(--st-red)">GitHub репозиторій не вказано.</b><br/>
                            Додайте URL у <a href="/student/profile" style="color:var(--acc)">профілі</a>. Без репо буде використано мок-коміти (режим симуляції).
                        </div>
                    </div>
                }
                else
                {
                    <div class="repo-box">
                        <Icon Name="github" Size="15" Style="color:var(--tx-3)" />
                        <span class="mono" style="color:var(--acc)">@App.Student.Github</span>
                    </div>
                }

                <div class="field field-mb">
                    <label class="field-label">
                        Гілка
                        @if (_loadingBranches)
                        {
                            <span class="field-loading-hint">завантаження…</span>
                        }
                    </label>
                    @if (_branches.Count > 0)
                    {
                        <select class="select mono" style="width:100%;@(_mode=="graph" ? "opacity:0.5;pointer-events:none" : "")"
                                value="@_branchInput"
                                @onchange="@(e => _branchInput = e.Value?.ToString() ?? "")"
                                disabled="@(_mode == "graph")">
                            @foreach (var b in _branches)
                            {
                                <option value="@b.Name">@b.Name</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input class="input mono" @bind="_branchInput" @bind:event="oninput" placeholder="main" style="width:100%;@(_mode=="graph" ? "opacity:0.5" : "")" disabled="@(_mode == "graph")" />
                    }
                </div>

                <div class="mode-block">
                    <label class="mode-label">Режим вибору комітів</label>
                    <div class="mode-row">
                        <button class="btn @(_mode=="list" ? "btn-primary" : "btn-ghost") mode-btn"
                                @onclick='() => _mode = "list"'>
                            <Icon Name="braces" Size="15" />Список комітів
                        </button>
                        <button class="btn @(_mode=="graph" ? "btn-primary" : "btn-ghost") mode-btn"
                                @onclick='() => { _mode = "graph"; _branchInput = "main"; }'>
                            <Icon Name="spark" Size="15" />Граф гіта
                        </button>
                    </div>
                </div>

                @if (_loadError is not null)
                {
                    <div class="error-box">@_loadError</div>
                }

                <div class="attempts-left-row">
                    <Icon Name="warn" Size="14" Style="color:var(--st-yellow)" />
                    Залишилось спроб: <b class="attempts-left-value">@(LabInfo.AttemptsMax - LabInfo.AttemptsUsed)</b>
                </div>

                <div class="modal-actions">
                    <button class="btn btn-ghost btn-block" @onclick="CloseResubmit">Скасувати</button>
                    <button class="btn btn-primary btn-block" @onclick="LoadCommits" disabled="@(_loadingCommits || string.IsNullOrWhiteSpace(_branchInput))">
                        @if (_loadingCommits)
                        {
                            <span class="modal-spinner"></span>
                        }
                        Далі →
                    </button>
                </div>
            }

            @* ── PHASE: map ── *@
            else if (_phase == "map")
            {
                <div class="map-head">
                    <button @onclick='() => _phase = "branch"' class="map-back-btn"><Icon Name="x" Size="14" /></button>
                    <div>
                        <h3 class="map-title">Прив'яжіть коміти до завдань</h3>
                        <p class="map-sub">
                            <span class="mono" style="color:var(--acc)">@_branchInput</span>
                            · @_commits.Count комітів
                            @if (string.IsNullOrWhiteSpace(App.Student.Github)) { <span style="color:var(--st-yellow)"> · симуляція</span> }
                        </p>
                    </div>
                    <div class="map-progress">
                        @(_mapping.Count(kv => kv.Value > 0)) / @_labTasks.Count завд.
                    </div>
                </div>

                @* Commit list *@
                <div class="commit-list">
                    @for (int ci = 0; ci < _commits.Count; ci++)
                    {
                        var c       = _commits[ci];
                        var isFirst = ci == 0;
                        var isLast  = ci == _commits.Count - 1;
                        var isMerge = c.Parents.Length > 1;
                        var sha     = c.Sha;
                        var isSelected = sha == _selectedSha;
                        var gr        = ci < _graph.Count ? _graph[ci] : null;
                        var graphMode = _mode == "graph";

                        <div class="commit-row"
                             style="border-bottom:@(isLast ? "none" : "1px solid var(--line)");background:@(isSelected ? "rgba(118,199,173,0.07)" : "transparent");cursor:@(graphMode ? "pointer" : "default")"
                             @onclick="@(() => { if (graphMode) _selectedSha = isSelected ? null : sha; })">

                            @* ── Graph / list column ── *@
                            @if (graphMode && gr != null)
                            {
                                @* SVG git graph: connectors span lanes precisely; the
                                   node dot is a separate unscaled element so it stays round *@
                                var lanes = Math.Max(1, _graphMaxLanes);
                                var gw    = lanes * 22;
                                @* width == viewBox width and margin (not padding) → 1:1 horizontal mapping *@
                                <div style="position:relative;flex:none;width:@(gw)px;align-self:stretch;margin:0 4px">
                                    <svg width="100%" height="100%" viewBox="0 0 @gw 100" preserveAspectRatio="none"
                                         style="position:absolute;inset:0;display:block">
                                        @for (int l = 0; l < lanes; l++)
                                        {
                                            var lane   = l;
                                            var x      = lane * 22 + 11;
                                            var col    = LC(lane);
                                            var isNode = lane == gr.Lane;
                                            var hasTop = gr.InLanes.Contains(lane);
                                            var hasBot = gr.OutLanes.Contains(lane);

                                            @if (hasTop)
                                            {
                                                <line x1="@x" y1="0" x2="@x" y2="50" stroke="@col" stroke-width="2" vector-effect="non-scaling-stroke" />
                                            }
                                            @if (hasBot)
                                            {
                                                <line x1="@x" y1="50" x2="@x" y2="100" stroke="@col" stroke-width="2" vector-effect="non-scaling-stroke" />
                                            }
                                            @* converge: this node's lane merges down into an existing parent lane *@
                                            @if (gr.Converges.TryGetValue(lane, out var convTo))
                                            {
                                                var cx = convTo * 22 + 11;
                                                <path d="M @x 50 C @x 80 @cx 70 @cx 100" stroke="@col" stroke-width="2" fill="none" vector-effect="non-scaling-stroke" />
                                            }
                                            @* fork: a second parent spawns a new lane, diagonal down to it *@
                                            @if (isNode && gr.Forks.TryGetValue(lane, out var forkTo))
                                            {
                                                var fx = forkTo * 22 + 11;
                                                <path d="M @x 50 C @x 80 @fx 70 @fx 100" stroke="@LC(forkTo)" stroke-width="2" fill="none" vector-effect="non-scaling-stroke" />
                                            }
                                        }
                                    </svg>
                                    @{
                                        var nodeX   = gr.Lane * 22 + 11;
                                        var nodeCol = LC(gr.Lane);
                                        var dsz     = isMerge ? 13 : 10;
                                        var brd     = isSelected ? "2px solid rgba(255,255,255,0.9)" : "1.5px solid rgba(255,255,255,0.3)";
                                        var gl      = isSelected ? $"box-shadow:0 0 8px {nodeCol};" : "";
                                    }
                                    <div style="position:absolute;left:@(nodeX)px;top:50%;transform:translate(-50%,-50%);width:@(dsz)px;height:@(dsz)px;border-radius:50%;background:@nodeCol;border:@brd;@gl"></div>
                                </div>
                            }
                            else
                            {
                                @* List mode: single accent dot *@
                                <div style="width:32px;flex:none;display:flex;flex-direction:column;align-items:center;padding:0 5px">
                                    <div style="width:2px;flex:none;height:20px;background:@(isFirst ? "transparent" : "var(--acc-dim-2)")"></div>
                                    <div style="width:@(isMerge ? "12px" : "10px");height:@(isMerge ? "12px" : "10px");border-radius:50%;flex:none;background:@(isMerge ? "var(--st-yellow)" : "var(--acc)");border:1.5px solid @(isMerge ? "var(--st-yellow)" : "var(--acc-bright)")"></div>
                                    <div style="width:2px;flex:1;min-height:12px;background:@(isLast ? "transparent" : "var(--acc-dim-2)")"></div>
                                </div>
                            }

                            @* Commit info + task dropdown *@
                            <div class="commit-info">
                                <div class="commit-info-text">
                                    <div class="commit-info-head">
                                        <span class="mono" style="color:@(gr != null ? LC(gr.Lane) : "var(--acc)");flex:none">@c.Short</span>
                                        @if (isMerge) { <span class="commit-merge-badge">merge</span> }
                                        <span class="commit-date">@c.Date.ToLocalTime().ToString("dd.MM HH:mm")</span>
                                    </div>
                                    <div class="commit-message">@c.Message</div>
                                    <div class="commit-author">@c.Author</div>
                                </div>
                                @{
                                    var mapped   = _mapping.GetValueOrDefault(sha, 0);
                                    var ddLabel  = mapped == 0
                                        ? "— не вказано —"
                                        : _labTasks.FirstOrDefault(t => t.Number == mapped) is { } tt
                                            ? $"Task{tt.Number}: {tt.Title}" : "— не вказано —";
                                    var ddOpen   = _openDropdownSha == sha;
                                    var ddBorder = isSelected ? LC(gr?.Lane ?? 0) : "var(--line)";
                                }
                                <div class="task-dropdown"
                                     @onclick:stopPropagation>
                                    @* trigger button *@
                                    <div @onclick="@(() => _openDropdownSha = ddOpen ? null : sha)"
                                         class="task-dropdown-trigger"
                                         style="border:1px solid @ddBorder;color:@(mapped==0?"var(--tx-3)":"var(--tx-1)")">
                                        <span class="task-dropdown-label">@ddLabel</span>
                                        <svg class="task-dropdown-chevron" style="transform:rotate(@(ddOpen?"180deg":"0deg"))" width="11" height="7" viewBox="0 0 12 8" fill="none"><path d="M1 1.5L6 6.5L11 1.5" stroke="var(--tx-3)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </div>
                                    @* dropdown list *@
                                    @if (ddOpen)
                                    {
                                        <div class="task-dropdown-list">
                                            @{
                                                var options = new (int Val, string Lbl)[] { (0, "— не вказано —") }
                                                    .Concat(_labTasks.Select(t => (t.Number, $"Task{t.Number}: {t.Title}")));
                                            }
                                            @foreach (var (val, lbl) in options)
                                            {
                                                var isActive = mapped == val;
                                                <div class="dd-option @(isActive ? "active" : "")"
                                                     style="color:@(isActive ? "var(--acc-bright)" : val == 0 ? "var(--tx-3)" : "var(--tx-1)")"
                                                     @onclick="@(() => { SetMapping(sha, val.ToString()); _openDropdownSha = null; })">
                                                    @lbl
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* Summary chips *@
                <div class="summary-chips">
                    @foreach (var t in _labTasks)
                    {
                        var assignedSha = _mapping.FirstOrDefault(kv => kv.Value == t.Number).Key;
                        var mapped = assignedSha is not null;
                        <div class="summary-chip" style="border-color:@(mapped ? "var(--st-green)" : "var(--line)");background:@(mapped ? "rgba(118,199,173,0.1)" : "transparent");color:@(mapped ? "var(--st-green)" : "var(--tx-3)")">
                            <Icon Name="@(mapped ? "check" : "x")" Size="11" />
                            Task@(t.Number)
                            @if (assignedSha is not null) { <span class="mono summary-chip-sha">@assignedSha[..7]</span> }
                        </div>
                    }
                </div>

                <div class="modal-actions">
                    <button class="btn btn-ghost btn-block" @onclick='() => _phase = "branch"'>← Назад</button>
                    <button class="btn btn-primary btn-block" @onclick="RunCheck">
                        <Icon Name="upload" Size="16" />Запустити перевірку
                    </button>
                </div>
            }

            @* ── PHASE: running ── *@
            else if (_phase == "running")
            {
                <div class="running-phase">
                    <div class="running-head">
                        <span class="running-spinner"></span>
                        <h3 class="running-title">Перевірка триває…</h3>
                    </div>
                    <div class="running-step-box">
                        <span class="mono running-step-text">@_currentStep</span>
                    </div>
                </div>
            }

            @* ── PHASE: error ── *@
            else if (_phase == "error")
            {
                <div class="result-phase">
                    <div class="result-icon error-icon"><Icon Name="alert-triangle" Size="28" Stroke="2" /></div>
                    <h3 class="result-title">Перевірка недоступна</h3>
                    <p class="result-text">@_gradingError</p>
                    <button class="btn btn-outline btn-block" @onclick='() => _phase = "map"'>← Назад</button>
                </div>
            }

            @* ── PHASE: done ── *@
            else
            {
                var newScore = _result?.AutoScore ?? LabInfo.Auto;
                var delta    = newScore - _oldScore;
                <div class="result-phase">
                    <div class="result-icon done-icon"><Icon Name="check" Size="30" Stroke="2.4" /></div>
                    <h3 class="done-title">Перевірку завершено</h3>
                    <p class="done-text">
                        Нова авто-оцінка: <b class="mono done-score">@newScore</b>
                        @if (delta > 0) { <span style="color:var(--st-green)">▲ +@delta</span> }
                        else if (delta < 0) { <span style="color:var(--st-red)">▼ @delta</span> }
                    </p>
                    <button class="btn btn-primary btn-block" @onclick="CloseResubmit">Переглянути результати</button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private LabDetail LabInfo = new();
    private string _activeId = "task1";
    private int _studentId = 1;
    private int? _selectedAttempt;   // null = latest attempt with results
    private int _loadedLabId = -1;

    protected override async Task OnInitializedAsync()
    {
        _studentId = App.StudentDbId ?? 1;
    }

    protected override async Task OnParametersSetAsync()
    {
        // navigating to another lab reuses this component — drop the old selection
        if (Id != _loadedLabId)
        {
            _selectedAttempt = null;
            _loadedLabId = Id;
        }
        var detail = await Data.GetLabDetailAsync(Id, _studentId, _selectedAttempt);
        if (detail is not null)
        {
            LabInfo   = detail;
            _activeId = "task" + (detail.Tasks.FirstOrDefault()?.N ?? 1);
        }
    }

    private async Task SelectAttempt(int no)
    {
        _selectedAttempt = no;
        var detail = await Data.GetLabDetailAsync(Id, _studentId, no);
        if (detail is not null)
        {
            LabInfo = detail;
            // keep the same task selected if it still exists
            if (LabInfo.Tasks.All(t => t.Id != _activeId))
                _activeId = "task" + (LabInfo.Tasks.FirstOrDefault()?.N ?? 1);
        }
    }

    // ── Resubmit modal ────────────────────────────────────────────────────────
    private bool _diffOpen;

    private void SelectTask(string id) { _activeId = id; _diffOpen = false; }

    private bool _modalOpen;
    private string _phase = "branch";
    private string _currentStep = "";
    private string _gradingError = "";
    private GradingResultDto? _result;

    private static (string[] Done, string[] Issues, string Analysis) ParseFeedback(string? raw) =>
        FeedbackJson.Parse(raw);
    private int _oldScore;

    // Commit-mapping state
    private string _mode = "list";
    private string _branchInput = "";
    private List<CommitInfo> _commits = [];
    private List<LabTask> _labTasks = [];
    private Dictionary<string, int> _mapping = new();
    private bool _loadingCommits;
    private string? _loadError;
    private string? _selectedSha;
    private string? _openDropdownSha;   // sha of commit whose dropdown is open
    private List<GitHubBranch> _branches = [];
    private bool _loadingBranches;

    // ── Git graph (CSS-based, no SVG) ────────────────────────────────────────
    // Each GraphRow knows: which lane the commit is on, which lanes have
    // incoming lines from above, and which lanes continue below.
    private record GraphRow(
        CommitInfo Commit, int Lane,
        int[] InLanes,                          // lanes with line coming in from top
        int[] OutLanes,                         // lanes with line going out to bottom
        IReadOnlyDictionary<int, int> Converges,// lane → target lane  (arc at bottom, branch merging back)
        IReadOnlyDictionary<int, int> Forks     // lane → target lane  (arc at bottom, new branch spawned)
    );
    private List<GraphRow> _graph = [];
    private int _graphMaxLanes = 1;

    private static string LC(int lane) => lane switch
    {
        0 => "#76c7ad",
        1 => "#6ee7b7",
        2 => "#fcd34d",
        3 => "#c084fc",
        4 => "#60a5fa",
        _ => "#6b7280",
    };

    private void BuildGraph()
    {
        _graph = [];
        if (_commits.Count == 0) { _graphMaxLanes = 1; return; }

        // slots[i] = sha expected at lane i  (null = free lane)
        var slots = new List<string?>();
        var prevOutLanes = Array.Empty<int>();

        foreach (var c in _commits)
        {
            var inLanes = prevOutLanes;  // lines arriving from row above

            // Find or assign a lane for this commit
            int myLane = slots.IndexOf(c.Sha);
            if (myLane < 0)
            {
                myLane = slots.IndexOf(null);
                if (myLane < 0) { myLane = slots.Count; slots.Add(null); }
            }
            slots[myLane] = null;  // consume this slot

            var outLaneSet = new HashSet<int>();
            var converges  = new Dictionary<int, int>(); // lane → target (merge arc)
            var forks      = new Dictionary<int, int>(); // lane → target (fork arc)

            // Assign lanes to parents
            for (int pi = 0; pi < c.Parents.Length; pi++)
            {
                var pSha = c.Parents[pi];
                int ex = slots.IndexOf(pSha);
                if (ex >= 0)
                {
                    // parent already tracked → myLane converges INTO ex
                    outLaneSet.Add(ex);
                    converges[myLane] = ex;
                }
                else if (pi == 0)
                {
                    // first parent continues in this commit's lane
                    slots[myLane] = pSha;
                    outLaneSet.Add(myLane);
                }
                else
                {
                    // additional parent → open a new lane, draw fork arc
                    int nl = slots.IndexOf(null);
                    if (nl < 0) { nl = slots.Count; slots.Add(null); }
                    slots[nl] = pSha;
                    outLaneSet.Add(nl);
                    forks[myLane] = nl; // diagonal from myLane going out to nl
                }
            }

            // All other active lanes pass through
            for (int s = 0; s < slots.Count; s++)
                if (slots[s] != null) outLaneSet.Add(s);

            // Trim trailing free slots
            while (slots.Count > 0 && slots[^1] == null) slots.RemoveAt(slots.Count - 1);

            var outLanes = outLaneSet.ToArray();
            _graph.Add(new GraphRow(c, myLane, inLanes, outLanes, converges, forks));
            prevOutLanes = outLanes;
        }

        _graphMaxLanes = _graph.Count > 0
            ? Math.Max(1, _graph.Max(r => Math.Max(
                r.InLanes.Length > 0 ? r.InLanes.Max() + 1 : 0,
                r.OutLanes.Length > 0 ? r.OutLanes.Max() + 1 : 0)))
            : 1;
        _graphMaxLanes = Math.Max(_graphMaxLanes,
            _graph.Count > 0 ? _graph.Max(r => r.Lane + 1) : 1);
    }

    private void OpenResubmit()
    {
        _modalOpen    = true;
        _phase        = "branch";
        _result       = null;
        _oldScore     = LabInfo.Auto;
        _branchInput  = LabInfo.Branch.Length > 0 ? LabInfo.Branch : "main";
        _commits      = [];
        _mapping      = new();
        _loadError    = null;
        _selectedSha  = null;
        _graph        = [];
        _branches     = [];
        _ = InvokeAsync(LoadBranchesAsync);  // safe fire-and-forget on Blazor dispatcher
    }

    private async Task LoadBranchesAsync()
    {
        if (string.IsNullOrWhiteSpace(App.Student.Github)) return;
        _loadingBranches = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _branches = await GitHub.GetBranchesAsync(App.Student.Github, App.Student.GithubToken.Length > 0 ? App.Student.GithubToken : null);
            var labBranch = LabInfo.Branch;
            if (!string.IsNullOrEmpty(labBranch) && _branches.Any(b => b.Name == labBranch))
                _branchInput = labBranch;
            else if (_branches.Count > 0)
                _branchInput = _branches[0].Name;
        }
        catch { /* GitHub недоступний — залишаємо текстовий input */ }
        finally
        {
            _loadingBranches = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseResubmit() => _modalOpen = false;
    private void NoOp() { _openDropdownSha = null; }

    private void SetMapping(string sha, string? value) =>
        _mapping[sha] = int.TryParse(value, out var n) ? n : 0;

    private async Task LoadCommits()
    {
        _loadingCommits = true;
        _loadError      = null;
        StateHasChanged();
        try
        {
            await using var Db = await DbFactory.CreateDbContextAsync();
            var labDef = await Db.Labs
                .Include(l => l.Tasks)
                .FirstOrDefaultAsync(l => l.Number == Id);
            _labTasks = labDef?.Tasks.OrderBy(t => t.Number).ToList() ?? [];

            var token = App.Student.GithubToken.Length > 0 ? App.Student.GithubToken : null;
            _commits = await GitHub.GetBranchCommitInfosAsync(App.Student.Github, _branchInput, token);
            _mapping      = _commits.ToDictionary(c => c.Sha, _ => 0);
            _selectedSha  = null;
            BuildGraph();
            _phase        = "map";
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loadingCommits = false;
            StateHasChanged();
        }
    }

    private async Task RunCheck()
    {
        _phase = "running";
        StateHasChanged();

        await using var Db = await DbFactory.CreateDbContextAsync();
        var sub = await Db.Submissions
            .Include(s => s.LabDef)
            .FirstOrDefaultAsync(s => s.StudentId == _studentId && s.LabDef.Number == Id);
        if (sub is null) return;

        // Persist branch override + commit mapping before grading
        sub.BranchOverride = _branchInput.Length > 0 ? _branchInput : null;
        var mapEntries = _mapping
            .Where(kv => kv.Value > 0)
            .Select(kv => new CommitTaskMap(kv.Key, kv.Value))
            .ToList();
        sub.CommitMappingJson = mapEntries.Count > 0
            ? System.Text.Json.JsonSerializer.Serialize(mapEntries)
            : null;
        await Db.SaveChangesAsync();

        var progress = new Progress<string>(step => { _currentStep = step; InvokeAsync(StateHasChanged); });
        try
        {
            _result = await Grader.RunAsync(sub.Id, _studentId, progress);
            _selectedAttempt = null;   // show the attempt that was just graded
            var detail = await Data.GetLabDetailAsync(Id, _studentId);
            if (detail is not null) { LabInfo = detail; _activeId = "task" + (detail.Tasks.FirstOrDefault()?.N ?? 1); }
            _phase = "done";
        }
        catch (Exception ex)
        {
            _gradingError = ex.Message;
            _phase = "error";
        }
        StateHasChanged();
    }

    // ── Comments ──────────────────────────────────────────────────────────────
    private async Task OpenComments()
    {
        await using var Db = await DbFactory.CreateDbContextAsync();
        var sub = await Db.Submissions.Include(s => s.LabDef)
            .FirstOrDefaultAsync(s => s.StudentId == _studentId && s.LabDef.Number == Id);
        if (sub is null) return;
        var p = new DialogParameters
        {
            ["SubmissionId"] = sub.Id,
            ["LabTitle"]     = LabInfo.Title,
            ["StudentName"]  = App.Student.FirstName + " " + App.Student.LastName,
            ["CanDelete"]    = false,
        };
        await Dialog.ShowAsync<CommentDialog>("", p, new DialogOptions { BackdropClick = true, NoHeader = true });
    }
}

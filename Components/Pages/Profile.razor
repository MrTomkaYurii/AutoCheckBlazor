@page "/student/profile"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "student")]
@inject AppState App
@inject IAuthService Auth
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<AppUser> UserManager
@inject NavigationManager Nav
@inject TokenProtector Tokens
@inject PlagiarismService Plagiarism

<TopBar Title="Профіль" Sub="Дані студента" />

<div class="screen-anim page">
  <div class="profile-grid">
    <div class="profile-main">
    <section class="glass card">
        <div class="head">
            <div class="avatar">@App.Student.Initials</div>
            <div class="head-info">
                <h2 class="head-name">@App.Student.FirstName @App.Student.LastName</h2>
                <div class="head-badges">
                    <span class="badge badge-green"><span class="dot"></span>Студент</span>
                    <span class="badge badge-grey"><span class="dot"></span>@App.Student.Group</span>
                </div>
            </div>
            <button class="btn btn-outline btn-sm" @onclick="ToggleEdit">
                <Icon Name="@(_editing ? "x" : "settings")" Size="15" />
                @(_editing ? "Скасувати" : "Редагувати")
            </button>
        </div>

        @if (!_editing)
        {
            <div class="view-list">
                @foreach (var (k, v, mono) in new[]
                {
                    ("Ім'я",          App.Student.FirstName, false),
                    ("Прізвище",      App.Student.LastName,  false),
                    ("Email",         App.Student.Email,  true),
                    ("GitHub репо",   App.Student.Github, true),
                    ("GitHub токен",  string.IsNullOrEmpty(App.Student.GithubToken) ? "—" : "••••••••••••", false),
                    ("Група",         App.Student.Group,  false),
                })
                {
                    <div class="view-row">
                        <span class="view-label">@k</span>
                        <span class="@(mono ? "mono" : "") view-value">@v</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="edit-form">
                <div class="edit-row2">
                    <div class="field"><label>Ім'я</label><input class="input" @bind="_firstName" /></div>
                    <div class="field"><label>Прізвище</label><input class="input" @bind="_lastName" /></div>
                </div>
                <div class="edit-row2">
                    <div class="field"><label>Email</label><input class="input" type="email" @bind="_email" /></div>
                    <div class="field"><label>GitHub репо</label><input class="input mono" @bind="_github" placeholder="https://github.com/username/repo" /></div>
                </div>
                <div class="field">
                    <label>GitHub токен <span class="field-hint">(необов'язково — для приватного репо або вищого ліміту; як отримати — в інструкції поруч)</span></label>
                    <input class="input mono" type="password" @bind="_githubToken" placeholder="ghp_xxxxxxxxxxxx" />
                </div>
                @if (!string.IsNullOrEmpty(_msg))
                {
                    <div class="success-box">@_msg</div>
                }
                <div class="edit-actions">
                    <button class="btn btn-primary" @onclick="SaveProfile" disabled="@_saving">
                        <Icon Name="check" Size="16" />@(_saving ? "Збереження…" : "Зберегти")
                    </button>
                </div>
            </div>
        }
    </section>

    @* ── Безпека ──────────────────────────────────────────────────────────── *@
    <section class="glass card card-second">
        <div class="sec-head">
            <Icon Name="settings" Size="18" Style="color:var(--acc)" />
            <h3 class="sec-title">Безпека</h3>
            @if (_hasGoogle)
            {
                <span class="badge badge-green sec-google-badge"><span class="dot"></span>Google підключено</span>
            }
        </div>

        @if (!_pwEdit)
        {
            <div class="pw-view-row">
                <span class="pw-view-label">Пароль</span>
                <span class="pw-view-value">
                    @(_hasPassword ? "••••••••••" : "не встановлено — вхід через Google")
                </span>
                <button class="btn btn-ghost btn-sm" @onclick="@(() => { _pwEdit = true; _pwMsg = ""; })">
                    <Icon Name="settings" Size="13" />@(_hasPassword ? "Змінити" : "Встановити")
                </button>
            </div>
        }
        else
        {
            <div class="pw-form">
                @if (_hasPassword)
                {
                    <div class="field">
                        <label>Поточний пароль</label>
                        <input class="input" type="password" @bind="_pwOld" autocomplete="current-password" />
                    </div>
                }
                <div class="pw-row2">
                    <div class="field">
                        <label>Новий пароль</label>
                        <input class="input" type="password" @bind="_pwNew" autocomplete="new-password" />
                    </div>
                    <div class="field">
                        <label>Підтвердження</label>
                        <input class="input" type="password" @bind="_pwConfirm" autocomplete="new-password" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_pwMsg))
                {
                    var isErr = _pwMsg.StartsWith("err:");
                    <div class="pw-msg" style="background:@(isErr ? "rgba(255,80,80,0.08)" : "rgba(118,199,173,0.1)");border:1px solid @(isErr ? "rgba(255,80,80,0.25)" : "rgba(118,199,173,0.25)");color:@(isErr ? "var(--st-red)" : "var(--st-green)")">@(isErr ? _pwMsg[4..] : _pwMsg[3..])</div>
                }
                <div class="pw-actions">
                    <button class="btn btn-ghost btn-sm" @onclick="@(() => { _pwEdit = false; _pwOld = _pwNew = _pwConfirm = _pwMsg = ""; })">
                        Скасувати
                    </button>
                    <button class="btn btn-primary btn-sm" @onclick="ChangePassword" disabled="@_savingPw">
                        <Icon Name="check" Size="15" />@(_savingPw ? "Збереження…" : (_hasPassword ? "Змінити пароль" : "Встановити пароль"))
                    </button>
                </div>
            </div>
        }
    </section>
    </div>@* /.profile-main *@

    @* ── Колонка 2: навіщо репозиторій і токен ──────────────────────────── *@
    <aside class="glass card guide">
        <div class="guide-head">
            <Icon Name="github" Size="18" Style="color:var(--acc)" />
            <h3 class="guide-title">Навіщо це</h3>
        </div>
        <div class="guide-body">

            <div class="guide-sect">
                <h4><Icon Name="braces" Size="14" Style="color:var(--acc)" />GitHub-репозиторій</h4>
                <p>
                    Кожну лабораторну ти виконуєш у <b>власному GitHub-репозиторії</b>. Коли
                    натискаєш «Здати», система клонує його, прогоняє авто-перевірку коду й
                    звіряє твої коміти із завданнями лаби.
                </p>
                <p>
                    Посилання вказується у полі <span class="mono">GitHub репо</span> у форматі
                    <span class="mono">https://github.com/username/repo</span>. Без нього здати
                    роботу не можна — кнопка «Здати» веде сюди, у профіль.
                </p>
            </div>

            <div class="guide-sect">
                <h4><Icon Name="lock" Size="14" Style="color:var(--acc)" />GitHub-токен</h4>
                <p>
                    Токен (Personal Access Token) <b>необов'язковий</b>, але потрібен, якщо:
                </p>
                <ul class="guide-list">
                    <li><b>репозиторій приватний</b> — без токена система не зможе його клонувати;</li>
                    <li><b>ти впираєшся в ліміт GitHub API</b> — без токена це 60 запитів/год
                        на весь сервер (спільно з іншими студентами), з токеном — 5000/год особисто для тебе.</li>
                </ul>
                <p class="guide-note">
                    Якщо репо публічне і «Перевірка недоступна» не з'являється — токен не потрібен.
                </p>
            </div>

        </div>
    </aside>

    @* ── Колонка 3: як створити токен + безпека ─────────────────────────── *@
    <aside class="glass card guide">
        <div class="guide-head">
            <Icon Name="spark" Size="18" Style="color:var(--acc)" />
            <h3 class="guide-title">Як створити токен</h3>
        </div>
        <div class="guide-body">

            <div class="guide-sect">
                <ol class="guide-steps">
                    <li>GitHub → <span class="mono">Settings</span> → <span class="mono">Developer settings</span>
                        → <span class="mono">Personal access tokens</span> → <span class="mono">Fine-grained tokens</span>.</li>
                    <li><span class="mono">Generate new token</span>. Вкажи назву та термін дії
                        (<i>Expiration</i>) — напр. до кінця семестру.</li>
                    <li><b>Repository access</b> → <span class="mono">Only select repositories</span>
                        → обери свій репозиторій із лабами.</li>
                    <li><b>Permissions</b> → <span class="mono">Repository permissions</span> →
                        <span class="mono">Contents</span> = <span class="mono">Read-only</span>. Більше нічого не треба.</li>
                    <li><span class="mono">Generate token</span> → скопіюй рядок
                        <span class="mono">github_pat_…</span> і встав у поле <span class="mono">GitHub токен</span>.</li>
                </ol>
                <p class="guide-note">
                    Класичний варіант: <span class="mono">Tokens (classic)</span> → scope
                    <span class="mono">repo</span> (для приватних) або без scope (лише заради ліміту).
                </p>
                <a class="guide-link" href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">
                    Відкрити сторінку створення токена <Icon Name="arrowR" Size="13" />
                </a>
            </div>

            <div class="guide-sect">
                <h4><Icon Name="check" Size="14" Style="color:var(--acc)" />Безпека</h4>
                <p>
                    Токен зберігається зашифрованим, у профілі показується як
                    <span class="mono">••••</span> і маскується в логах. Дай йому мінімальні
                    права (<span class="mono">Contents: Read-only</span>) — цього достатньо
                    для перевірки, і його не можна використати, щоб щось змінити у твоєму акаунті.
                </p>
            </div>

        </div>
    </aside>
  </div>@* /.profile-grid *@
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private bool _editing, _saving;
    private string _firstName = "", _lastName = "", _email = "", _github = "", _githubToken = "", _msg = "";

    // ── Security ──────────────────────────────────────────────────────────────
    private bool _pwEdit, _savingPw, _hasPassword, _hasGoogle;
    private string _pwOld = "", _pwNew = "", _pwConfirm = "", _pwMsg = "";

    protected override async Task OnInitializedAsync()
    {
        _firstName   = App.Student.FirstName;
        _lastName    = App.Student.LastName;
        _email       = App.Student.Email;
        _github      = App.Student.Github;
        _githubToken = App.Student.GithubToken;

        var state = await AuthStateTask;
        var user  = await UserManager.FindByIdAsync(Auth.GetSub(state.User));
        if (user != null)
        {
            _hasPassword = await UserManager.HasPasswordAsync(user);
            _hasGoogle   = (await UserManager.GetLoginsAsync(user)).Any(l => l.LoginProvider == "Google");
        }
    }

    private async Task ChangePassword()
    {
        if (string.IsNullOrWhiteSpace(_pwNew))              { _pwMsg = "err:Новий пароль не може бути порожнім."; return; }
        if (_pwNew.Length < 6)                              { _pwMsg = "err:Пароль має бути не менше 6 символів."; return; }
        if (_pwNew != _pwConfirm)                           { _pwMsg = "err:Паролі не збігаються."; return; }
        if (_hasPassword && string.IsNullOrWhiteSpace(_pwOld)) { _pwMsg = "err:Введіть поточний пароль."; return; }

        _savingPw = true; StateHasChanged();
        try
        {
            var state = await AuthStateTask;
            var user  = await UserManager.FindByIdAsync(Auth.GetSub(state.User));
            if (user == null)
            {
                _pwMsg = "err:Акаунт не знайдено.";
            }
            else
            {
                var result = _hasPassword
                    ? await UserManager.ChangePasswordAsync(user, _pwOld, _pwNew)
                    : await UserManager.AddPasswordAsync(user, _pwNew);
                if (result.Succeeded)
                {
                    _pwMsg = "ok:Пароль успішно " + (_hasPassword ? "змінено" : "встановлено");
                    _pwOld = _pwNew = _pwConfirm = "";
                }
                else
                {
                    var wrongOld = result.Errors.Any(e => e.Code == "PasswordMismatch");
                    _pwMsg = "err:" + (wrongOld
                        ? "Поточний пароль невірний."
                        : string.Join(" ", result.Errors.Select(e => e.Description)));
                }
            }
        }
        catch (Exception ex)
        {
            _pwMsg = $"err:{ex.Message}";
        }
        _savingPw = false; StateHasChanged();
        if (_pwMsg.StartsWith("ok:"))
        {
            // Security stamp changed → re-issue the auth cookie so the session stays valid
            await Task.Delay(1200);
            Nav.NavigateTo("/account/refresh-signin?returnUrl=/student/profile", forceLoad: true);
        }
    }

    private void ToggleEdit()
    {
        _editing = !_editing; _msg = "";
        if (_editing)
        {
            _firstName   = App.Student.FirstName;
            _lastName    = App.Student.LastName;
            _email       = App.Student.Email;
            _github      = App.Student.Github;
            _githubToken = App.Student.GithubToken;
        }
    }

    private async Task SaveProfile()
    {
        _saving = true; StateHasChanged();
        var state = await AuthStateTask;
        var sub = Auth.GetSub(state.User);
        await using var Db = await DbFactory.CreateDbContextAsync();
        var link = await Db.UserLinks.AsNoTracking()
                                     .FirstOrDefaultAsync(l => l.UserId == sub);
        if (link?.StudentId is int studentId)
        {
            // Repo-substitution guard: another student can't already have this repo.
            // Catching it here (before any write) is gentler than at grading time,
            // where a collision burns an attempt.
            var repoConflict = await Plagiarism.FindSharedRepoAsync(studentId, _github.Trim());
            if (repoConflict != null)
            {
                _msg = $"Помилка: цей репозиторій вже вказано у студента {repoConflict.StudentName} ({repoConflict.Group})";
                _saving = false; StateHasChanged();
                await Task.Delay(3500); _msg = ""; StateHasChanged();
                return;
            }

            // Email is the login — keep the Identity account and the link in sync
            var newEmail = _email.Trim();
            var user = await UserManager.FindByIdAsync(sub);
            var emailChanged = false;
            if (user != null && !string.Equals(user.Email, newEmail, StringComparison.OrdinalIgnoreCase))
            {
                string? err = null;
                if (!newEmail.Contains('@'))
                    err = "Помилка: некоректний email";
                else if (await UserManager.FindByEmailAsync(newEmail) is { } taken && taken.Id != user.Id)
                    err = "Помилка: цей email вже використовується іншим акаунтом";

                if (err != null)
                {
                    _msg = err; _saving = false; StateHasChanged();
                    await Task.Delay(2500); _msg = ""; StateHasChanged();
                    return;
                }

                // SetEmailAsync/SetUserNameAsync (not raw property + UpdateAsync) so a
                // concurrency/validation failure is caught here instead of silently
                // proceeding to write the new email into StudentRecord/UserLink anyway —
                // and so the security stamp rotates, matching the password-change flow.
                var setEmail = await UserManager.SetEmailAsync(user, newEmail);
                var setName  = setEmail.Succeeded ? await UserManager.SetUserNameAsync(user, newEmail) : setEmail;
                if (!setEmail.Succeeded || !setName.Succeeded)
                {
                    var failed = setEmail.Succeeded ? setName : setEmail;
                    _msg = "Помилка: " + string.Join(" ", failed.Errors.Select(e => e.Description));
                    _saving = false; StateHasChanged();
                    await Task.Delay(2500); _msg = ""; StateHasChanged();
                    return;
                }
                await Db.UserLinks.Where(l => l.UserId == sub)
                    .ExecuteUpdateAsync(l => l.SetProperty(x => x.Email, newEmail));
                emailChanged = true;
            }

            var initials = (_firstName.Length > 0 ? _firstName[0].ToString() : "")
                         + (_lastName.Length  > 0 ? _lastName[0].ToString()  : "");
            await Db.Students
                    .Where(s => s.Id == studentId)
                    .ExecuteUpdateAsync(s => s
                        .SetProperty(x => x.FirstName,   _firstName.Trim())
                        .SetProperty(x => x.LastName,    _lastName.Trim())
                        .SetProperty(x => x.Initials,    initials)
                        .SetProperty(x => x.Email,       newEmail)
                        .SetProperty(x => x.Github,      _github.Trim())
                        // token is encrypted at rest (Data Protection)
                        .SetProperty(x => x.GithubToken, Tokens.Protect(_githubToken.Trim())));
            await App.PreloadAsync(state.User);
            _msg = "Профіль оновлено";
            _saving = false; _editing = false; StateHasChanged();
            if (emailChanged)
            {
                // Security stamp changed → re-issue the auth cookie so the session stays valid
                await Task.Delay(1200);
                Nav.NavigateTo("/account/refresh-signin?returnUrl=/student/profile", forceLoad: true);
                return;
            }
        }
        else
        {
            _msg = "Помилка: профіль не знайдено";
            _saving = false; _editing = false; StateHasChanged();
        }
        await Task.Delay(2000); _msg = ""; StateHasChanged();
    }
}

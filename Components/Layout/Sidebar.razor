@implements IDisposable
@inject NavigationManager Nav
@inject AppState App

<aside style="width:var(--sidebar-w);flex:none;height:100%;display:flex;flex-direction:column;align-items:center;padding:22px 0 18px;position:relative;z-index:5;border-right:1px solid var(--line);background:linear-gradient(180deg, rgba(21,28,25,0.7), rgba(15,26,22,0.5));backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)">

    <button @onclick="@(() => Go(Home))" title="AutoCheck"
            style="width:46px;height:46px;border-radius:13px;border:none;cursor:pointer;display:grid;place-items:center;background:linear-gradient(150deg, var(--acc-bright), var(--acc));color:#08110d;font-weight:800;font-family:var(--mono);font-size:21px;letter-spacing:-0.04em;box-shadow:0 8px 20px -10px rgba(118,199,173,0.8), inset 0 1px 0 rgba(255,255,255,0.35)">{}</button>

    <nav style="margin-top:30px;display:flex;flex-direction:column;gap:6px;width:100%;padding:0 10px">
        @foreach (var it in Items)
        {
            var on = it.Key == Active;
            <button @onclick="@(() => Go(it.Route))" class="side-item"
                    style="display:flex;flex-direction:column;align-items:center;gap:5px;padding:11px 4px 9px;border-radius:14px;border:none;cursor:pointer;background:@(on ? "var(--acc-dim)" : "transparent");color:@(on ? "var(--acc-bright)" : "var(--tx-3)");position:relative;transition:background .18s, color .18s">
                @if (on)
                {
                    <span style="position:absolute;left:-10px;top:50%;transform:translateY(-50%);width:3px;height:22px;border-radius:3px;background:var(--acc);box-shadow:0 0 10px var(--acc)"></span>
                }
                <Icon Name="@it.Icon" Size="22" />
                <span style="font-size:10.5px;font-weight:600;letter-spacing:-0.01em">@it.Label</span>
            </button>
        }
    </nav>

    <div style="margin-top:auto;display:flex;flex-direction:column;gap:10px;align-items:center">
        <form method="post" action="/account/logout">
            <AntiforgeryToken />
            <button type="submit" title="Вийти" class="side-logout"
                    style="width:42px;height:42px;border-radius:12px;border:1px solid var(--line-strong);background:transparent;color:var(--tx-3);cursor:pointer;display:grid;place-items:center;transition:color .18s, border-color .18s, background .18s">
                <Icon Name="logout" Size="19" />
            </button>
        </form>
    </div>
</aside>

@code {
    private record Item(string Key, string Icon, string Label, string Route);

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private bool _isTeacher;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLoc;
        var state = await AuthStateTask;
        _isTeacher = App.IsTeacher(state.User);
    }

    private List<Item> StudentItems =>
    [
        new("dashboard", "home",    "Дашборд",  "/student"),
        new("grades",    "grades",  "Оцінки",   "/student/grades"),
        new("profile",   "profile", "Профіль",  "/student/profile"),
    ];

    private List<Item> TeacherItems =>
    [
        new("teacher",      "home",      "Огляд",      "/teacher"),
        new("students",     "users",     "Студенти",   "/teacher/students"),
        new("journal",      "grades",    "Журнал",     "/teacher/journal"),
        new("labsadmin",    "settings",  "Лаби",       "/teacher/labs"),
        new("groups",       "users",     "Групи",      "/teacher/groups"),
        new("monitoring",   "target",    "Моніторинг", "/teacher/monitoring"),
        new("profile",      "profile",   "Кабінет",    "/teacher/profile"),
    ];

    private List<Item> Items => _isTeacher ? TeacherItems : StudentItems;
    private string Home => _isTeacher ? "/teacher" : "/student";

    private string Active
    {
        get
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
            if (_isTeacher)
            {
                if (path.StartsWith("/teacher/students"))  return "students";
                if (path.StartsWith("/teacher/journal"))   return "journal";
                if (path.StartsWith("/teacher/labs"))      return "labsadmin";
                if (path.StartsWith("/teacher/groups"))     return "groups";
                if (path.StartsWith("/teacher/monitoring"))return "monitoring";
                if (path.StartsWith("/teacher/profile"))   return "profile";
                return "teacher";
            }
            if (path.StartsWith("/student/grades"))  return "grades";
            if (path.StartsWith("/student/profile")) return "profile";
            if (path.StartsWith("/student/lab"))     return "labs";
            return "dashboard";
        }
    }

    private void Go(string route) => Nav.NavigateTo(route);
    private void OnLoc(object? s, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() => Nav.LocationChanged -= OnLoc;
}

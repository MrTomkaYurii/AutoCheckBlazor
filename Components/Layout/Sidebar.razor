@implements IDisposable
@inject NavigationManager Nav
@inject AppState App

<aside>

    <button @onclick="@(() => Go(Home))" title="AutoCheck" class="logo-btn">{}</button>

    <nav>
        @foreach (var it in Items)
        {
            var on = it.Key == Active;
            <button @onclick="@(() => Go(it.Route))" class="side-item nav-btn"
                    style="background:@(on ? "var(--acc-dim)" : "transparent");color:@(on ? "var(--acc-bright)" : "var(--tx-3)")">
                @if (on)
                {
                    <span class="nav-active-mark"></span>
                }
                <Icon Name="@it.Icon" Size="22" />
                <span class="nav-label">@it.Label</span>
            </button>
        }
    </nav>

    <div class="bottom-bar">
        <form method="post" action="/account/logout">
            <AntiforgeryToken />
            <button type="submit" title="Вийти" class="side-logout logout-btn">
                <Icon Name="logout" Size="19" />
            </button>
        </form>
    </div>
</aside>

@code {
    private record Item(string Key, string Icon, string Label, string Route);

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private bool _isTeacher;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLoc;
        var state = await AuthStateTask;
        _isTeacher = App.IsTeacher(state.User);
    }

    private List<Item> StudentItems =>
    [
        new("dashboard", "home",    "Дашборд",   "/student"),
        new("grades",    "grades",  "Оцінки",    "/student/grades"),
        new("points",    "target",  "Бали",      "/student/points"),
        new("profile",   "profile", "Профіль",   "/student/profile"),
        new("feedback",  "mail",    "Підтримка", "/student/feedback"),
    ];

    private List<Item> TeacherItems =>
    [
        new("teacher",      "home",      "Огляд",      "/teacher"),
        new("students",     "users",     "Студенти",   "/teacher/students"),
        new("journal",      "grades",    "Журнал",     "/teacher/journal"),
        new("labsadmin",    "settings",  "Лаби",       "/teacher/labs"),
        new("groups",       "users",     "Групи",      "/teacher/groups"),
        new("monitoring",   "target",    "Моніторинг", "/teacher/monitoring"),
        new("profile",      "profile",   "Кабінет",    "/teacher/profile"),
    ];

    private List<Item> Items => _isTeacher ? TeacherItems : StudentItems;
    private string Home => _isTeacher ? "/teacher" : "/student";

    private string Active
    {
        get
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
            if (_isTeacher)
            {
                if (path.StartsWith("/teacher/students"))  return "students";
                if (path.StartsWith("/teacher/journal"))   return "journal";
                if (path.StartsWith("/teacher/labs"))      return "labsadmin";
                if (path.StartsWith("/teacher/groups"))     return "groups";
                if (path.StartsWith("/teacher/monitoring"))return "monitoring";
                if (path.StartsWith("/teacher/profile"))   return "profile";
                return "teacher";
            }
            if (path.StartsWith("/student/grades"))   return "grades";
            if (path.StartsWith("/student/points"))   return "points";
            if (path.StartsWith("/student/profile"))  return "profile";
            if (path.StartsWith("/student/feedback")) return "feedback";
            if (path.StartsWith("/student/lab"))      return "labs";
            return "dashboard";
        }
    }

    private void Go(string route) => Nav.NavigateTo(route);
    private void OnLoc(object? s, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() => Nav.LocationChanged -= OnLoc;
}

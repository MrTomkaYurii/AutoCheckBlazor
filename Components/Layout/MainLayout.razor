@inherits LayoutComponentBase
@inject AppState App
@inject IAuthService Auth
@inject NavigationManager Nav

<MudThemeProvider IsDarkMode="true" Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider Position="DialogPosition.Center" CloseButton="false" />
<MudSnackbarProvider />

@if (_ready)
{
    <div class="shell">
        <Sidebar />
        <main class="scroll-area content">
            @Body
        </main>
    </div>
}
else
{
    <div class="loading">
        <span class="spinner"></span>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    // Pages read App.Student / App.StudentDbId in their own OnInitializedAsync.
    // Rendering @Body before PreloadAsync completes would race and silently
    // fall back to student #1 — so the body waits for _ready.
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask;
        if (!state.User.Identity?.IsAuthenticated ?? true)
        {
            var returnUrl = new Uri(Nav.Uri).PathAndQuery;
            Nav.NavigateTo($"/?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
            return;
        }
        await Auth.EnsureLinkedAsync(state.User);
        await App.PreloadAsync(state.User);

        // New Google users have no group yet — finish onboarding first
        if (!Auth.IsTeacher(state.User) && string.IsNullOrEmpty(App.Student.Group))
        {
            Nav.NavigateTo("/onboarding", replace: true);
            return;
        }

        _ready = true;
    }

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#76c7ad", Surface = "#1c2622", Background = "#0f1a16",
            AppbarBackground = "#0f1a16", DrawerBackground = "#151c19",
            TextPrimary = "#eaf3ef", TextSecondary = "#aebbb5",
        },
    };
}

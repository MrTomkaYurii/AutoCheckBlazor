@* Create / Edit lab dialog *@
<MudDialog>
    <DialogContent>
        <div class="glass dlg">
            <div class="dlg-head">
                <span class="dlg-icon"><Icon Name="labs" Size="20" /></span>
                <h3 class="dlg-title">@(IsNew ? "Нова лаба" : "Редагування лаби")</h3>
                <button @onclick="Cancel" class="dlg-close"><Icon Name="x" Size="16" /></button>
            </div>

            <div class="dlg-body">
                <div class="dlg-row2 dlg-row-num">
                    <div class="field">
                        <label>Номер *</label>
                        <input class="input" type="number" min="1" @bind="_number" placeholder="1" />
                    </div>
                    <div class="field">
                        <label>Назва *</label>
                        <input class="input" @bind="_title" placeholder="Основи C#" />
                    </div>
                </div>

                <div class="field">
                    <label>Мета (markdown)</label>
                    <textarea class="input dlg-goal-textarea" rows="3" @bind="_goal" placeholder="Навчитися…"></textarea>
                </div>

                <div class="dlg-row2 dlg-row-even">
                    <div class="field">
                        <label>Гілка git</label>
                        <input class="input mono" @bind="_branch" placeholder="feature/classes" />
                    </div>
                    <div class="field">
                        <label>Дедлайн здачі</label>
                        <input class="input dlg-deadline-input" type="datetime-local"
                               value="@_deadlineStr"
                               @oninput="@(e => _deadlineStr = e.Value?.ToString() ?? "")" />
                    </div>
                </div>

                <label class="dlg-checkbox-label">
                    <input type="checkbox" @bind="_mergesMain" class="dlg-checkbox" />
                    Гілка зливається в main після захисту
                </label>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="dlg-error">@_error</div>
                }
            </div>

            <div class="dlg-actions">
                <button class="btn btn-ghost" @onclick="Cancel">Скасувати</button>
                <button class="btn btn-primary" @onclick="Save" disabled="@_saving">
                    <Icon Name="check" Size="17" />@(_saving ? "Збереження…" : (IsNew ? "Додати" : "Зберегти"))
                </button>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@inject ILabManagementService LabSvc

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public LabDef? Existing { get; set; }

    private bool IsNew => Existing is null;
    private int _number;
    private string _title = "", _goal = "", _branch = "";
    private string _deadlineStr = "";   // bound to <input type="datetime-local">
    private bool _mergesMain, _saving;
    private string _error = "";

    private DateTime? DeadlineParsed =>
        string.IsNullOrWhiteSpace(_deadlineStr)
            ? null
            : DateTime.TryParse(_deadlineStr, out var d) ? d.ToUniversalTime() : (DateTime?)null;

    protected override void OnInitialized()
    {
        if (Existing is null) return;
        _number = Existing.Number;
        _title  = Existing.Title;
        _goal   = Existing.Goal ?? "";
        _branch = Existing.BranchName ?? "";
        _mergesMain = Existing.MergesMain;
        _deadlineStr = Existing.Deadline.HasValue
            ? Existing.Deadline.Value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")
            : "";
    }

    private async Task Save()
    {
        _error = "";
        if (_number <= 0)                        { _error = "Введіть номер лаби (>0)"; return; }
        if (string.IsNullOrWhiteSpace(_title))   { _error = "Назва обов'язкова"; return; }

        _saving = true; StateHasChanged();
        var dto = new CreateLabDto(_number, _title.Trim(), _goal.Trim(), _branch.Trim(), _mergesMain, DeadlineParsed);
        try
        {
            if (IsNew) await LabSvc.CreateAsync(dto);
            else        await LabSvc.UpdateAsync(Existing!.Id, dto);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { _error = ex.Message; _saving = false; }
    }

    private void Cancel() => MudDialog.Close(DialogResult.Cancel());
}

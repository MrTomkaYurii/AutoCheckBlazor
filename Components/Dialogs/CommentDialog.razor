@* View comments + add comment for a submission *@
<MudDialog>
    <DialogContent>
        <div class="glass dlg">
            <div class="dlg-head">
                <span class="dlg-icon"><Icon Name="spark" Size="18" /></span>
                <div>
                    <h3 class="dlg-title">Коментарі</h3>
                    <p class="dlg-subtitle">@LabTitle · @StudentName</p>
                </div>
                <button @onclick="Close" class="dlg-close"><Icon Name="x" Size="15" /></button>
            </div>

            @* Comment list *@
            <div class="comment-list">
                @if (_comments.Count == 0)
                {
                    <div class="comment-empty">Коментарів поки немає</div>
                }
                else
                {
                    @foreach (var c in _comments)
                    {
                        var isTeacher = c.AuthorRole == "teacher";
                        <div style="padding:12px 14px;border-radius:10px;background:@(isTeacher ? "rgba(118,199,173,0.08)" : "rgba(255,255,255,0.03)");border:1px solid @(isTeacher ? "rgba(118,199,173,0.2)" : "var(--line)")">
                            <div class="comment-row-head">
                                <span style="font-size:12px;font-weight:700;color:@(isTeacher ? "var(--acc-bright)" : "var(--tx-2)")">@c.AuthorName</span>
                                <span class="badge @(isTeacher ? "badge-green" : "badge-grey") comment-role-badge">@(isTeacher ? "Викладач" : "Студент")</span>
                                <span class="comment-time">@c.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</span>
                                @if (CanDelete)
                                {
                                    <button @onclick="@(async () => await DeleteComment(c.Id))" class="comment-delete-btn">
                                        <Icon Name="x" Size="12" />
                                    </button>
                                }
                            </div>
                            <p class="comment-text">@c.Text</p>
                        </div>
                    }
                }
            </div>

            @* Add comment *@
            <div class="add-comment">
                <textarea class="input add-comment-textarea" rows="5" @bind="_newText" placeholder="Напишіть коментар…"></textarea>
                <div class="add-comment-actions">
                    <button class="btn btn-ghost" @onclick="Close">Закрити</button>
                    <button class="btn btn-primary" @onclick="AddComment" disabled="@(string.IsNullOrWhiteSpace(_newText))">
                        <Icon Name="upload" Size="15" />Надіслати
                    </button>
                </div>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@inject ICommentService CommentSvc
@inject INotificationService NotifSvc
@inject TeacherNotificationService TeacherNotif
@inject AppDbContext Db
@inject AppState App

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    [Parameter] public int SubmissionId { get; set; }
    [Parameter] public string LabTitle { get; set; } = "";
    [Parameter] public string StudentName { get; set; } = "";
    [Parameter] public bool CanDelete { get; set; }

    private List<LabComment> _comments = [];
    private string _newText = "";
    private bool _isTeacher;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask;
        _isTeacher = App.IsTeacher(state.User);
        _comments = await CommentSvc.GetForSubmissionAsync(SubmissionId);
    }

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(_newText)) return;
        var text = _newText.Trim();
        var name = _isTeacher
            ? App.Teacher.FirstName + " " + App.Teacher.LastName
            : App.Student.FirstName + " " + App.Student.LastName;
        var role = _isTeacher ? "teacher" : "student";
        await CommentSvc.AddAsync(SubmissionId, null, role, name, text);

        var preview = text.Length > 80 ? text[..80] + "…" : text;

        if (_isTeacher)
        {
            // Викладач коментує → сповіщення студенту
            var sub = await Db.Submissions.FindAsync(SubmissionId);
            if (sub is not null)
                await NotifSvc.SendAsync(
                    sub.StudentId,
                    $"Коментар до {LabTitle}",
                    $"{App.Teacher.FirstName} {App.Teacher.LastName}: {preview}",
                    "comment");
        }
        else
        {
            // Студент коментує → сповіщення викладачу
            TeacherNotif.Add(
                $"{StudentName} · {LabTitle}",
                preview,
                "comment");
        }

        _newText  = "";
        _comments = await CommentSvc.GetForSubmissionAsync(SubmissionId);
    }

    private async Task DeleteComment(int id)
    {
        await CommentSvc.DeleteAsync(id);
        _comments = await CommentSvc.GetForSubmissionAsync(SubmissionId);
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}

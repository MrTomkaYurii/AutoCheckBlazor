@* View comments + add comment for a submission *@
<MudDialog>
    <DialogContent>
        <div class="glass" style="width:540px;max-width:92vw;padding:26px;box-shadow:var(--shadow-pop)">
            <div style="display:flex;align-items:center;gap:13px;margin-bottom:20px">
                <span style="width:40px;height:40px;border-radius:11px;display:grid;place-items:center;background:var(--acc-dim);border:1px solid var(--glass-border);color:var(--acc-bright)"><Icon Name="spark" Size="18" /></span>
                <div>
                    <h3 style="margin:0;font-size:16px;font-weight:720">Коментарі</h3>
                    <p style="margin:2px 0 0;font-size:12px;color:var(--tx-3)">@LabTitle · @StudentName</p>
                </div>
                <button @onclick="Close" style="margin-left:auto;width:36px;height:36px;border-radius:10px;border:1px solid var(--line);background:transparent;color:var(--tx-2);cursor:pointer;display:grid;place-items:center"><Icon Name="x" Size="15" /></button>
            </div>

            @* Comment list *@
            <div style="max-height:280px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;margin-bottom:16px">
                @if (_comments.Count == 0)
                {
                    <div style="padding:20px;text-align:center;color:var(--tx-faint);font-size:13.5px">Коментарів поки немає</div>
                }
                else
                {
                    @foreach (var c in _comments)
                    {
                        var isTeacher = c.AuthorRole == "teacher";
                        <div style="padding:12px 14px;border-radius:10px;background:@(isTeacher ? "rgba(118,199,173,0.08)" : "rgba(255,255,255,0.03)");border:1px solid @(isTeacher ? "rgba(118,199,173,0.2)" : "var(--line)")">
                            <div style="display:flex;align-items:center;gap:8px;margin-bottom:7px">
                                <span style="font-size:12px;font-weight:700;color:@(isTeacher ? "var(--acc-bright)" : "var(--tx-2)")">@c.AuthorName</span>
                                <span class="badge @(isTeacher ? "badge-green" : "badge-grey")" style="height:18px;font-size:10px">@(isTeacher ? "Викладач" : "Студент")</span>
                                <span style="margin-left:auto;font-size:11px;color:var(--tx-faint)">@c.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</span>
                                @if (CanDelete)
                                {
                                    <button @onclick="@(async () => await DeleteComment(c.Id))"
                                            style="width:24px;height:24px;border-radius:6px;border:none;background:transparent;color:var(--tx-faint);cursor:pointer;display:grid;place-items:center">
                                        <Icon Name="x" Size="12" />
                                    </button>
                                }
                            </div>
                            <p style="margin:0;font-size:13.5px;color:var(--tx-1);line-height:1.5;white-space:pre-wrap">@c.Text</p>
                        </div>
                    }
                }
            </div>

            @* Add comment *@
            <div style="border-top:1px solid var(--line);padding-top:14px">
                <textarea class="input" rows="5" @bind="_newText" placeholder="Напишіть коментар…"
                          style="width:100%;resize:vertical;min-height:90px;font-size:13.5px;line-height:1.5;margin-bottom:10px"></textarea>
                <div style="display:flex;justify-content:flex-end;gap:10px">
                    <button class="btn btn-ghost" @onclick="Close">Закрити</button>
                    <button class="btn btn-primary" @onclick="AddComment" disabled="@(string.IsNullOrWhiteSpace(_newText))">
                        <Icon Name="upload" Size="15" />Надіслати
                    </button>
                </div>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@inject ICommentService CommentSvc
@inject AppState App

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    [Parameter] public int SubmissionId { get; set; }
    [Parameter] public string LabTitle { get; set; } = "";
    [Parameter] public string StudentName { get; set; } = "";
    [Parameter] public bool CanDelete { get; set; }

    private List<LabComment> _comments = [];
    private string _newText = "";
    private bool _isTeacher;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask;
        _isTeacher = App.IsTeacher(state.User);
        _comments = await CommentSvc.GetForSubmissionAsync(SubmissionId);
    }

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(_newText)) return;
        var name = _isTeacher ? App.Teacher.FirstName + " " + App.Teacher.LastName : App.Student.FirstName + " " + App.Student.LastName;
        var role = _isTeacher ? "teacher" : "student";
        await CommentSvc.AddAsync(SubmissionId, null, role, name, _newText.Trim());
        _newText = "";
        _comments = await CommentSvc.GetForSubmissionAsync(SubmissionId);
    }

    private async Task DeleteComment(int id)
    {
        await CommentSvc.DeleteAsync(id);
        _comments = await CommentSvc.GetForSubmissionAsync(SubmissionId);
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}

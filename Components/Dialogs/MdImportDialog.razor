@* Import labs from MD files dialog — preview → select → confirm *@
<MudDialog>
    <DialogContent>
        <div class="glass dlg">
            <div class="dlg-head">
                <span class="dlg-icon"><Icon Name="upload" Size="20" /></span>
                <div>
                    <h3 class="dlg-title">Імпорт лаб з MD файлів</h3>
                    <p class="dlg-subtitle">content/labs/ → база даних</p>
                </div>
                <button @onclick="Cancel" class="dlg-close"><Icon Name="x" Size="16" /></button>
            </div>

            @if (_loading)
            {
                <div class="loading">
                    <span class="spinner"></span>
                    <div class="loading-label">Сканування файлів…</div>
                </div>
            }
            else if (_done)
            {
                <div class="done-box">
                    <div class="done-icon"><Icon Name="check" Size="28" Stroke="2.4" /></div>
                    <h4 class="done-title">Імпорт завершено</h4>
                    <p class="done-text">Додано лаб: <b class="done-num">@_result.Labs</b>, завдань: <b class="done-num">@_result.Tasks</b></p>
                    <button class="btn btn-primary done-btn" @onclick="Close"><Icon Name="check" Size="16" />Готово</button>
                </div>
            }
            else
            {
                @* Step 1: Select which labs to import *@
                <div class="step-head">
                    <span class="step-head-label">Виберіть лаби для імпорту (або оновлення):</span>
                    <div class="step-head-actions">
                        <button class="btn btn-ghost btn-sm" @onclick="SelectAll">Всі</button>
                        <button class="btn btn-ghost btn-sm" @onclick="SelectNew">Тільки нові</button>
                    </div>
                </div>

                <div class="item-list">
                    @foreach (var item in _items)
                    {
                        var isChecked = _selected.Contains(item.Number);
                        <div class="item-row" @onclick="@(() => Toggle(item.Number))">
                            <input type="checkbox" checked="@isChecked" @onclick:stopPropagation @onchange="@(() => Toggle(item.Number))"
                                   class="item-checkbox" />
                            <span class="mono item-number">@item.Number.ToString("D2")</span>
                            <span class="item-title">@item.Title</span>
                            <span class="item-taskcount">@item.TaskCount завд.</span>
                            @if (item.AlreadyInDb)
                            {
                                <span class="badge badge-yellow item-badge"><span class="dot"></span>оновити</span>
                            }
                            else
                            {
                                <span class="badge badge-green item-badge"><span class="dot"></span>нова</span>
                            }
                        </div>
                    }
                </div>

                <div class="footer">
                    <span class="footer-count">Вибрано: <b class="footer-count-num">@_selected.Count</b> з @_items.Count</span>
                    <div class="footer-actions">
                        <button class="btn btn-ghost" @onclick="Cancel">Скасувати</button>
                        <button class="btn btn-primary" disabled="@(_selected.Count == 0 || _importing)" @onclick="Import">
                            <Icon Name="upload" Size="16" />@(_importing ? "Імпорт…" : $"Імпортувати {_selected.Count}")
                        </button>
                    </div>
                </div>
            }
        </div>
    </DialogContent>
</MudDialog>

@inject ILabManagementService LabSvc

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private bool _loading = true, _importing, _done;
    private List<MdImportPreviewItem> _items = [];
    private HashSet<int> _selected = [];
    private (int Labs, int Tasks) _result;

    protected override async Task OnInitializedAsync()
    {
        _items = await LabSvc.PreviewImportAsync();
        SelectNew();
        _loading = false;
    }

    private void SelectAll() => _selected = _items.Select(i => i.Number).ToHashSet();
    private void SelectNew() => _selected = _items.Where(i => !i.AlreadyInDb).Select(i => i.Number).ToHashSet();
    private void Toggle(int n) { if (!_selected.Remove(n)) _selected.Add(n); }

    private async Task Import()
    {
        _importing = true; StateHasChanged();
        _result = await LabSvc.ImportAsync(_selected.ToArray());
        _importing = false; _done = true;
    }

    private void Cancel() => MudDialog.Close(DialogResult.Cancel());
    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}

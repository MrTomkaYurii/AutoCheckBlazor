@* small Захист / Фінал grade box used in lab cards *@
<div class="box" style="background:@(Highlight ? "var(--acc-dim)" : "rgba(255,255,255,0.025)");border:1px solid @(Highlight ? "var(--glass-border)" : "var(--line)")">
    <div class="label">@Label</div>
    <div class="mono tnum value" style="color:@(Value is not null ? (Highlight ? "var(--acc-bright)" : "var(--tx-1)") : "var(--tx-faint)")">@(Value is not null ? Value.ToString() : "—")</div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int? Value { get; set; }
    [Parameter] public bool Highlight { get; set; }
}

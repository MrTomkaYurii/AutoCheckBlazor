@* stat card used on grades + teacher screens *@
<div class="glass lift" style="padding:18px 20px">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
        <span style="width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:@(Tone)1e;color:@Tone;border:1px solid @(Tone)33">
            <Icon Name="@Icon" Size="18" />
        </span>
        <span style="font-size:12.5px;color:var(--tx-2);font-weight:600">@Label</span>
    </div>
    <div class="mono tnum" style="font-size:28px;font-weight:780;letter-spacing:-0.03em;color:var(--tx-1);line-height:1">@Value</div>
    <div style="font-size:11.5px;color:var(--tx-3);margin-top:6px">@Sub</div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Tone { get; set; } = "var(--acc)";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Sub { get; set; } = "";
}

@* stat card used on grades + teacher screens *@
<div class="glass lift card">
    <div class="head">
        <span class="icon-wrap" style="background:@(Tone)1e;color:@Tone;border:1px solid @(Tone)33">
            <Icon Name="@Icon" Size="18" />
        </span>
        <span class="label">@Label</span>
    </div>
    <div class="mono tnum value">@Value</div>
    <div class="sub">@Sub</div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Tone { get; set; } = "var(--acc)";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Sub { get; set; } = "";
}

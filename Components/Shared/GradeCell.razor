@* gradebook cell *@
@{
    var kind = Cell.Kind;
    var clickable = kind is "review" or "rejected" or "done";
    var common = $"width:100%;height:38px;border-radius:9px;border:1px solid transparent;display:grid;place-items:center;font-family:var(--mono);font-weight:700;font-size:13.5px;transition:all .15s;font-variant-numeric:tabular-nums;opacity:{(Dim ? "0.45" : "1")}";
}
@if (kind == "locked")
{
    <div style="@common;color:var(--tx-faint);font-weight:500">—</div>
}
else if (kind == "review")
{
    <button class="gcell" @onclick="OnClick" title="На перевірці — виставити захист"
            style="@common;color:var(--st-yellow);background:var(--st-yellow-bg);border-color:rgba(231,193,75,0.25);cursor:pointer">
        <Icon Name="clock" Size="15" />
    </button>
}
else if (kind == "rejected")
{
    <button class="gcell" @onclick="OnClick" title="Відхилено"
            style="@common;color:var(--st-red);background:var(--st-red-bg);border-color:rgba(232,128,107,0.25);cursor:pointer">@Cell.Auto</button>
}
else
{
    <button class="gcell" @onclick="OnClick" title="Переглянути / змінити"
            style="@common;color:var(--tx-1);background:rgba(118,199,173,0.07);border-color:rgba(118,199,173,0.16);cursor:pointer">@Cell.Final</button>
}

@code {
    [Parameter] public Cell Cell { get; set; } = default!;
    [Parameter] public bool Dim { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}

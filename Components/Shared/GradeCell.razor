@* gradebook cell *@
@{
    var kind = Cell.Kind;
    var clickable = kind is "review" or "rejected" or "done";
    var opacity = Dim ? "0.45" : "1";
}
@if (kind == "locked")
{
    <div class="cell-base cell-locked" style="opacity:@opacity">—</div>
}
else if (kind == "review")
{
    <button class="gcell cell-base cell-review" @onclick="OnClick" title="На перевірці — виставити захист"
            style="opacity:@opacity">
        <Icon Name="clock" Size="15" />
    </button>
}
else if (kind == "rejected")
{
    <button class="gcell cell-base cell-rejected" @onclick="OnClick" title="Відхилено"
            style="opacity:@opacity">@Cell.Auto</button>
}
else
{
    <button class="gcell cell-base cell-done" @onclick="OnClick" title="Переглянути / змінити"
            style="opacity:@opacity">@Cell.Final</button>
}

@code {
    [Parameter] public Cell Cell { get; set; } = default!;
    [Parameter] public bool Dim { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}

@* dashboard mini-stat with colored dot *@
<div class="wrap">
    <span class="dot" style="background:@Color"></span>
    <b class="tnum value">@Value</b> @Label
</div>

@code {
    [Parameter] public string Tone { get; set; } = "grey";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int Value { get; set; }
    private string Color => Tone switch { "yellow" => "var(--st-yellow)", "red" => "var(--st-red)", _ => "var(--st-grey)" };
}

@inject NavigationManager Nav

@{
    var meta     = StatusMeta.Of(Lab.Status);
    var unsent   = Lab.Status == LabStatus.Locked;
    var overdue  = Lab.IsOverdue && Lab.Status != LabStatus.Done;
    var dueSoon  = Lab.IsDueSoon && Lab.Status != LabStatus.Done;
    var canSubmit = !overdue || Lab.Status == LabStatus.Done;
    var tone     = Lab.Status switch { LabStatus.Review => "yellow", LabStatus.Rejected => "red", _ => "" };
    var accent   = overdue ? "rgba(232,128,107,0.5)"
        : Lab.Status switch {
            LabStatus.Done     => "rgba(118,199,173,0.4)",
            LabStatus.Review   => "rgba(231,193,75,0.4)",
            LabStatus.Rejected => "rgba(232,128,107,0.4)",
            _                  => "var(--glass-border)" };
}

<article class="glass lift labcard" data-screen-label="Lab@(Lab.Id.ToString("D2"))"
         @onclick="@(() => Nav.NavigateTo($"/student/lab/{Lab.Id}"))"
         style="border-color:@accent;opacity:@(unsent ? "0.75" : "1");animation-delay:@(Index * 0.035)s">

    @if (!unsent)
    {
        <div class="glow" style="background:radial-gradient(circle at top right, @(meta.Tone)22, transparent 70%)"></div>
    }

    <div class="head-row">
        <div class="head-left">
            <span class="mono lab-number" style="color:@(unsent ? "var(--tx-3)" : "var(--acc-bright)");background:@(unsent ? "var(--st-grey-bg)" : "var(--acc-dim)");border:1px solid @(unsent ? "transparent" : "var(--glass-border)")">@Lab.Id.ToString("D2")</span>
            <h4 class="lab-title">@Lab.Title</h4>
        </div>
        <Badge Status="Lab.Status" />
    </div>

    @* Deadline badge *@
    @if (Lab.DeadlineAt.HasValue)
    {
        var dl     = Lab.DeadlineAt.Value.ToLocalTime();
        var dlText = dl.ToString("dd.MM.yyyy HH:mm");
        var dlColor = overdue ? "var(--st-red)" : dueSoon ? "var(--st-yellow)" : "var(--tx-3)";
        var dlBg    = overdue ? "rgba(232,128,107,0.1)" : dueSoon ? "rgba(231,193,75,0.08)" : "transparent";
        <div class="deadline-badge" style="background:@dlBg">
            <Icon Name="calendar" Size="12" Style="@($"color:{dlColor}")" />
            <span class="deadline-text" style="color:@dlColor">
                @if (overdue) { <span>Дедлайн минув · @dlText</span> }
                else if (dueSoon) { <span>Залишилось &lt; 24 год · @dlText</span> }
                else { <span>Здати до @dlText</span> }
            </span>
        </div>
    }

    <div class="auto-block">
        @if (Lab.Auto is not null)
        {
            <div class="auto-head">
                <span class="auto-label">авто-перевірка</span>
                <span class="mono tnum auto-value" style="color:@meta.Tone">@Lab.Auto<span class="auto-suffix"> /100</span></span>
            </div>
            <Progress Value="Lab.Auto.Value" Tone="@tone" />
        }
        else
        {
            <div class="unsent-row">
                <Icon Name="upload" Size="15" />Ще не здавалась
            </div>
        }
    </div>

    <div class="grades-row">
        <MiniGrade Label="Захист" Value="Lab.Defense" />
        <MiniGrade Label="Фінал" Value="Lab.Final" Highlight="true" />
    </div>

    @if (Lab.Status == LabStatus.Done)
    {
        <button class="btn btn-ghost btn-block btn-sm" @onclick:stopPropagation @onclick="@(() => Nav.NavigateTo($"/student/lab/{Lab.Id}"))"><Icon Name="check" Size="15" />Переглянути</button>
    }
    else if (overdue)
    {
        <button class="btn btn-ghost btn-block btn-sm overdue-btn" disabled><Icon Name="lock" Size="15" />Дедлайн минув</button>
    }
    else if (Lab.Status == LabStatus.Rejected)
    {
        <button class="btn btn-outline btn-block btn-sm" @onclick:stopPropagation @onclick="@(() => Nav.NavigateTo($"/student/lab/{Lab.Id}"))"><Icon Name="refresh" Size="15" />Здати повторно</button>
    }
    else if (Lab.Status == LabStatus.Review)
    {
        <button class="btn btn-ghost btn-block btn-sm" @onclick:stopPropagation @onclick="@(() => Nav.NavigateTo($"/student/lab/{Lab.Id}"))"><Icon Name="clock" Size="15" />На перевірці</button>
    }
    else
    {
        <button class="btn btn-primary btn-block btn-sm" @onclick:stopPropagation @onclick="@(() => Nav.NavigateTo($"/student/lab/{Lab.Id}"))"><Icon Name="upload" Size="15" />Здати</button>
    }
</article>

@code {
    [Parameter] public Lab Lab { get; set; } = default!;
    [Parameter] public int Index { get; set; }
}

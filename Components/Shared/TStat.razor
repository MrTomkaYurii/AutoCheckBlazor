@* teacher stat card *@
<div class="glass lift" style="padding:18px 20px;position:relative;overflow:hidden">
    <div style="position:absolute;right:-20px;top:-30px;width:120px;height:120px;border-radius:50%;background:radial-gradient(circle, @(Tone)1c, transparent 65%);pointer-events:none"></div>
    <div style="display:flex;align-items:center;gap:11px;margin-bottom:14px;position:relative">
        <span style="width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:@(Tone)1e;color:@Tone;border:1px solid @(Tone)33">
            <Icon Name="@Icon" Size="19" />
        </span>
        @if (!string.IsNullOrEmpty(Hint))
        {
            <span class="badge badge-grey" style="margin-left:auto;height:22px"><span class="dot"></span>@Hint</span>
        }
    </div>
    <div class="mono tnum" style="font-size:30px;font-weight:790;letter-spacing:-0.03em;line-height:1;color:var(--tx-1)">@Value</div>
    <div style="font-size:12.5px;color:var(--tx-3);margin-top:7px;font-weight:500">@Label</div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Tone { get; set; } = "var(--acc)";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Hint { get; set; } = "";
}

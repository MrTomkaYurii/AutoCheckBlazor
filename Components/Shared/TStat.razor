@* teacher stat card *@
<div class="glass lift card">
    <div class="glow" style="background:radial-gradient(circle, @(Tone)1c, transparent 65%)"></div>
    <div class="head">
        <span class="icon-wrap" style="background:@(Tone)1e;color:@Tone;border:1px solid @(Tone)33">
            <Icon Name="@Icon" Size="19" />
        </span>
        @if (!string.IsNullOrEmpty(Hint))
        {
            <span class="badge badge-grey hint-badge"><span class="dot"></span>@Hint</span>
        }
    </div>
    <div class="mono tnum value">@Value</div>
    <div class="label">@Label</div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Tone { get; set; } = "var(--acc)";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Hint { get; set; } = "";
}

@* Animated circular average ring *@
<div class="wrap">
    <svg width="132" height="132" viewBox="0 0 132 132">
        <circle cx="66" cy="66" r="52" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="10" />
        <circle cx="66" cy="66" r="52" fill="none" stroke="url(#ringg)" stroke-width="10" stroke-linecap="round"
                stroke-dasharray="@C" stroke-dashoffset="@Offset" class="progress-circle" />
        <defs>
            <linearGradient id="ringg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="var(--acc-bright)" />
                <stop offset="1" stop-color="var(--acc)" />
            </linearGradient>
        </defs>
    </svg>
    <div class="center">
        <div class="mono tnum value">@_shown</div>
    </div>
</div>

@code {
    [Parameter] public int Value { get; set; }
    private double _v = 0;
    private int _shown = 0;
    private bool _ready;
    private const double C = 2 * Math.PI * 52;
    private double Offset => C - (_v / 100.0) * C;

    protected override void OnParametersSet()
    {
        // reflect later Value changes (Progress does the same); the first paint
        // is animated from 0 in OnAfterRenderAsync
        if (_ready) { _v = Value; _shown = Value; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(120);
            _v = Value; _shown = Value;
            _ready = true;
            StateHasChanged();
        }
    }
}

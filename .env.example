# Copy to .env and fill in real values — .env is gitignored, never commit secrets.
# docker-compose.yml reads these automatically.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_LIMIT=50

# Optional — leave empty to disable Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — leave empty to disable email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=AutoCheck

# Optional — off-host DB backup mirror. Create a separate PRIVATE GitHub repo
# (e.g. AutoCheck-Backups) and a fine-grained PAT scoped to only that repo
# (Contents: Read and write). Leave BACKUP_GIT_REMOTE_URL empty to disable.
BACKUP_GIT_REMOTE_URL=
BACKUP_GIT_TOKEN=
BACKUP_GIT_KEEP_LAST=14
BACKUP_GIT_USER_NAME=AutoCheck Backup
BACKUP_GIT_USER_EMAIL=backup@autocheck.local
